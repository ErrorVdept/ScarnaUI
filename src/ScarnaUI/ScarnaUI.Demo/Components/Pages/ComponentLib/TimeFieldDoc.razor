@page "/componentlib/time-field"

<DocPage Title="ScarnaTimeField" Lead="Поле выбора времени на основе нативного input type=time."
         Files="@(new[] { "Components/Forms/ScarnaTimeField.razor" })">

    <DocSection Title="Интерактивный пример" Code="@InteractiveCode">
        <ScarnaTimeField Label="Время начала" @bind-Value="_startTime" />
        <span class="text-sm text-foreground/60">Значение: @_startTime</span>
    </DocSection>

    <DocSection Title="Варианты и размеры" Code="@VariantsCode">
        <ScarnaTimeField Label="Flat" Variant="Variant.Flat" Class="w-40" />
        <ScarnaTimeField Label="Small" Size="Size.Small" Class="w-40" />
        <ScarnaTimeField Label="Large" Size="Size.Large" Class="w-40" />
    </DocSection>

    <DocSection Title="Состояния" Code="@StatesCode">
        <ScarnaTimeField Label="Отключено" Disabled="true" Class="w-40" />
        <ScarnaTimeField Label="Только чтение" ReadOnly="true" Class="w-40" />
    </DocSection>

    <DocApiTable Rows="@_rows" />

</DocPage>

@code {
    private TimeOnly? _startTime = new(9, 30);

    private const string InteractiveCode =
        """
        <ScarnaTimeField Label="Время начала" @bind-Value="_startTime" />
        <span class="text-sm text-foreground/60">Значение: @_startTime</span>

        @code {
            private TimeOnly? _startTime = new(9, 30);
        }
        """;

    private const string VariantsCode =
        """
        <ScarnaTimeField Label="Flat" Variant="Variant.Flat" />
        <ScarnaTimeField Label="Small" Size="Size.Small" />
        <ScarnaTimeField Label="Large" Size="Size.Large" />
        """;

    private const string StatesCode =
        """
        <ScarnaTimeField Label="Отключено" Disabled="true" />
        <ScarnaTimeField Label="Только чтение" ReadOnly="true" />
        """;

    private readonly List<DocApiRow> _rows = new()
    {
        new("Value / ValueChanged / ValueExpression", "TimeOnly?", "—", "Механика @bind-Value"),
        new("Label", "string?", "—", "Подпись над полем"),
        new("HelperText / ErrorText / Error", "—", "—", "Подсказка/ошибка под полем"),
        new("Disabled", "bool", "false", "—"),
        new("ReadOnly", "bool", "false", "—"),
        new("Variant", "Variant", "Bordered", "Bordered/Flat"),
        new("Bordered", "bool", "true", "Показывать ли контур поля"),
        new("Size", "Size", "Medium", "Small/Medium/Large"),
        new("Density", "ScarnaDensity", "Normal", "Dense — компактное поле"),
        new("Radius", "Radius", "Medium", "Радиус поля"),
    };
}
