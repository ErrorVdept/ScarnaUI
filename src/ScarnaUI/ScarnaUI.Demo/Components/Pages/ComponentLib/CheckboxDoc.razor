@page "/componentlib/checkbox"

<DocPage Title="ScarnaCheckbox" Lead="Чекбокс с поддержкой @@bind-Value и подписью рядом."
         Files="@(new[] { "Components/Forms/ScarnaCheckbox.razor" })">

    <DocSection Title="Интерактивный пример" Code="@InteractiveCode">
        <ScarnaCheckbox @bind-Value="_agree" Color="ScarnaColor.Success">Согласен с условиями использования</ScarnaCheckbox>
        <span class="text-sm text-foreground/60">Значение: @_agree</span>
    </DocSection>

    <DocSection Title="Цвета" Code="@ColorsCode">
        <ScarnaCheckbox Value="true" Color="ScarnaColor.Default">Default</ScarnaCheckbox>
        <ScarnaCheckbox Value="true" Color="ScarnaColor.Primary">Primary</ScarnaCheckbox>
        <ScarnaCheckbox Value="true" Color="ScarnaColor.Secondary">Secondary</ScarnaCheckbox>
        <ScarnaCheckbox Value="true" Color="ScarnaColor.Success">Success</ScarnaCheckbox>
        <ScarnaCheckbox Value="true" Color="ScarnaColor.Warning">Warning</ScarnaCheckbox>
        <ScarnaCheckbox Value="true" Color="ScarnaColor.Danger">Danger</ScarnaCheckbox>
    </DocSection>

    <DocSection Title="Плотность и состояния" Code="@StatesCode">
        <ScarnaCheckbox Density="ScarnaDensity.Dense" Value="true">Dense чекбокс</ScarnaCheckbox>
        <ScarnaCheckbox Value="true" ReadOnly="true">ReadOnly чекбокс</ScarnaCheckbox>
        <ScarnaCheckbox Value="true" Disabled="true">Disabled чекбокс</ScarnaCheckbox>
    </DocSection>

    <DocApiTable Rows="@_rows" />

</DocPage>

@code {
    private bool _agree;

    private const string InteractiveCode =
        """
        <ScarnaCheckbox @bind-Value="_agree" Color="ScarnaColor.Success">Согласен с условиями использования</ScarnaCheckbox>
        <span class="text-sm text-foreground/60">Значение: @_agree</span>

        @code {
            private bool _agree;
        }
        """;

    private const string ColorsCode =
        """
        <ScarnaCheckbox Value="true" Color="ScarnaColor.Default">Default</ScarnaCheckbox>
        <ScarnaCheckbox Value="true" Color="ScarnaColor.Primary">Primary</ScarnaCheckbox>
        <ScarnaCheckbox Value="true" Color="ScarnaColor.Secondary">Secondary</ScarnaCheckbox>
        <ScarnaCheckbox Value="true" Color="ScarnaColor.Success">Success</ScarnaCheckbox>
        <ScarnaCheckbox Value="true" Color="ScarnaColor.Warning">Warning</ScarnaCheckbox>
        <ScarnaCheckbox Value="true" Color="ScarnaColor.Danger">Danger</ScarnaCheckbox>
        """;

    private const string StatesCode =
        """
        <ScarnaCheckbox Density="ScarnaDensity.Dense" Value="true">Dense чекбокс</ScarnaCheckbox>
        <ScarnaCheckbox Value="true" ReadOnly="true">ReadOnly чекбокс</ScarnaCheckbox>
        <ScarnaCheckbox Value="true" Disabled="true">Disabled чекбокс</ScarnaCheckbox>
        """;

    private readonly List<DocApiRow> _rows = new()
    {
        new("Value / ValueChanged / ValueExpression", "bool", "—", "Механика @bind-Value"),
        new("Disabled", "bool", "false", "—"),
        new("ReadOnly", "bool", "false", "Запрещает переключение, но не тускнеет (в отличие от Disabled)"),
        new("Color", "ScarnaColor", "Primary", "Цвет заливки в отмеченном состоянии"),
        new("Density", "ScarnaDensity", "Normal", "Dense — уменьшенный квадрат для плотных списков"),
        new("ChildContent", "RenderFragment?", "—", "Подпись рядом с чекбоксом"),
    };
}
