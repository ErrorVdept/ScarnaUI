@page "/componentlib/nav-menu"

<DocPage Title="ScarnaNavMenu / ScarnaNavLink" Lead="Вертикальное меню навигации — как в MudNavMenu. Активный пункт ScarnaNavLink определяет сам, сверяясь с текущим URL через INavigator, и подсвечивается фоном/цветом (без ручного bool 'выбран ли пункт')."
         Files="@(new[] { "Components/Layout/ScarnaNavMenu.razor", "Components/Layout/ScarnaNavLink.razor" })">

    <DocSection Title="Пример" Description="Ссылки ведут на реальные страницы документации (чтобы демо работало по-настоящему) — кликните, активный пункт подсвечивается автоматически, без своего кода." Code="@ExampleCode">
        <ScarnaNavMenu Class="w-56">
            <ScarnaNavLink Href="/componentlib/nav-menu">
                <StartContent>@HomeIcon</StartContent>
                <ChildContent>Эта страница</ChildContent>
            </ScarnaNavLink>
            <ScarnaNavLink Href="/componentlib/button">
                <StartContent>@OrdersIcon</StartContent>
                <ChildContent>ScarnaButton</ChildContent>
                <EndContent><ScarnaTag Color="Color.Primary">new</ScarnaTag></EndContent>
            </ScarnaNavLink>
            <ScarnaNavLink Href="/componentlib/card">
                <StartContent>@SettingsIcon</StartContent>
                <ChildContent>ScarnaCard</ChildContent>
            </ScarnaNavLink>
            <ScarnaNavLink Href="/componentlib/table" Disabled="true">
                <StartContent>@ArchiveIcon</StartContent>
                <ChildContent>ScarnaTable (Disabled)</ChildContent>
            </ScarnaNavLink>
        </ScarnaNavMenu>
    </DocSection>

    <DocSection Title="Exact" Description="По умолчанию (Exact=false) пункт активен и для дочерних путей — Href='/orders' активен и на '/orders/5'. Exact='true' требует точного совпадения." Code="@ExactCode" Row="false">
        <p class="text-sm text-foreground/60">Например, в шапке демо-сайта пункт «Обзор» использует Match/Exact, чтобы не подсвечиваться на всех вложенных страницах — см. NavLink.Match в MainLayout.razor.</p>
    </DocSection>

    <DocApiTable Title="Параметры ScarnaNavMenu" Rows="@_menuRows" />
    <DocApiTable Title="Параметры ScarnaNavLink" Rows="@_linkRows" />

</DocPage>

@code {
    private const string ExampleCode =
        """
        <ScarnaNavMenu>
            <ScarnaNavLink Href="/orders">
                <StartContent><OrdersIcon /></StartContent>
                <ChildContent>Заказы</ChildContent>
                <EndContent><ScarnaTag Color="Color.Primary">7</ScarnaTag></EndContent>
            </ScarnaNavLink>
            <ScarnaNavLink Href="/settings">
                <StartContent><SettingsIcon /></StartContent>
                <ChildContent>Настройки</ChildContent>
            </ScarnaNavLink>
            <ScarnaNavLink Href="/archive" Disabled="true">Архив</ScarnaNavLink>
        </ScarnaNavMenu>
        """;

    private const string ExactCode =
        """
        <ScarnaNavLink Href="/orders">Заказы</ScarnaNavLink>
        @* активен и на /orders, и на /orders/5 *@

        <ScarnaNavLink Href="/orders" Exact="true">Заказы</ScarnaNavLink>
        @* активен только на точном /orders *@
        """;

    private RenderFragment HomeIcon =>
        @<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" /><polyline points="9 22 9 12 15 12 15 22" /></svg>;

    private RenderFragment OrdersIcon =>
        @<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z" /><line x1="3" y1="6" x2="21" y2="6" /><path d="M16 10a4 4 0 0 1-8 0" /></svg>;

    private RenderFragment SettingsIcon =>
        @<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0"><circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" /></svg>;

    private RenderFragment ArchiveIcon =>
        @<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0"><polyline points="21 8 21 21 3 21 3 8" /><rect x="1" y="3" width="22" height="5" /><line x1="10" y1="12" x2="14" y2="12" /></svg>;

    private readonly List<DocApiRow> _menuRows = new()
    {
        new("ChildContent", "RenderFragment?", "—", "Набор ScarnaNavLink"),
        new("Class", "string?", "—", "см. getting-started.md"),
    };

    private readonly List<DocApiRow> _linkRows = new()
    {
        new("Href", "string", "—", "Обязательный. Адрес перехода"),
        new("Exact", "bool", "false", "Требовать точного совпадения адреса. false — активен и для дочерних путей"),
        new("Target", "string?", "—", "target для ссылки"),
        new("Disabled", "bool", "false", "Блокирует переход и клики, гасит непрозрачность"),
        new("StartContent", "RenderFragment?", "—", "Иконка перед текстом"),
        new("EndContent", "RenderFragment?", "—", "Содержимое после текста — например, счётчик/бейдж"),
        new("ChildContent", "RenderFragment?", "—", "Текст пункта"),
        new("OnClick", "EventCallback", "—", "Доп. обработчик клика в дополнение к переходу (не вызывается, если Disabled) — удобно, чтобы закрыть Drawer на мобильном"),
    };
}
