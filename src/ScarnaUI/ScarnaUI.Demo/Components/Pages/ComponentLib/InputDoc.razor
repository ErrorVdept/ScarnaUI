@page "/componentlib/input"

<DocPage Title="ScarnaInput" Lead="Однострочное текстовое поле с поддержкой @@bind-Value и подсветкой ошибок валидации."
         Files="@(new[] { "Components/Forms/ScarnaInput.razor" })">

    <DocSection Title="Интерактивный пример" Description="Значение обновляется по мере ввода." Code="@InteractiveCode" Row="false">
        <ScarnaInput Label="Имя" Placeholder="Введите имя" @bind-Value="_name" HelperText="Как к вам обращаться" />
        <span class="text-sm text-foreground/60">Значение: @_name</span>
    </DocSection>

    <DocSection Title="Варианты и размеры" Code="@VariantsCode">
        <ScarnaInput Placeholder="Bordered (по умолчанию)" Class="w-48" />
        <ScarnaInput Placeholder="Flat" Variant="Variant.Flat" Class="w-48" />
        <ScarnaInput Placeholder="Small" Size="Size.Small" Class="w-40" />
        <ScarnaInput Placeholder="Large" Size="Size.Large" Class="w-40" />
        <ScarnaInput Placeholder="Dense" Density="ScarnaDensity.Dense" Class="w-40" />
    </DocSection>

    <DocSection Title="Состояния" Code="@StatesCode">
        <ScarnaInput Value="Только чтение" ReadOnly="true" Class="w-48" />
        <ScarnaInput Placeholder="Отключено" Disabled="true" Class="w-48" />
        <ScarnaInput Label="Купон" Value="ABC" Error="true" ErrorText="Купон не найден" Class="w-48" />
    </DocSection>

    <DocApiTable Rows="@_rows" />

</DocPage>

@code {
    private string? _name;

    private const string InteractiveCode =
        """
        <ScarnaInput Label="Имя" Placeholder="Введите имя" @bind-Value="_name" HelperText="Как к вам обращаться" />
        <span class="text-sm text-foreground/60">Значение: @_name</span>

        @code {
            private string? _name;
        }
        """;

    private const string VariantsCode =
        """
        <ScarnaInput Placeholder="Bordered (по умолчанию)" />
        <ScarnaInput Placeholder="Flat" Variant="Variant.Flat" />
        <ScarnaInput Placeholder="Small" Size="Size.Small" />
        <ScarnaInput Placeholder="Large" Size="Size.Large" />
        <ScarnaInput Placeholder="Dense" Density="ScarnaDensity.Dense" />
        """;

    private const string StatesCode =
        """
        <ScarnaInput Value="Только чтение" ReadOnly="true" />
        <ScarnaInput Placeholder="Отключено" Disabled="true" />
        <ScarnaInput Label="Купон" Value="ABC" Error="true" ErrorText="Купон не найден" />
        """;

    private readonly List<DocApiRow> _rows = new()
    {
        new("Value / ValueChanged / ValueExpression", "string?", "—", "Механика @bind-Value"),
        new("Label", "string?", "—", "Подпись над полем"),
        new("Placeholder", "string?", "—", "Плейсхолдер"),
        new("HelperText", "string?", "—", "Подсказка под полем (скрывается при ошибке)"),
        new("ErrorText", "string?", "—", "Текст ошибки под полем"),
        new("Error", "bool", "false", "Принудительно пометить поле невалидным"),
        new("Type", "string", "\"text\"", "HTML type (text/email/password/number...)"),
        new("Disabled", "bool", "false", "—"),
        new("ReadOnly", "bool", "false", "—"),
        new("Variant", "Variant", "Bordered", "Bordered — контур на прозрачном фоне, Flat — заливка без контура"),
        new("Bordered", "bool", "true", "Показывать ли контур поля, независимо от Variant"),
        new("Size", "Size", "Medium", "Small/Medium/Large"),
        new("Density", "ScarnaDensity", "Normal", "Normal — обычная высота, Dense — уменьшенная для плотных панелей"),
        new("Radius", "Radius", "Medium", "Радиус поля"),
        new("StartContent", "RenderFragment?", "—", "Иконка/префикс перед полем"),
        new("EndContent", "RenderFragment?", "—", "Иконка/кнопка после поля"),
    };
}
