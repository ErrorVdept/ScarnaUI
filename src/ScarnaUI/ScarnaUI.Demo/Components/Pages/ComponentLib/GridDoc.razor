@page "/componentlib/grid"

<DocPage Title="ScarnaGrid / ScarnaItem" Lead="Классическая 12-колоночная сетка на CSS Grid — ScarnaGrid — контейнер, ScarnaItem — ячейка, задающая ширину на каждой ширине экрана."
         Files="@(new[] { "Components/Layout/ScarnaGrid.razor", "Components/Layout/ScarnaItem.razor" })">

    <DocSection Title="Базовая сетка" Description="Xs — ширина по умолчанию, Md — от 768px." Code="@BasicCode" Row="false">
        <ScarnaGrid Spacing="4">
            <ScarnaItem Xs="12" Md="6">
                <ScarnaCard>
                    <p class="text-sm text-foreground/70">Xs=12 Md=6</p>
                </ScarnaCard>
            </ScarnaItem>
            <ScarnaItem Xs="12" Md="6">
                <ScarnaCard>
                    <p class="text-sm text-foreground/70">Xs=12 Md=6</p>
                </ScarnaCard>
            </ScarnaItem>
        </ScarnaGrid>
    </DocSection>

    <DocSection Title="Три колонки" Description="Sm/Md/Lg добавляют промежуточные брейкпоинты." Code="@ThreeColsCode" Row="false">
        <ScarnaGrid Spacing="4">
            <ScarnaItem Xs="12" Sm="6" Lg="4">
                <ScarnaCard><p class="text-sm text-foreground/70">1</p></ScarnaCard>
            </ScarnaItem>
            <ScarnaItem Xs="12" Sm="6" Lg="4">
                <ScarnaCard><p class="text-sm text-foreground/70">2</p></ScarnaCard>
            </ScarnaItem>
            <ScarnaItem Xs="12" Sm="6" Lg="4">
                <ScarnaCard><p class="text-sm text-foreground/70">3</p></ScarnaCard>
            </ScarnaItem>
        </ScarnaGrid>
    </DocSection>

    <DocApiTable Title="Параметры ScarnaGrid" Rows="@_gridRows" />
    <DocApiTable Title="Параметры ScarnaItem" Rows="@_itemRows" />

</DocPage>

@code {
    private const string BasicCode =
        """
        <ScarnaGrid Spacing="4">
            <ScarnaItem Xs="12" Md="6"><ScarnaCard>Левая колонка</ScarnaCard></ScarnaItem>
            <ScarnaItem Xs="12" Md="6"><ScarnaCard>Правая колонка</ScarnaCard></ScarnaItem>
        </ScarnaGrid>
        """;

    private const string ThreeColsCode =
        """
        <ScarnaGrid Spacing="4">
            <ScarnaItem Xs="12" Sm="6" Lg="4"><ScarnaCard>1</ScarnaCard></ScarnaItem>
            <ScarnaItem Xs="12" Sm="6" Lg="4"><ScarnaCard>2</ScarnaCard></ScarnaItem>
            <ScarnaItem Xs="12" Sm="6" Lg="4"><ScarnaCard>3</ScarnaCard></ScarnaItem>
        </ScarnaGrid>
        """;

    private readonly List<DocApiRow> _gridRows = new()
    {
        new("Spacing", "int", "4", "Отступ между ячейками в шагах по 0.25rem"),
        new("Justify", "Justify", "Start", "justify-content сетки (заметно, только если ячейки не заполняют всю ширину)"),
        new("Align", "Align", "Stretch", "align-items — вертикальное выравнивание содержимого ячеек"),
    };

    private readonly List<DocApiRow> _itemRows = new()
    {
        new("Xs", "int (1-12)", "12", "Ширина по умолчанию (мобильные и выше)"),
        new("Sm", "int?", "—", "Ширина от 640px"),
        new("Md", "int?", "—", "Ширина от 768px"),
        new("Lg", "int?", "—", "Ширина от 1024px"),
    };
}
