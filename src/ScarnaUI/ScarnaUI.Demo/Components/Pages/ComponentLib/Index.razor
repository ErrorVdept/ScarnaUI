@page "/componentlib"

@* Боковое меню (ScarnaDrawer) и контейнер даёт вложенный ComponentLibLayout — см. ComponentLib/_Imports.razor. *@
<ScarnaStack Spacing="8">
    <div>
        <h1 class="text-2xl font-semibold">Библиотека компонентов</h1>
        <p class="mt-2 max-w-2xl text-sm text-foreground/70">
            Интерактивная документация ScarnaUI — как на mudblazor.com: живой пример на
            каждый компонент, кнопка "Показать код" и таблица параметров.
        </p>
    </div>

    @foreach (var group in ComponentLibNav.Groups)
    {
        <section>
            <h2 class="mb-3 text-lg font-semibold text-foreground/90">@group.Title</h2>
            <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 xl:grid-cols-4">
                @foreach (var item in group.Items)
                {
                    <NavLink href="@item.Href" class="scarna-lib-card block rounded-scarna-md border border-divider bg-content1 p-4 transition-colors hover:border-primary hover:bg-content2">
                        <span class="block font-medium text-foreground">@item.Name</span>
                        <span class="mt-1 block text-xs text-foreground/50">@item.Description</span>
                    </NavLink>
                }
            </div>
        </section>
    }
</ScarnaStack>
