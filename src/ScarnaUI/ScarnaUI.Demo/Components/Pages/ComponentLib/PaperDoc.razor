@page "/componentlib/paper"

<DocPage Title="ScarnaPaper" Lead="Простая поверхность — фон content1, скругление, опциональные рамка/тень. Почти как ScarnaCard, но без Header/Footer."
         Files="@(new[] { "Components/DataDisplay/ScarnaPaper.razor" })">

    <DocSection Title="Базовая поверхность" Code="@BasicCode">
        <ScarnaPaper>Обычная поверхность</ScarnaPaper>
        <ScarnaPaper Bordered="true" Shadow="false">Bordered, без тени</ScarnaPaper>
        <ScarnaPaper Radius="ScarnaRadius.None">Radius.None</ScarnaPaper>
    </DocSection>

    <DocSection Title="Hovered" Description="Смена фона (bg-content2) при наведении — без смещения/тени, чтобы не «прыгало» в плотных сетках плиток." Code="@HoveredCode">
        <ScarnaPaper Hovered="true" Class="w-40 text-center">Наведи курсор</ScarnaPaper>
    </DocSection>

    <DocSection Title="OnClick" Description='Если задан — поверхность кликабельна (role="button", доступна с клавиатуры: Enter/Space). Не задан — обычный статичный div, как у ScarnaCard.' Code="@ClickCode">
        <ScarnaPaper Hovered="true" Class="w-48 text-center" OnClick="HandleClick">
            Кликни меня
        </ScarnaPaper>
        <span class="text-sm text-foreground/60">Кликов: @_clicks</span>
    </DocSection>

    <DocApiTable Rows="@_rows" />

</DocPage>

@code {
    private int _clicks;

    private void HandleClick() => _clicks++;

    private const string BasicCode =
        """
        <ScarnaPaper>Обычная поверхность</ScarnaPaper>
        <ScarnaPaper Bordered="true" Shadow="false">Bordered, без тени</ScarnaPaper>
        <ScarnaPaper Radius="ScarnaRadius.None">Radius.None</ScarnaPaper>
        """;

    private const string HoveredCode =
        """
        <ScarnaPaper Hovered="true" Class="w-40 text-center">Наведи курсор</ScarnaPaper>
        """;

    private const string ClickCode =
        """
        <ScarnaPaper Hovered="true" Class="w-48 text-center" OnClick="HandleClick">
            Кликни меня
        </ScarnaPaper>

        @code {
            private int _clicks;
            private void HandleClick() => _clicks++;
        }
        """;

    private readonly List<DocApiRow> _rows = new()
    {
        new("Bordered", "bool", "false", "Тонкая рамка в дополнение к тени"),
        new("Shadow", "bool", "true", "Тень под поверхностью"),
        new("Hovered", "bool", "false", "Смена фона (bg-content2) при наведении"),
        new("Radius", "ScarnaRadius", "Medium", "Радиус скругления"),
        new("OnClick", "EventCallback<MouseEventArgs>", "—", "Если задан — поверхность кликабельна (role=\"button\", Enter/Space). Не задан — обычный статичный контейнер"),
        new("ChildContent", "RenderFragment?", "—", "Содержимое"),
    };
}
