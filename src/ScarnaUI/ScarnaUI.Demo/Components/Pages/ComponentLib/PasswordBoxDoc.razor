@page "/componentlib/password-box"

<DocPage Title="ScarnaPasswordBox" Lead="Поле пароля с переключаемым отображением (кнопка-глазок) и настраиваемым символом маски."
         Files="@(new[] { "Components/Forms/ScarnaPasswordBox.razor" })">

    <DocSection Title="Интерактивный пример" Code="@InteractiveCode" Row="false">
        <ScarnaPasswordBox Label="Пароль" @bind-Value="_password" Placeholder="Введите пароль" HelperText="Символ маски по умолчанию — *" />
        <span class="text-sm text-foreground/60">Значение: @_password</span>
    </DocSection>

    <DocSection Title="MaskChar и без переключателя" Code="@MaskCode">
        <ScarnaPasswordBox Label="PIN-код" MaskChar="'•'" Placeholder="1234" Class="w-48" />
        <ScarnaPasswordBox Label="Без глазка" ShowToggle="false" Placeholder="secret" Class="w-48" />
    </DocSection>

    <DocSection Title="Состояния" Code="@StatesCode">
        <ScarnaPasswordBox Label="Отключено" Disabled="true" Value="secret" Class="w-48" />
        <ScarnaPasswordBox Label="Только чтение" ReadOnly="true" Value="secret" Class="w-48" />
    </DocSection>

    <DocApiTable Rows="@_rows" />

</DocPage>

@code {
    private string? _password;

    private const string InteractiveCode =
        """
        <ScarnaPasswordBox Label="Пароль" @bind-Value="_password" Placeholder="Введите пароль" HelperText="Символ маски по умолчанию — *" />
        <span class="text-sm text-foreground/60">Значение: @_password</span>

        @code {
            private string? _password;
        }
        """;

    private const string MaskCode =
        """
        <ScarnaPasswordBox Label="PIN-код" MaskChar="'•'" Placeholder="1234" />
        <ScarnaPasswordBox Label="Без глазка" ShowToggle="false" Placeholder="secret" />
        """;

    private const string StatesCode =
        """
        <ScarnaPasswordBox Label="Отключено" Disabled="true" Value="secret" />
        <ScarnaPasswordBox Label="Только чтение" ReadOnly="true" Value="secret" />
        """;

    private readonly List<DocApiRow> _rows = new()
    {
        new("Value / ValueChanged / ValueExpression", "string", "—", "Механика @bind-Value"),
        new("Label", "string?", "—", "Подпись над полем"),
        new("Placeholder", "string?", "—", "—"),
        new("HelperText / ErrorText / Error", "—", "—", "Подсказка/ошибка под полем"),
        new("MaskChar", "char", "'*'", "Символ маски, пока пароль скрыт"),
        new("ShowToggle", "bool", "true", "Показывать ли кнопку-глазок переключения видимости"),
        new("Disabled", "bool", "false", "—"),
        new("ReadOnly", "bool", "false", "—"),
        new("Variant", "ScarnaVariant", "Bordered", "Bordered/Flat"),
        new("Bordered", "bool", "true", "Показывать ли контур поля"),
        new("Size", "ScarnaSize", "Medium", "Small/Medium/Large"),
        new("Density", "ScarnaDensity", "Normal", "Dense — компактное поле"),
        new("Radius", "ScarnaRadius", "Medium", "Радиус поля"),
    };
}
