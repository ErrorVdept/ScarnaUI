@page "/componentlib/tooltip"

<DocPage Title="ScarnaTooltip" Lead="Всплывающая подсказка по наведению курсора/фокусу клавиатурой, построенная поверх ScarnaPopover."
         Files="@(new[] { "Components/Overlays/ScarnaTooltip.razor" })">

    <DocSection Title="Пример" Code="@ExampleCode">
        <ScarnaTooltip Text="Сохранить изменения">
            <ScarnaButton>💾</ScarnaButton>
        </ScarnaTooltip>
        <ScarnaTooltip Text="Всплывающая подсказка снизу" Position="ScarnaPosition.Bottom">
            <ScarnaButton Variant="Variant.Bordered">Наведите курсор</ScarnaButton>
        </ScarnaTooltip>
    </DocSection>

    <DocApiTable Rows="@_rows" />

</DocPage>

@code {
    private const string ExampleCode =
        """
        <ScarnaTooltip Text="Сохранить изменения">
            <ScarnaButton>💾</ScarnaButton>
        </ScarnaTooltip>

        <ScarnaTooltip Text="Всплывающая подсказка снизу" Position="ScarnaPosition.Bottom">
            <ScarnaButton Variant="Variant.Bordered">Наведите курсор</ScarnaButton>
        </ScarnaTooltip>
        """;

    private readonly List<DocApiRow> _rows = new()
    {
        new("Text", "string", "—", "Обязательный. Текст подсказки"),
        new("Position", "ScarnaPosition", "Top", "Позиция подсказки относительно якоря"),
        new("ChildContent", "RenderFragment?", "—", "Элемент-триггер (то, над чем наводят курсор)"),
    };
}
