@page "/componentlib/tag"

<DocPage Title="ScarnaTag" Lead="Маленькая компактная метка — облегчённый ScarnaChip: меньше паддингов, один размер, без крестика."
         Files="@(new[] { "Components/DataDisplay/ScarnaTag.razor" })">

    <DocSection Title="Цвета" Code="@ColorsCode">
        <ScarnaTag>новое</ScarnaTag>
        <ScarnaTag Color="Color.Primary">primary</ScarnaTag>
        <ScarnaTag Color="Color.Secondary">secondary</ScarnaTag>
        <ScarnaTag Color="Color.Success">активен</ScarnaTag>
        <ScarnaTag Color="Color.Warning">warning</ScarnaTag>
        <ScarnaTag Color="Color.Danger">danger</ScarnaTag>
    </DocSection>

    <DocSection Title="Варианты" Code="@VariantsCode">
        <ScarnaTag Color="Color.Primary" Variant="Variant.Solid">Solid</ScarnaTag>
        <ScarnaTag Color="Color.Primary" Variant="Variant.Flat">Flat</ScarnaTag>
        <ScarnaTag Color="Color.Primary" Variant="Variant.Bordered">Bordered</ScarnaTag>
        <ScarnaTag Color="Color.Primary" Variant="Variant.Faded">Faded</ScarnaTag>
    </DocSection>

    <DocApiTable Rows="@_rows" />

</DocPage>

@code {
    private const string ColorsCode =
        """
        <ScarnaTag>новое</ScarnaTag>
        <ScarnaTag Color="Color.Primary">primary</ScarnaTag>
        <ScarnaTag Color="Color.Secondary">secondary</ScarnaTag>
        <ScarnaTag Color="Color.Success">активен</ScarnaTag>
        <ScarnaTag Color="Color.Warning">warning</ScarnaTag>
        <ScarnaTag Color="Color.Danger">danger</ScarnaTag>
        """;

    private const string VariantsCode =
        """
        <ScarnaTag Color="Color.Primary" Variant="Variant.Solid">Solid</ScarnaTag>
        <ScarnaTag Color="Color.Primary" Variant="Variant.Flat">Flat</ScarnaTag>
        <ScarnaTag Color="Color.Primary" Variant="Variant.Bordered">Bordered</ScarnaTag>
        <ScarnaTag Color="Color.Primary" Variant="Variant.Faded">Faded</ScarnaTag>
        """;

    private readonly List<DocApiRow> _rows = new()
    {
        new("Color", "Color", "Default", "Цвет заливки"),
        new("Variant", "Variant", "Flat", "Вариант заливки"),
        new("ChildContent", "RenderFragment?", "—", "Текст метки"),
    };
}
