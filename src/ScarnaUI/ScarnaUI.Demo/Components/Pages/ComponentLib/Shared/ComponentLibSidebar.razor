@*
    Левое меню документации — список всех компонентов/сервисов по категориям
    (данные из ComponentLibNav, единые с карточками на Index.razor). Активная
    страница подсвечивается через ScarnaNavLink (Exact="true", т.к. маршруты не
    вложены друг в друга). Прилипает при скролле и скроллится независимо от
    страницы, если сам не помещается по высоте.
*@
@namespace ScarnaUI.Demo.Components.Pages.ComponentLib.Shared

<aside class="scarna-lib-sidebar hidden w-56 shrink-0 lg:block">
    <nav class="sticky top-20 max-h-[calc(100vh-6rem)] overflow-y-auto pb-8 pr-2">
        <NavLink href="/componentlib" Match="NavLinkMatch.All" class="mb-4 block text-sm font-semibold text-foreground hover:text-primary">
            ← Все компоненты
        </NavLink>
        @foreach (var group in ComponentLibNav.Groups)
        {
            <div class="mb-4">
                <p class="mb-1.5 px-2 text-xs font-semibold uppercase tracking-wide text-foreground/40">@group.Title</p>
                <ScarnaNavMenu Class="gap-0.5!">
                    @foreach (var item in group.Items)
                    {
                        <ScarnaNavLink Href="@item.Href" Exact="true">@item.Name</ScarnaNavLink>
                    }
                </ScarnaNavMenu>
            </div>
        }
    </nav>
</aside>
