@*
    Таблица параметров компонента — рендерит список DocApiRow поверх ScarnaTable
    (переносит "Параметры" таблицу из docmd/*.md в интерактивную документацию).
*@
@namespace ScarnaUI.Demo.Components.Pages.ComponentLib.Shared

<section>
    @if (!string.IsNullOrEmpty(Title))
    {
        <h2 class="mb-3 text-lg font-semibold">@Title</h2>
    }
    <ScarnaCard>
        <ScarnaTable Hover="true">
            <thead>
                <tr><th>Параметр</th><th>Тип</th><th>По умолчанию</th><th>Назначение</th></tr>
            </thead>
            <tbody>
                @foreach (var row in Rows)
                {
                    <tr>
                        <td><code class="text-xs font-semibold">@row.Name</code></td>
                        <td><code class="text-xs text-foreground/70">@row.Type</code></td>
                        <td><code class="text-xs text-foreground/50">@(string.IsNullOrEmpty(row.Default) ? "—" : row.Default)</code></td>
                        <td class="text-sm text-foreground/80">@row.Description</td>
                    </tr>
                }
            </tbody>
        </ScarnaTable>
    </ScarnaCard>
</section>

@code {
    /// <summary>Заголовок над таблицей — по умолчанию "Параметры". Пусто — без заголовка (для второй таблицы на странице, например у Select/SelectItem).</summary>
    [Parameter] public string? Title { get; set; } = "Параметры";

    [Parameter, EditorRequired] public IReadOnlyList<DocApiRow> Rows { get; set; } = Array.Empty<DocApiRow>();
}
