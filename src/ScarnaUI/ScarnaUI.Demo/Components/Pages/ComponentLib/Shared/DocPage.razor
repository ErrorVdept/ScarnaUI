@*
    Каркас страницы интерактивной документации одного компонента/сервиса —
    как страницы на mudblazor.com: заголовок, вводное описание, список файлов
    исходников, а дальше секции с живыми примерами (DocSection) и таблица API
    (DocApiTable) как ChildContent. Боковое меню (ScarnaDrawer), контейнер и
    отступы даёт вложенный ComponentLibLayout — подключается через @layout в
    ComponentLib/_Imports.razor, поэтому здесь их нет.
*@
@namespace ScarnaUI.Demo.Components.Pages.ComponentLib.Shared

<ScarnaStack Spacing="6">
    <div>
        <h1 class="text-2xl font-semibold">@Title</h1>
        @if (!string.IsNullOrEmpty(Lead))
        {
            <p class="mt-2 max-w-3xl text-sm text-foreground/70">@Lead</p>
        }
        @if (Files is { Count: > 0 })
        {
            <div class="mt-3 flex flex-wrap gap-2">
                @foreach (var file in Files)
                {
                    <ScarnaTag>@file</ScarnaTag>
                }
            </div>
        }
    </div>

    @ChildContent
</ScarnaStack>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;

    /// <summary>Короткое вводное описание компонента под заголовком.</summary>
    [Parameter] public string? Lead { get; set; }

    /// <summary>Пути файлов исходников — показываются тегами под заголовком (как "Файлы" в docmd/*.md).</summary>
    [Parameter] public IReadOnlyList<string>? Files { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }
}
