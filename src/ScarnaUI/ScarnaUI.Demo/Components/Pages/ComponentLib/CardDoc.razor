@page "/componentlib/card"

<DocPage Title="ScarnaCard" Lead="Контейнер-карточка с фоном content1, скруглением и опциональными заголовком/подвалом."
         Files="@(new[] { "Components/DataDisplay/ScarnaCard.razor" })">

    <DocSection Title="Базовая карточка" Code="@BasicCode">
        <ScarnaCard>
            Товар: Кроссовки, размер 42. Статус: в пути.
        </ScarnaCard>
    </DocSection>

    <DocSection Title="С заголовком и подвалом" Description="HeaderContent и FooterContent рисуются с разделителями." Code="@HeaderFooterCode">
        <ScarnaCard>
            <HeaderContent><span class="font-semibold">Заказ #1234</span></HeaderContent>
            <ChildContent>Товар: Кроссовки, размер 42. Статус: в пути.</ChildContent>
            <FooterContent><ScarnaButton Size="Size.Small">Подробнее</ScarnaButton></FooterContent>
        </ScarnaCard>
    </DocSection>

    <DocSection Title="Bordered / Shadow / Radius" Code="@VariantsCode">
        <ScarnaCard Bordered="true" Shadow="false">Bordered, без тени</ScarnaCard>
        <ScarnaCard Radius="Radius.Small">Radius.Small</ScarnaCard>
        <ScarnaCard Radius="Radius.None">Radius.None</ScarnaCard>
    </DocSection>

    <DocSection Title="GlassEffect" Description="Полупрозрачный фон с блюром (backdrop-blur) вместо сплошного bg-content1 — тот же приём, что у ScarnaNavBar. Заметно поверх фонового изображения/градиента." Code="@GlassCode">
        <div class="flex items-center justify-center rounded-scarna-lg bg-gradient-to-br from-primary to-secondary p-8">
            <ScarnaCard GlassEffect="true" Class="text-white">
                <HeaderContent><span class="font-semibold">GlassEffect="true"</span></HeaderContent>
                <ChildContent>Фон карточки — полупрозрачный с блюром, виден градиент под ней.</ChildContent>
            </ScarnaCard>
        </div>
    </DocSection>

    <DocSection Title="Color" Description="Фон на цвет темы. Default — нейтральная поверхность (bg-content1), Transparent — без заливки." Code="@ColorCode">
        <ScarnaCard Color="Color.Primary">Color.Primary</ScarnaCard>
        <ScarnaCard Color="Color.Transparent" Bordered="true">Color.Transparent</ScarnaCard>
    </DocSection>

    <DocApiTable Rows="@_rows" />

</DocPage>

@code {
    private const string BasicCode =
        """
        <ScarnaCard>
            Товар: Кроссовки, размер 42. Статус: в пути.
        </ScarnaCard>
        """;

    private const string HeaderFooterCode =
        """
        <ScarnaCard>
            <HeaderContent><span class="font-semibold">Заказ #1234</span></HeaderContent>
            <ChildContent>Товар: Кроссовки, размер 42. Статус: в пути.</ChildContent>
            <FooterContent><ScarnaButton Size="Size.Small">Подробнее</ScarnaButton></FooterContent>
        </ScarnaCard>
        """;

    private const string VariantsCode =
        """
        <ScarnaCard Bordered="true" Shadow="false">Bordered, без тени</ScarnaCard>
        <ScarnaCard Radius="Radius.Small">Radius.Small</ScarnaCard>
        <ScarnaCard Radius="Radius.None">Radius.None</ScarnaCard>
        """;

    private const string GlassCode =
        """
        <div class="bg-gradient-to-br from-primary to-secondary p-8">
            <ScarnaCard GlassEffect="true">
                <HeaderContent>GlassEffect="true"</HeaderContent>
                Фон карточки — полупрозрачный с блюром.
            </ScarnaCard>
        </div>
        """;

    private const string ColorCode =
        """
        <ScarnaCard Color="Color.Primary">...</ScarnaCard>
        <ScarnaCard Color="Color.Transparent" Bordered="true">...</ScarnaCard>
        """;

    private readonly List<DocApiRow> _rows = new()
    {
        new("Bordered", "bool", "false", "Тонкая рамка в дополнение к тени"),
        new("Shadow", "bool", "true", "Тень под карточкой"),
        new("Radius", "Radius", "Large", "Радиус скругления"),
        new("GlassEffect", "bool", "false", "Полупрозрачный фон с блюром вместо сплошного bg-content1 — как у ScarnaNavBar"),
        new("Color", "Color", "Default", "Фон карточки. Default — нейтральная поверхность темы; Transparent — без заливки; остальные — заливка цветом темы. Игнорируется при GlassEffect=\"true\""),
        new("HeaderContent", "RenderFragment?", "—", "Заголовок (с разделителем снизу)"),
        new("FooterContent", "RenderFragment?", "—", "Подвал (с разделителем сверху)"),
        new("ChildContent", "RenderFragment?", "—", "Основное содержимое"),
    };
}
