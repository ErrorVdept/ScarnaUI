@page "/getting-started"
@inject INavigator Navigator

<PageTitle>ScarnaUI — установка</PageTitle>

<ScarnaContainer MaxWidth="ScarnaContainerMaxWidth.Medium">
    <ScarnaStack Spacing="10" Class="pb-20">

        <div>
            <ScarnaChip Color="Color.Primary" Variant="Variant.Flat">Быстрый старт</ScarnaChip>
            <h1 class="mt-3 text-3xl font-semibold text-foreground">Подключение ScarnaUI</h1>
            <p class="mt-2 max-w-xl text-foreground/60">
                Пять шагов от чистого проекта до работающей темы, диалогов и тостов.
                Без npm и без сборки CSS на своей стороне — готовый файл уже лежит внутри библиотеки.
            </p>
        </div>

        <GuideStep Number="1" Title="Ссылка на проект">
            <p class="mb-3 text-sm text-foreground/70">ScarnaUI — обычная Razor Class Library, подключается как ссылка на проект.</p>
            <ScarnaCodeBlock Code="dotnet add reference ../ScarnaUI/ScarnaUI.csproj" />
        </GuideStep>

        <GuideStep Number="2" Title="Регистрация сервисов">
            <p class="mb-3 text-sm text-foreground/70">В <code class="rounded-scarna-sm bg-content2 px-1.5 py-0.5 text-xs">Program.cs</code> — диалоги, тосты и Navigator одной строкой.</p>
            <ScarnaCodeBlock Code="builder.Services.AddScarnaUI();" />
        </GuideStep>

        <GuideStep Number="3" Title="Подключить CSS">
            <p class="mb-3 text-sm text-foreground/70">Готовый CSS едет внутри библиотеки как статический ресурс RCL — подключается обычным <code class="rounded-scarna-sm bg-content2 px-1.5 py-0.5 text-xs">&lt;link&gt;</code> в <code class="rounded-scarna-sm bg-content2 px-1.5 py-0.5 text-xs">App.razor</code>.</p>
            <ScarnaCodeBlock Code='<link rel="stylesheet" href="_content/ScarnaUI/css/scarna/scarna.css" />' />
        </GuideStep>

        <GuideStep Number="4" Title="Скрипт против вспышки светлым (FOUC)">
            <p class="mb-3 text-sm text-foreground/70">
                Без него страница на первом кадре всегда рисуется светлой (CSS-переменные по умолчанию —
                светлая тема), и только после подключения circuit'а и первого рендера
                <code class="rounded-scarna-sm bg-content2 px-1.5 py-0.5 text-xs">ScarnaThemeProvider</code>
                тёмная тема реально применяется. Добавьте синхронно в <code class="rounded-scarna-sm bg-content2 px-1.5 py-0.5 text-xs">&lt;head&gt;</code>, до остального содержимого:
            </p>
            <ScarnaCodeBlock Code="@FoucScript" />
        </GuideStep>

        <GuideStep Number="5" Title="Провайдеры в MainLayout">
            <p class="mb-3 text-sm text-foreground/70">Порядок важен — <code class="rounded-scarna-sm bg-content2 px-1.5 py-0.5 text-xs">ScarnaPopoverProvider</code> должен оборачивать <code class="rounded-scarna-sm bg-content2 px-1.5 py-0.5 text-xs">@@Body</code>, диалог/тосты можно разместить рядом.</p>
            <ScarnaCodeBlock Code="@LayoutCode" />
        </GuideStep>

        <GuideStep Number="6" Title="Импорты неймспейсов" Last="true">
            <p class="mb-3 text-sm text-foreground/70">В <code class="rounded-scarna-sm bg-content2 px-1.5 py-0.5 text-xs">_Imports.razor</code> своего проекта — чтобы писать <code class="rounded-scarna-sm bg-content2 px-1.5 py-0.5 text-xs">&lt;ScarnaButton&gt;</code> без полного пути.</p>
            <ScarnaCodeBlock Code="@ImportsCode" />
        </GuideStep>

        <ScarnaDivider />

        <div>
            <h2 class="mb-4 text-lg font-semibold text-foreground">Куда дальше</h2>
            <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
                <ScarnaPaper Hovered="true" OnClick='() => Navigator.NavigateTo("/componentlib")'>
                    <p class="font-medium text-foreground">Все компоненты</p>
                    <p class="mt-1 text-sm text-foreground/60">Живые примеры, код, таблицы параметров — по образцу mudblazor.com.</p>
                </ScarnaPaper>
                <ScarnaPaper Hovered="true" OnClick='() => Navigator.NavigateTo("/showcase/stackoverflow")'>
                    <p class="font-medium text-foreground">Пример: Stack Overflow</p>
                    <p class="mt-1 text-sm text-foreground/60">Готовый интерфейс целиком из компонентов библиотеки.</p>
                </ScarnaPaper>
                <ScarnaPaper Hovered="true" OnClick='() => Navigator.NavigateTo("/showcase/tasks")'>
                    <p class="font-medium text-foreground">Пример: доска задач</p>
                    <p class="mt-1 text-sm text-foreground/60">Канбан-доска — тоже без единой собственной строчки CSS.</p>
                </ScarnaPaper>
            </div>
        </div>

    </ScarnaStack>
</ScarnaContainer>

@code {
    private const string FoucScript =
        """
        <script>
            (function () {
                try {
                    var stored = localStorage.getItem("scarna-theme-mode");
                    var isDark = stored === "dark"
                        || (stored !== "light" && window.matchMedia("(prefers-color-scheme: dark)").matches);
                    document.documentElement.setAttribute("data-theme", isDark ? "dark" : "light");
                    document.documentElement.style.colorScheme = isDark ? "dark" : "light";
                } catch (e) {}
            })();
        </script>
        """;

    private const string LayoutCode =
        """
        <ScarnaThemeProvider>
            <ScarnaPopoverProvider>
                @Body
            </ScarnaPopoverProvider>

            <ScarnaDialogProvider />
            <ScarnaSnackbarProvider />
        </ScarnaThemeProvider>
        """;

    private const string ImportsCode =
        """
        @using ScarnaUI.Components.Base
        @using ScarnaUI.Components.Theme
        @using ScarnaUI.Components.Layout
        @using ScarnaUI.Components.Actions
        @using ScarnaUI.Components.Forms
        @using ScarnaUI.Components.Navigation
        @using ScarnaUI.Components.DataDisplay
        @using ScarnaUI.Components.Overlays
        @using ScarnaUI.Services
        """;
}
