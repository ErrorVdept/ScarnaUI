@page "/showcase/main-layout"

@*
    Проверочная страница библиотеки: "Main Layouts" с
    https://mudblazor.com/getting-started/wireframes#main-layouts, плюс остальные
    комбинации AppBar+Drawer, которые открылись после добавления ScarnaDrawerVariant
    (Persistent/Mini) — только публичные параметры ScarnaNavBar/ScarnaDrawer, ничего
    в самих компонентах не менялось сверх этого. "Custom Content"-раздел с той же
    страницы MudBlazor не делался — не просили.
*@

<PageTitle>Showcase — Layouts</PageTitle>

<ScarnaContainer Breakpoint="ScarnaContainerMaxWidth.Large">
    <ScarnaStack Spacing="10" Class="pb-16">

        <div>
            <h1 class="text-2xl font-semibold text-foreground">Layout wireframes</h1>
            <p class="mt-2 max-w-xl text-sm text-foreground/60">
                Типовые компоновки страницы — как в галерее wireframe'ов MudBlazor, только
                из компонентов ScarnaUI (<code class="rounded-scarna-sm bg-content2 px-1.5 py-0.5 text-xs">ScarnaLayout</code> +
                <code class="rounded-scarna-sm bg-content2 px-1.5 py-0.5 text-xs">ScarnaNavBar</code> +
                <code class="rounded-scarna-sm bg-content2 px-1.5 py-0.5 text-xs">ScarnaDrawer</code> +
                <code class="rounded-scarna-sm bg-content2 px-1.5 py-0.5 text-xs">ScarnaNavMenu</code>/<code class="rounded-scarna-sm bg-content2 px-1.5 py-0.5 text-xs">ScarnaNavLink</code>).
                Код примеров (кнопка «Показать код») — целиком MainLayout.razor с
                <code class="rounded-scarna-sm bg-content2 px-1.5 py-0.5 text-xs">ScarnaLayout</code> на корне
                вместо самодельного <code class="rounded-scarna-sm bg-content2 px-1.5 py-0.5 text-xs">min-h-screen</code>-div'а.
                Variant у ScarnaDrawer — Temporary/Persistent/Mini, см. <a href="/componentlib/drawer" class="text-primary hover:underline">документацию</a>.
            </p>
        </div>

        <DocSection Title="1. Temporary drawer + top appbar" Description="Обычная связка — Drawer выезжает поверх содержимого по клику на гамбургер, с подложкой (Variant.Temporary, по умолчанию)." Row="false" Code="@TemporaryCode">
            <div class="overflow-hidden rounded-scarna-lg border border-divider bg-content1">
                <ScarnaNavBar Sticky="false" Color="Color.Primary">
                    <ScarnaStack Row="true" Spacing="3" Align="Align.Center">
                        <ScarnaButton Variant="Variant.Light" Size="Size.Small" Class="text-primary-foreground! hover:bg-white/15!" OnClick="() => _temporaryOpen = !_temporaryOpen">
                            @HamburgerIcon
                        </ScarnaButton>
                        <span class="font-semibold">My application</span>
                    </ScarnaStack>
                    <ScarnaButton Variant="Variant.Light" Size="Size.Small" Class="text-primary-foreground! hover:bg-white/15!">
                        @KebabIcon
                    </ScarnaButton>
                </ScarnaNavBar>

                <div class="relative flex min-h-96 overflow-hidden">
                    <ScarnaDrawer @bind-Open="_temporaryOpen" Anchor="ScarnaDrawerAnchor.Left" Width="240px" Class="absolute!">
                        @NavList
                    </ScarnaDrawer>

                    <main class="flex-1 p-6">
                        <p class="text-sm text-foreground/40">Содержимое страницы — пусто нарочно, это wireframe-заготовка.</p>
                    </main>
                </div>
            </div>
        </DocSection>

        <DocSection Title="2. Persistent drawer — AppBar отодвигается вместе с ним" Description="Variant.Persistent — панель реальная часть потока (flex-элемент), поэтому весь правый столбец (AppBar + контент) сам раздвигается вместе с её шириной, плавно, без подложки и без ручной синхронизации отступов." Row="false" Code="@PersistentShiftCode">
            <div class="flex min-h-96 overflow-hidden rounded-scarna-lg border border-divider bg-content1">
                <ScarnaDrawer @bind-Open="_persistentShiftOpen" Anchor="ScarnaDrawerAnchor.Left" Variant="ScarnaDrawerVariant.Persistent" Width="240px">
                    @NavList
                </ScarnaDrawer>

                <div class="flex flex-1 flex-col overflow-hidden">
                    <ScarnaNavBar Sticky="false" Color="Color.Primary" Class="rounded-none">
                        <ScarnaStack Row="true" Spacing="3" Align="Align.Center">
                            <ScarnaButton Variant="Variant.Light" Size="Size.Small" Class="text-primary-foreground! hover:bg-white/15!" OnClick="() => _persistentShiftOpen = !_persistentShiftOpen">
                                @HamburgerIcon
                            </ScarnaButton>
                            <span class="font-semibold">My application</span>
                        </ScarnaStack>
                        <ScarnaButton Variant="Variant.Light" Size="Size.Small" Class="text-primary-foreground! hover:bg-white/15!">
                            @KebabIcon
                        </ScarnaButton>
                    </ScarnaNavBar>

                    <main class="flex-1 p-6">
                        <p class="text-sm text-foreground/40">Содержимое страницы — пусто нарочно, это wireframe-заготовка.</p>
                    </main>
                </div>
            </div>
        </DocSection>

        <DocSection Title="3. Top appbar with clipped drawer" Description="AppBar на всю ширину сверху, drawer — колонка НИЖЕ него (не наезжает поверх). Variant.Persistent — то же самое, что и раньше, но теперь с плавной анимацией ширины вместо мгновенного появления/исчезновения." Row="false" Code="@ClippedCode">
            <div class="overflow-hidden rounded-scarna-lg border border-divider bg-content1">
                <ScarnaNavBar Sticky="false" Color="Color.Primary">
                    <ScarnaStack Row="true" Spacing="3" Align="Align.Center">
                        <ScarnaButton Variant="Variant.Light" Size="Size.Small" Class="text-primary-foreground! hover:bg-white/15!" OnClick="() => _clippedOpen = !_clippedOpen">
                            @HamburgerIcon
                        </ScarnaButton>
                        <span class="font-semibold">My application</span>
                    </ScarnaStack>
                    <ScarnaButton Variant="Variant.Light" Size="Size.Small" Class="text-primary-foreground! hover:bg-white/15!">
                        @KebabIcon
                    </ScarnaButton>
                </ScarnaNavBar>

                <div class="flex min-h-96 overflow-hidden">
                    <ScarnaDrawer @bind-Open="_clippedOpen" Anchor="ScarnaDrawerAnchor.Left" Variant="ScarnaDrawerVariant.Persistent" Width="240px">
                        @NavList
                    </ScarnaDrawer>

                    <main class="flex-1 p-6">
                        <p class="text-sm text-foreground/40">Содержимое страницы — пусто нарочно, это wireframe-заготовка.</p>
                    </main>
                </div>
            </div>
        </DocSection>

        <DocSection Title="4. Mini drawer" Description="Variant.Mini — не схлопывается до нуля, в закрытом состоянии остаётся узкой полосой (MiniWidth) под одни иконки, разворачивается в полную ширину по клику. Подпись — тот же span всегда в DOM, но с max-width/opacity, синхронно анимируется вместе с шириной панели, а не появляется рывком." Row="false" Code="@MiniCode">
            <div class="flex min-h-96 overflow-hidden rounded-scarna-lg border border-divider bg-content1">
                <ScarnaDrawer @bind-Open="_miniOpen" Anchor="ScarnaDrawerAnchor.Left" Variant="ScarnaDrawerVariant.Mini" Width="240px" MiniWidth="48px">
                    <ScarnaNavMenu Class="p-1">
                        @foreach (var item in _navItems)
                        {
                            <ScarnaEmojiNavLink Href="@item.Href" Emoji="@item.Emoji" Text="@item.Text" Expanded="_miniOpen" />
                        }
                    </ScarnaNavMenu>
                </ScarnaDrawer>

                <div class="flex flex-1 flex-col overflow-hidden">
                    <ScarnaNavBar Sticky="false" Color="Color.Primary" Class="rounded-none">
                        <ScarnaStack Row="true" Spacing="3" Align="Align.Center">
                            <ScarnaButton Variant="Variant.Light" Size="Size.Small" Class="text-primary-foreground! hover:bg-white/15!" OnClick="() => _miniOpen = !_miniOpen">
                                @HamburgerIcon
                            </ScarnaButton>
                            <span class="font-semibold">My application</span>
                        </ScarnaStack>
                        <ScarnaButton Variant="Variant.Light" Size="Size.Small" Class="text-primary-foreground! hover:bg-white/15!">
                            @KebabIcon
                        </ScarnaButton>
                    </ScarnaNavBar>

                    <main class="flex-1 p-6">
                        <p class="text-sm text-foreground/40">Содержимое страницы — пусто нарочно, это wireframe-заготовка.</p>
                    </main>
                </div>
            </div>
        </DocSection>

        <DocSection Title="5. Mini drawer под appbar" Description="Та же связка, что и в примере 3 (AppBar на всю ширину сверху, drawer — колонка ниже него, не наезжает поверх), но с Variant.Mini вместо Persistent: панель не исчезает до нуля, а остаётся узкой полосой-иконками." Row="false" Code="@MiniUnderAppbarCode">
            <div class="overflow-hidden rounded-scarna-lg border border-divider bg-content1">
                <ScarnaNavBar Sticky="false" Color="Color.Primary">
                    <ScarnaStack Row="true" Spacing="3" Align="Align.Center">
                        <ScarnaButton Variant="Variant.Light" Size="Size.Small" Class="text-primary-foreground! hover:bg-white/15!" OnClick="() => _miniUnderAppbarOpen = !_miniUnderAppbarOpen">
                            @HamburgerIcon
                        </ScarnaButton>
                        <span class="font-semibold">My application</span>
                    </ScarnaStack>
                    <ScarnaButton Variant="Variant.Light" Size="Size.Small" Class="text-primary-foreground! hover:bg-white/15!">
                        @KebabIcon
                    </ScarnaButton>
                </ScarnaNavBar>

                <div class="flex min-h-96 overflow-hidden">
                    <ScarnaDrawer @bind-Open="_miniUnderAppbarOpen" Anchor="ScarnaDrawerAnchor.Left" Variant="ScarnaDrawerVariant.Mini" Width="240px" MiniWidth="48px">
                        <ScarnaNavMenu Class="p-1">
                            @foreach (var item in _navItems)
                            {
                                <ScarnaEmojiNavLink Href="@item.Href" Emoji="@item.Emoji" Text="@item.Text" Expanded="_miniUnderAppbarOpen" />
                            }
                        </ScarnaNavMenu>
                    </ScarnaDrawer>

                    <main class="flex-1 p-6">
                        <p class="text-sm text-foreground/40">Содержимое страницы — пусто нарочно, это wireframe-заготовка.</p>
                    </main>
                </div>
            </div>
        </DocSection>

        <DocSection Title="6. Appbar Only" Description="Только верхняя панель — без drawer вообще, самый простой каркас." Row="false" Code="@AppbarOnlyCode">
            <div class="overflow-hidden rounded-scarna-lg border border-divider bg-content1">
                <ScarnaNavBar Sticky="false" Color="Color.Primary">
                    <span class="font-semibold">My application</span>
                    <ScarnaButton Variant="Variant.Light" Size="Size.Small" Class="text-primary-foreground! hover:bg-white/15!">
                        @KebabIcon
                    </ScarnaButton>
                </ScarnaNavBar>

                <main class="min-h-96 p-6">
                    <p class="text-sm text-foreground/40">Содержимое страницы — пусто нарочно, это wireframe-заготовка.</p>
                </main>
            </div>
        </DocSection>

    </ScarnaStack>
</ScarnaContainer>

@code {
    // Temporary — заведомо закрыт при загрузке: у этого варианта подложка —
    // position:fixed на весь экран (см. docmd/drawer.md), не только на область
    // карточки-wireframe'а. Открытым по умолчанию она бы сразу затемняла всю
    // страницу вокруг маленькой демо-карточки.
    private bool _temporaryOpen;

    // Persistent/Mini подложку не рисуют вообще — открытыми по умолчанию безопасны
    // и сразу показывают более интересное (развёрнутое) состояние примера.
    private bool _persistentShiftOpen = true;
    private bool _clippedOpen = true;
    private bool _miniOpen;
    private bool _miniUnderAppbarOpen;

    private sealed record NavItem(string Text, string Href, RenderFragment Icon, string Emoji);

    private RenderFragment HamburgerIcon =>
        @<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6" /><line x1="3" y1="12" x2="21" y2="12" /><line x1="3" y1="18" x2="21" y2="18" /></svg>;

    private RenderFragment KebabIcon =>
        @<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="1" /><circle cx="12" cy="5" r="1" /><circle cx="12" cy="19" r="1" /></svg>;

    // ScarnaNavMenu/ScarnaNavLink вместо самодельных <span> — ссылки ведут на
    // реальные страницы демо (как в componentlib/nav-menu), поэтому активный пункт
    // подсвечивается по-настоящему через INavigator, без ручного bool "выбран ли".
    private RenderFragment NavList =>
        @<div>
            <div class="border-b border-divider px-4 py-3 font-semibold">Application</div>
            <ScarnaNavMenu Class="p-2">
                @foreach (var item in _navItems)
                {
                    <ScarnaNavLink Href="@item.Href">
                        <StartContent>@item.Icon</StartContent>
                        <ChildContent>@item.Text</ChildContent>
                    </ScarnaNavLink>
                }
            </ScarnaNavMenu>
        </div>;

    private NavItem[] _navItems =>
    [
        new("Dashboard", "/showcase/main-layout", @<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0"><rect x="3" y="3" width="7" height="7" /><rect x="14" y="3" width="7" height="7" /><rect x="14" y="14" width="7" height="7" /><rect x="3" y="14" width="7" height="7" /></svg>, "📊"),
        new("Orders", "/componentlib/table", @<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z" /><line x1="3" y1="6" x2="21" y2="6" /><path d="M16 10a4 4 0 0 1-8 0" /></svg>, "🛒"),
        new("Settings", "/componentlib/theme-provider", @<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0"><circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" /></svg>, "⚙️"),
    ];

    // Ниже — не изолированные фрагменты, а целиком MainLayout.razor (как в
    // getting-started.md, шаг 4): ScarnaThemeProvider/ScarnaPopoverProvider/
    // ScarnaDialogProvider/ScarnaSnackbarProvider оборачивают разметку так же, как
    // это нужно сделать один раз в реальном приложении-потребителе.
    private const string TemporaryCode =
        """
        @inherits LayoutComponentBase

        <ScarnaThemeProvider>
            <ScarnaPopoverProvider>
                @* ScarnaLayout — вместо <div class="min-h-screen bg-background text-foreground">
                   на корне MainLayout.razor: min-height:100vh, flex flex-col, цвета темы —
                   уже внутри, вручную дублировать не нужно. relative/overflow-hidden — свои,
                   под конкретную компоновку этого wireframe'а (Class добавляется к готовым). *@
                <ScarnaLayout Height="100vh" MinHeight="0" Class="relative overflow-hidden">
                    <ScarnaNavBar Color="Color.Primary">
                        <ScarnaButton OnClick="() => _open = !_open"><!-- гамбургер --></ScarnaButton>
                        <span>My application</span>
                    </ScarnaNavBar>

                    <div class="relative flex flex-1 overflow-hidden">
                        <ScarnaDrawer @bind-Open="_open" Anchor="ScarnaDrawerAnchor.Left" Width="240px">
                            <ScarnaNavMenu Class="p-2">
                                <ScarnaNavLink Href="/dashboard">
                                    <StartContent><DashboardIcon /></StartContent>
                                    <ChildContent>Dashboard</ChildContent>
                                </ScarnaNavLink>
                                <ScarnaNavLink Href="/orders">
                                    <StartContent><OrdersIcon /></StartContent>
                                    <ChildContent>Orders</ChildContent>
                                </ScarnaNavLink>
                            </ScarnaNavMenu>
                        </ScarnaDrawer>

                        <main class="flex-1 overflow-y-auto p-6">@Body</main>
                    </div>
                </ScarnaLayout>
            </ScarnaPopoverProvider>

            <ScarnaDialogProvider />
            <ScarnaSnackbarProvider />
        </ScarnaThemeProvider>

        @code {
            private bool _open;
        }
        """;

    private const string PersistentShiftCode =
        """
        @inherits LayoutComponentBase

        <ScarnaThemeProvider>
            <ScarnaPopoverProvider>
                @* Flex="false" — ScarnaLayout по умолчанию рендерит flex-col (см. TemporaryCode),
                   а тут Drawer и колонка AppBar+контент стоят В РЯД (flex-row), поэтому
                   собственное "flex" в Class задаём сами, без Layout-овского flex-col. *@
                <ScarnaLayout Height="100vh" MinHeight="0" Flex="false" Class="flex overflow-hidden">
                    <ScarnaDrawer @bind-Open="_open" Anchor="ScarnaDrawerAnchor.Left"
                                 Variant="ScarnaDrawerVariant.Persistent" Width="240px">
                        <ScarnaNavMenu Class="p-2">
                            <ScarnaNavLink Href="/dashboard">
                                <StartContent><DashboardIcon /></StartContent>
                                <ChildContent>Dashboard</ChildContent>
                            </ScarnaNavLink>
                            <ScarnaNavLink Href="/orders">
                                <StartContent><OrdersIcon /></StartContent>
                                <ChildContent>Orders</ChildContent>
                            </ScarnaNavLink>
                        </ScarnaNavMenu>
                    </ScarnaDrawer>

                    <div class="flex flex-1 flex-col overflow-hidden">
                        <ScarnaNavBar Color="Color.Primary">
                            <ScarnaButton OnClick="() => _open = !_open"><!-- гамбургер --></ScarnaButton>
                            <span>My application</span>
                        </ScarnaNavBar>

                        <main class="flex-1 overflow-y-auto p-6">@Body</main>
                    </div>
                </ScarnaLayout>
            </ScarnaPopoverProvider>

            <ScarnaDialogProvider />
            <ScarnaSnackbarProvider />
        </ScarnaThemeProvider>

        @code {
            private bool _open = true;
        }
        """;

    private const string ClippedCode =
        """
        @inherits LayoutComponentBase

        <ScarnaThemeProvider>
            <ScarnaPopoverProvider>
                <ScarnaLayout Height="100vh" MinHeight="0" Class="overflow-hidden">
                    <ScarnaNavBar Color="Color.Primary">
                        <ScarnaButton OnClick="() => _open = !_open"><!-- гамбургер --></ScarnaButton>
                        <span>My application</span>
                    </ScarnaNavBar>

                    <div class="flex flex-1 overflow-hidden">
                        <ScarnaDrawer @bind-Open="_open" Anchor="ScarnaDrawerAnchor.Left"
                                     Variant="ScarnaDrawerVariant.Persistent" Width="240px">
                            <ScarnaNavMenu Class="p-2">
                                <ScarnaNavLink Href="/dashboard">
                                    <StartContent><DashboardIcon /></StartContent>
                                    <ChildContent>Dashboard</ChildContent>
                                </ScarnaNavLink>
                                <ScarnaNavLink Href="/orders">
                                    <StartContent><OrdersIcon /></StartContent>
                                    <ChildContent>Orders</ChildContent>
                                </ScarnaNavLink>
                            </ScarnaNavMenu>
                        </ScarnaDrawer>

                        <main class="flex-1 overflow-y-auto p-6">@Body</main>
                    </div>
                </ScarnaLayout>
            </ScarnaPopoverProvider>

            <ScarnaDialogProvider />
            <ScarnaSnackbarProvider />
        </ScarnaThemeProvider>

        @code {
            private bool _open = true;
        }
        """;

    private const string MiniCode =
        """
        @inherits LayoutComponentBase

        <ScarnaThemeProvider>
            <ScarnaPopoverProvider>
                <ScarnaLayout Height="100vh" MinHeight="0" Flex="false" Class="flex overflow-hidden">
                    <ScarnaDrawer @bind-Open="_open" Anchor="ScarnaDrawerAnchor.Left"
                                 Variant="ScarnaDrawerVariant.Mini" Width="240px" MiniWidth="48px">
                        <ScarnaNavMenu Class="p-1">
                            @foreach (var item in _navItems)
                            {
                                @* ScarnaEmojiNavLink — готовая обёртка под этот сценарий: эмодзи вместо
                                   SVG в колонке фиксированной ширины (не зависит от Expanded, поэтому
                                   не двигается между открытым/свёрнутым состоянием — дёргаться нечему),
                                   подпись анимируется через max-width/opacity синхронно с шириной
                                   панели. Expanded="_open" — то же bool, что открывает и сам Drawer. *@
                                <ScarnaEmojiNavLink Href="@item.Href" Emoji="@item.Emoji" Text="@item.Text" Expanded="_open" />
                            }
                        </ScarnaNavMenu>
                    </ScarnaDrawer>

                    <div class="flex flex-1 flex-col overflow-hidden">
                        <ScarnaNavBar Color="Color.Primary">
                            <ScarnaButton OnClick="() => _open = !_open"><!-- гамбургер --></ScarnaButton>
                            <span>My application</span>
                        </ScarnaNavBar>

                        <main class="flex-1 overflow-y-auto p-6">@Body</main>
                    </div>
                </ScarnaLayout>
            </ScarnaPopoverProvider>

            <ScarnaDialogProvider />
            <ScarnaSnackbarProvider />
        </ScarnaThemeProvider>

        @code {
            private bool _open;

            private record NavItem(string Text, string Href, string Emoji);
            private NavItem[] _navItems = [ /* ... */ ];
        }
        """;

    private const string MiniUnderAppbarCode =
        """
        @inherits LayoutComponentBase

        <ScarnaThemeProvider>
            <ScarnaPopoverProvider>
                <ScarnaLayout Height="100vh" MinHeight="0" Class="overflow-hidden">
                    <ScarnaNavBar Color="Color.Primary">
                        <ScarnaButton OnClick="() => _open = !_open"><!-- гамбургер --></ScarnaButton>
                        <span>My application</span>
                    </ScarnaNavBar>

                    <div class="flex flex-1 overflow-hidden">
                        <ScarnaDrawer @bind-Open="_open" Anchor="ScarnaDrawerAnchor.Left"
                                     Variant="ScarnaDrawerVariant.Mini" Width="240px" MiniWidth="48px">
                            <ScarnaNavMenu Class="p-1">
                                @foreach (var item in _navItems)
                                {
                                    <ScarnaEmojiNavLink Href="@item.Href" Emoji="@item.Emoji" Text="@item.Text" Expanded="_open" />
                                }
                            </ScarnaNavMenu>
                        </ScarnaDrawer>

                        <main class="flex-1 overflow-y-auto p-6">@Body</main>
                    </div>
