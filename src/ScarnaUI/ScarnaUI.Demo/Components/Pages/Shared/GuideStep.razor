@*
    Один пронумерованный шаг инструкции — кружок с номером, вертикальная линия
    к следующему шагу (кроме последнего), заголовок и произвольное содержимое.
    Локальный helper-компонент страницы GettingStarted, не часть библиотеки ScarnaUI.
*@
@namespace ScarnaUI.Demo.Components.Pages.Shared

<div class="flex gap-4">
    <div class="flex flex-col items-center">
        <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-primary text-sm font-semibold text-primary-foreground">@Number</span>
        @if (!Last)
        {
            <span class="mt-1 w-px flex-1 bg-divider"></span>
        }
    </div>
    <div class="min-w-0 flex-1 pb-8">
        <h3 class="mb-2 text-base font-semibold text-foreground">@Title</h3>
        @ChildContent
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Number { get; set; } = string.Empty;

    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;

    /// <summary>Последний шаг — не рисует соединительную линию вниз.</summary>
    [Parameter] public bool Last { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }
}
