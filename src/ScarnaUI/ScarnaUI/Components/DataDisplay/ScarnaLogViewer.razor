@namespace ScarnaUI.Components.DataDisplay
@using System.Text
@using System.Text.RegularExpressions
@using ScarnaUI.Components.DataDisplay.LogViewer
@inherits ScarnaComponentBase
@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="scarna-logviewer" style="@RootStyle" @attributes="UserAttributes" @ref="_root">
    <div class="scarna-logviewer__toolbar">
        <label><input type="checkbox" @bind="_wrap" @bind:after="WrapChanged" /> Перенос</label>
        <button type="button" @onclick="ReloadAsync">Обновить</button>
        <button type="button" class="scarna-logviewer__search-button" @onclick="OpenSearchAsync" title="Поиск (Ctrl+F)" aria-label="Открыть поиск">⌕</button>
    </div>
    @if (_searchOpen)
    {
        <div class="scarna-logviewer__find" role="search" aria-label="Поиск в журнале">
            <div class="scarna-logviewer__find-input">
                <input @ref="_searchInput" aria-label="Поиск в журнале" placeholder="Найти" value="@_query" @oninput="SearchChanged" @onkeydown="SearchKeyAsync" />
                <button type="button" class="@(_caseSensitive ? "active" : "")" aria-pressed="@_caseSensitive" title="Учитывать регистр" @onclick="ToggleCaseAsync">Aa</button>
                <button type="button" class="@(_regex ? "active" : "")" aria-pressed="@_regex" title="Регулярное выражение" @onclick="ToggleRegexAsync">.*</button>
                <button type="button" class="@(_multiline ? "active" : "")" aria-pressed="@_multiline" title="Многострочный поиск" @onclick="ToggleMultilineAsync">↵</button>
            </div>
            <span class="scarna-logviewer__find-count" aria-live="polite">@(_matches.Count == 0 ? "Нет результатов" : $"{_matchIndex + 1} из {_matches.Count}")</span>
            <button type="button" @onclick="PreviousAsync" aria-label="Предыдущее совпадение" title="Предыдущее совпадение (Shift+Enter)">↑</button>
            <button type="button" @onclick="NextAsync" aria-label="Следующее совпадение" title="Следующее совпадение (Enter)">↓</button>
            <button type="button" @onclick="CloseSearchAsync" aria-label="Закрыть поиск" title="Закрыть (Esc)">×</button>
        </div>
    }
    @if (_busy) { <div role="status">Загрузка или обработка журнала… <button type="button" @onclick="Cancel">Отмена</button></div> }
    @if (_error is not null) { <div role="alert" class="scarna-logviewer__error">@_error</div> }
    <div class="scarna-logviewer__viewport" @ref="_viewport" tabindex="0" @onclick="CloseMenu">
        @if (_snapshot is not null)
        {
            <div data-log-spacer="before"></div>
            @foreach (var line in _window)
            {
                <div @key="line.Number" data-log-index="@line.Index" data-log-number="@line.Number" class="scarna-logviewer__line @(_wrap ? "scarna-logviewer__line--wrap" : "") @(IsSelected(line.Number) ? "scarna-logviewer__line--selected" : "") @(IsCurrentMatch(line.Number) ? "scarna-logviewer__line--current-match" : "")" @oncontextmenu="@(e => OpenMenu(e, line))" @oncontextmenu:preventDefault="true">
                    <div class="scarna-logviewer__gutter">
                        <button type="button" class="scarna-logviewer__marker @(IsSelected(line.Number) ? "selected" : "")" @onclick="@(e => SelectLine(e, line.Number))" @onclick:stopPropagation="true" aria-label="Выбрать строку @line.Number" aria-pressed="@IsSelected(line.Number)" title="Выбрать строку; Shift — диапазон"><span></span></button>
                        <span class="scarna-logviewer__number">@line.Number</span>
                    </div>
                    <span class="scarna-logviewer__text">@HighlightLine(line.Text)</span>
                </div>
            }
            <div data-log-spacer="after"></div>
        }
    </div>
    @if (_menu is not null)
    {
        <div class="scarna-logviewer__menu" style="@MenuStyle" role="menu" @onclick:stopPropagation="true">
            <button type="button" role="menuitem" @onclick="CopySelectionAsync">Копировать выделенное</button>
            <button type="button" role="menuitem" @onclick="CopyLineAsync">Копировать строку</button>
            <button type="button" role="menuitem" @onclick="CopySelectedLinesAsync">Копировать выбранные строки</button>
            @if (ContextMenu is not null) { @ContextMenu(_menu) }
        </div>
    }
    <div class="scarna-logviewer__status">Строк: @(_snapshot?.LineCount ?? 0); показано: @_visible.Count</div>
</div>

@code {
    [Parameter] public string? FilePath { get; set; }
    [Parameter] public string? Text { get; set; }
    [Parameter] public Stream? Stream { get; set; }
    [Parameter] public string? IncludePattern { get; set; }
    [Parameter] public string? ExcludePattern { get; set; }
    [Parameter] public bool FilterMultiline { get; set; }
    [Parameter] public bool FilterIgnoreCase { get; set; }
    [Parameter] public RenderFragment<ScarnaLogContext>? ContextMenu { get; set; }
    [Parameter] public EventCallback<int> LineSelected { get; set; }

    private record Line(int Index, int Number, string Text);
    private LogSnapshot? _snapshot;
    private List<int> _visible = new();
    private List<int> _matches = new();
    private int _matchIndex = -1, _anchorLine, _forcedLine;
    private readonly HashSet<int> _selectedLines = new();
    private int _selectionVersion;
    private string _query = string.Empty;
    private Regex? _highlightRegex;
    private bool _regex, _caseSensitive, _multiline, _wrap, _busy, _searchOpen, _focusSearch;
    private string? _error, _lastPath, _lastText, _lastInclude, _lastExclude;
    private Stream? _lastStream;
    private bool _lastFilterMultiline, _lastFilterIgnoreCase;
    private CancellationTokenSource? _operation;
    private List<Line> _window = new();
    private int _viewRevision, _appliedRevision = -1, _windowRequest;
    private DotNetObjectReference<ScarnaLogViewer>? _self;
    private ElementReference _root, _viewport, _searchInput;
    private CancellationTokenSource? _searchDebounce;
    private int _searchVersion;
    private IJSObjectReference? _module;
    private ScarnaLogContext? _menu;
    private double _menuX, _menuY;
    private string MenuStyle => FormattableString.Invariant($"left:{_menuX}px;top:{_menuY}px");

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_snapshot is null) return;
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/ScarnaUI/js/scarna/logviewer.js");
            if (_self is null)
            {
                _self = DotNetObjectReference.Create(this);
                await _module.InvokeVoidAsync("initialize", _viewport, _root, _self);
            }
            if (_appliedRevision != _viewRevision)
            {
                _appliedRevision = _viewRevision;
                await _module.InvokeVoidAsync("reset", _viewport, _visible.Count);
            }
            await _module.InvokeVoidAsync("observe", _viewport);
            await _module.InvokeVoidAsync("setSelectedCount", _viewport, _selectedLines.Count, _selectionVersion);
            if (_focusSearch) { _focusSearch = false; await _searchInput.FocusAsync(); }
        }
        catch (JSDisconnectedException) { }
    }

    private void WrapChanged() { _viewRevision++; _window.Clear(); }

    protected override async Task OnParametersSetAsync()
    {
        if (_lastPath != FilePath || _lastText != Text || !ReferenceEquals(_lastStream, Stream) || _snapshot is null)
        {
            _lastPath = FilePath; _lastText = Text; _lastStream = Stream;
            await ReloadAsync();
        }
        else if (_lastInclude != IncludePattern || _lastExclude != ExcludePattern || _lastFilterMultiline != FilterMultiline || _lastFilterIgnoreCase != FilterIgnoreCase)
            await ApplyFiltersAsync();
    }

    /// <summary>Создаёт новый снимок источника; поток читается с текущей позиции и не закрывается.</summary>
    public async Task ReloadAsync()
    {
        var token = BeginOperation();
        LogSnapshot? next = null;
        try
        {
            if ((FilePath is not null ? 1 : 0) + (Text is not null ? 1 : 0) + (Stream is not null ? 1 : 0) != 1)
                throw new InvalidOperationException("Укажите ровно один источник: FilePath, Text или Stream.");
            if (FilePath is not null)
            {
                await using var file = new FileStream(FilePath, FileMode.Open, FileAccess.Read, FileShare.ReadWrite | FileShare.Delete, 65536, true);
                next = await LogSnapshot.CreateAsync(file, token);
            }
            else if (Text is not null)
            {
                using var input = new MemoryStream(Encoding.UTF8.GetBytes(Text), false);
                next = await LogSnapshot.CreateAsync(input, token);
            }
            else next = await LogSnapshot.CreateAsync(Stream!, token);
            token.ThrowIfCancellationRequested();
            var old = _snapshot; _snapshot = next; next = null;
            // Сразу переключаем отображение на новый снимок: ошибка или отмена фильтра
            // не должны оставлять индексы строк предыдущего файла.
            _visible = Enumerable.Range(1, _snapshot.LineCount).ToList();
            _window.Clear(); _viewRevision++;
            if (old is not null) await old.DisposeAsync();
            if (_module is not null && _self is not null) await _module.InvokeVoidAsync("clearSavedSelection", _viewport);
            _matches.Clear(); _matchIndex = -1; _forcedLine = 0; _selectedLines.Clear(); _selectionVersion++; _anchorLine = 0; _highlightRegex = null;
            await FilterCoreAsync(token);
        }
        catch (OperationCanceledException) { }
        catch (Exception ex) { _error = ex.Message; }
        finally { if (next is not null) await next.DisposeAsync(); EndOperation(token); }
        await InvokeAsync(StateHasChanged);
    }

    private async Task ApplyFiltersAsync()
    {
        var token = BeginOperation();
        try { await FilterCoreAsync(token); }
        catch (OperationCanceledException) { }
        catch (Exception ex) { _error = ex.Message; }
        finally { EndOperation(token); }
        await InvokeAsync(StateHasChanged);
    }

    private async Task FilterCoreAsync(CancellationToken token)
    {
        if (_snapshot is null) return;
        var snapshot = _snapshot;
        List<int> visible;
        if (string.IsNullOrEmpty(IncludePattern) && string.IsNullOrEmpty(ExcludePattern))
            visible = Enumerable.Range(1, snapshot.LineCount).ToList();
        else
        {
            var include = MakeRegex(IncludePattern, FilterIgnoreCase, FilterMultiline);
            var exclude = MakeRegex(ExcludePattern, FilterIgnoreCase, FilterMultiline);
            if (FilterMultiline)
            {
                await using var content = await LogTextMap.CreateAsync(snapshot, token);
                visible = await Task.Run(() => content.Filter(snapshot.LineCount, include, exclude, token), token);
            }
            else
            {
                visible = await Task.Run(async () =>
                {
                    var found = new List<int>(); var i = 0;
                    await foreach (var line in snapshot.ReadLinesAsync(token))
                    {
                        token.ThrowIfCancellationRequested(); i++;
                        if ((include is null || include.IsMatch(line)) && (exclude is null || !exclude.IsMatch(line))) found.Add(i);
                    }
                    return found;
                }, token);
            }
        }
        token.ThrowIfCancellationRequested();
        _visible = visible;
        _forcedLine = 0;
        _window.Clear(); _viewRevision++;
        _lastInclude = IncludePattern; _lastExclude = ExcludePattern; _lastFilterMultiline = FilterMultiline; _lastFilterIgnoreCase = FilterIgnoreCase;
    }

    private static Regex? MakeRegex(string? pattern, bool ignoreCase, bool multiline)
        => string.IsNullOrEmpty(pattern) ? null : new Regex(pattern, (ignoreCase ? RegexOptions.IgnoreCase : RegexOptions.None) | (multiline ? RegexOptions.Multiline | RegexOptions.Singleline : RegexOptions.None), TimeSpan.FromSeconds(2));

    private async Task SearchAsync()
    {
        if (_snapshot is null) return;
        var searchVersion = _searchVersion;
        var token = BeginOperation();
        try
        {
            var snapshot = _snapshot; var query = _query; var useRegex = _regex; var multiline = _multiline; var ignoreCase = !_caseSensitive;
            var result = new List<int>(); Regex? highlight = null;
            if (!string.IsNullOrEmpty(query))
            {
                var expression = MakeRegex(useRegex ? query : Regex.Escape(query), ignoreCase, multiline)!;
                if (!multiline) highlight = expression;
                if (multiline)
                {
                    await using var content = await LogTextMap.CreateAsync(snapshot, token);
                    result = await Task.Run(() => content.Search(expression, token), token);
                }
                else
                {
                    result = await Task.Run(async () =>
                    {
                        var found = new List<int>(); var i = 0;
                        await foreach (var line in snapshot.ReadLinesAsync(token))
                        {
                            i++; token.ThrowIfCancellationRequested();
                            foreach (Match match in expression.Matches(line)) { token.ThrowIfCancellationRequested(); found.Add(i); }
                        }
                        return found;
                    }, token);
                }
            }
            token.ThrowIfCancellationRequested();
            if (searchVersion != _searchVersion) return;
            _matches = result; _matchIndex = -1; _highlightRegex = highlight;
        }
        catch (OperationCanceledException) { }
        catch (Exception ex) { _error = ex.Message; }
        finally { EndOperation(token); }
        if (searchVersion == _searchVersion && !token.IsCancellationRequested && _matches.Count > 0) await NextAsync();
    }
    [JSInvokable]
    public async Task OpenSearchAsync() { _searchOpen = true; _focusSearch = true; await InvokeAsync(StateHasChanged); }
    private async Task CloseSearchAsync() { _searchOpen = false; _searchDebounce?.Cancel(); await _viewport.FocusAsync(); }
    private async Task SearchChanged(ChangeEventArgs e)
    {
        _query = e.Value?.ToString() ?? string.Empty;
        _searchVersion++;
        _matches.Clear(); _matchIndex = -1; _highlightRegex = null;
        _searchDebounce?.Cancel(); _searchDebounce?.Dispose(); _searchDebounce = new();
        var token = _searchDebounce.Token;
        try { await Task.Delay(250, token); await SearchAsync(); } catch (OperationCanceledException) { }
    }
    private async Task ToggleCaseAsync() { _searchDebounce?.Cancel(); _caseSensitive = !_caseSensitive; await SearchAsync(); }
    private async Task ToggleRegexAsync() { _searchDebounce?.Cancel(); _regex = !_regex; await SearchAsync(); }
    private async Task ToggleMultilineAsync() { _searchDebounce?.Cancel(); _multiline = !_multiline; await SearchAsync(); }
    private async Task SearchKeyAsync(KeyboardEventArgs e) { if (e.Key == "Escape") await CloseSearchAsync(); else if (e.Key == "Enter") { _searchDebounce?.Cancel(); if (_matches.Count == 0) await SearchAsync(); else if (e.ShiftKey) await PreviousAsync(); else await NextAsync(); } }
    private async Task NextAsync() { if (_matches.Count == 0) return; _matchIndex = (_matchIndex + 1) % _matches.Count; await GoToLineAsync(_matches[_matchIndex]); }
    private async Task PreviousAsync() { if (_matches.Count == 0) return; _matchIndex = (_matchIndex <= 0 ? _matches.Count : _matchIndex) - 1; await GoToLineAsync(_matches[_matchIndex]); }

    /// <summary>Переходит к исходному номеру строки, временно показывая её при фильтрации.</summary>
    public async Task GoToLineAsync(int lineNumber)
    {
        if (_snapshot is null || lineNumber < 1 || lineNumber > _snapshot.LineCount) throw new ArgumentOutOfRangeException(nameof(lineNumber));
        var visibilityChanged = _forcedLine != 0;
        if (_forcedLine != 0) _visible.Remove(_forcedLine);
        _forcedLine = 0;
        var index = _visible.BinarySearch(lineNumber);
        if (index < 0) { index = ~index; _visible.Insert(index, lineNumber); _forcedLine = lineNumber; visibilityChanged = true; }
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/ScarnaUI/js/scarna/logviewer.js");
        if (visibilityChanged)
        {
            _window.Clear(); _viewRevision++;
            await _module.InvokeVoidAsync("reset", _viewport, _visible.Count);
            _appliedRevision = _viewRevision;
        }
        await _module.InvokeVoidAsync("goTo", _viewport, index);
        await InvokeAsync(StateHasChanged);
    }
    [JSInvokable]
    public async Task SetViewportAsync(int start, int count)
    {
        var request = ++_windowRequest;
        var revision = _viewRevision;
        var snapshot = _snapshot; var visible = _visible;
        if (snapshot is null) return;
        var lines = new List<Line>();
        var end = Math.Min(visible.Count, start + count);
        try
        {
            for (var i = start; i < end; i++) lines.Add(new Line(i, visible[i], await snapshot.ReadLineAsync(visible[i])));
        }
        catch (ObjectDisposedException) { return; }
        if (request != _windowRequest || revision != _viewRevision || !ReferenceEquals(snapshot, _snapshot) || !ReferenceEquals(visible, _visible)) return;
        _window = lines;
        await InvokeAsync(StateHasChanged);
    }
    private async Task SelectLine(MouseEventArgs e, int number)
    {
        if (e.ShiftKey && _anchorLine != 0)
        {
            var first = Math.Min(_anchorLine, number); var last = Math.Max(_anchorLine, number);
            foreach (var line in _visible) if (line >= first && line <= last) _selectedLines.Add(line);
        }
        else
        {
            if (!_selectedLines.Add(number)) _selectedLines.Remove(number);
            _anchorLine = number;
        }
        var version = ++_selectionVersion;
        var text = await GetSelectedLinesAsync();
        if (version == _selectionVersion && _module is not null)
            await _module.InvokeVoidAsync("setSelectedText", _viewport, text, version);
        await LineSelected.InvokeAsync(number);
    }
    private bool IsSelected(int number) => _selectedLines.Contains(number);
    private bool IsCurrentMatch(int number) => _matchIndex >= 0 && _matchIndex < _matches.Count && _matches[_matchIndex] == number;
    private RenderFragment HighlightLine(string text) => builder =>
    {
        if (_highlightRegex is null) { builder.AddContent(0, text); return; }
        try
        {
            var matches = _highlightRegex.Matches(text).Cast<Match>().Where(m => m.Length > 0).ToArray();
            var offset = 0;
            foreach (var match in matches)
            {
                builder.AddContent(1, text[offset..match.Index]);
                builder.OpenElement(2, "mark"); builder.AddContent(3, match.Value); builder.CloseElement();
                offset = match.Index + match.Length;
            }
            builder.AddContent(4, text[offset..]);
        }
        catch (RegexMatchTimeoutException) { builder.AddContent(5, text); }
    };
    private void OpenMenu(MouseEventArgs e, Line line) { _menu = new ScarnaLogContext(line.Number, line.Text); _menuX = e.ClientX; _menuY = e.ClientY; }
    private void CloseMenu() => _menu = null;
    private async Task CopyLineAsync() { if (_menu is not null) { _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/ScarnaUI/js/scarna/logviewer.js"); await _module.InvokeVoidAsync("copy", _menu.Text); } CloseMenu(); }
    private async Task CopySelectionAsync() { _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/ScarnaUI/js/scarna/logviewer.js"); await _module.InvokeVoidAsync("copySelection", _viewport); CloseMenu(); }
    private async Task CopySelectedLinesAsync()
    {
        var text = await GetSelectedLinesAsync();
        if (text is null) return;
        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./_content/ScarnaUI/js/scarna/logviewer.js");
        await _module.InvokeVoidAsync("copy", text); CloseMenu();
    }
    [JSInvokable]
    public async Task<string?> GetSelectedLinesAsync()
    {
        var snapshot = _snapshot;
        if (snapshot is null || _selectedLines.Count == 0) return null;
        var selected = _selectedLines.Order().ToArray();
        var builder = new StringBuilder(); var isFirst = true;
        foreach (var number in selected)
        {
            if (!isFirst) builder.AppendLine();
            builder.Append(await snapshot.ReadLineAsync(number));
            isFirst = false;
        }
        return builder.ToString();
    }
    private CancellationToken BeginOperation() { _operation?.Cancel(); _operation?.Dispose(); _operation = new(); _busy = true; _error = null; return _operation.Token; }
    private void EndOperation(CancellationToken token) { if (_operation is not null && _operation.Token == token) _busy = false; }
    private void Cancel() => _operation?.Cancel();
    public async ValueTask DisposeAsync() { _searchDebounce?.Cancel(); _searchDebounce?.Dispose(); _operation?.Cancel(); _operation?.Dispose(); if (_module is not null) try { if (_self is not null) await _module.InvokeVoidAsync("dispose", _viewport); await _module.DisposeAsync(); } catch (JSDisconnectedException) { } _self?.Dispose(); if (_snapshot is not null) await _snapshot.DisposeAsync(); }
}
