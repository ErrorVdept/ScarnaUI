@*
    Круглый аватар: изображение по Src, а если его нет/не загрузилось — инициалы.

    <ScarnaAvatar Src="/img/user.jpg" Alt="Иван Иванов" />
    <ScarnaAvatar Initials="ИИ" Color="ScarnaColor.Primary" />
*@
@namespace ScarnaUI.Components.DataDisplay
@inherits ScarnaComponentBase

<span class="@Classes" style="@Style" @attributes="UserAttributes">
    @if (!string.IsNullOrEmpty(Src) && !_imageFailed)
    {
        <img src="@Src" alt="@Alt" class="h-full w-full rounded-full object-cover" @onerror="() => _imageFailed = true" />
    }
    else if (!string.IsNullOrEmpty(Initials))
    {
        <span class="select-none font-medium">@Initials</span>
    }
    else
    {
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-3/5 w-3/5 opacity-70">
            <path d="M12 12c2.7 0 4.9-2.2 4.9-4.9S14.7 2.2 12 2.2 7.1 4.4 7.1 7.1 9.3 12 12 12Zm0 2.2c-3.3 0-9.8 1.6-9.8 4.9v2.7h19.6v-2.7c0-3.3-6.5-4.9-9.8-4.9Z" />
        </svg>
    }
</span>

@code {
    private bool _imageFailed;

    [Parameter] public string? Src { get; set; }

    [Parameter] public string? Alt { get; set; }

    /// <summary>Инициалы, показываемые вместо изображения (1-2 буквы).</summary>
    [Parameter] public string? Initials { get; set; }

    [Parameter] public ScarnaSize Size { get; set; } = ScarnaSize.Medium;

    [Parameter] public ScarnaColor Color { get; set; } = ScarnaColor.Default;

    /// <summary>Тонкая обводка по краю аватара (в цвет фона страницы — визуально отделяет от подложки).</summary>
    [Parameter] public bool Bordered { get; set; }

    private string Classes => CssBuilder.Default("scarna-avatar inline-flex items-center justify-center overflow-hidden rounded-full shrink-0")
        .AddClass(SizeClass)
        .AddClass(ScarnaColorVariantClasses.Get(Color, ScarnaVariant.Flat))
        .AddClass("ring-2 ring-background", Bordered)
        .AddClass(Class)
        .ToString();

    private string SizeClass => Size switch
    {
        ScarnaSize.Small => "size-8 text-xs",
        ScarnaSize.Large => "size-14 text-lg",
        _ => "size-10 text-sm",
    };
}
