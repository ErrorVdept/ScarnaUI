@*
    Карточка — контейнер с фоном content1, скруглением и опциональными
    заголовком/подвалом.

    <ScarnaCard>
        <HeaderContent>Заголовок</HeaderContent>
        Основное содержимое
        <FooterContent><ScarnaButton Size="Size.Small">Подробнее</ScarnaButton></FooterContent>
    </ScarnaCard>

    GlassEffect — полупрозрачный фон с блюром (тот же приём, что у ScarnaNavBar) —
    для карточек поверх фонового изображения/градиента:

    <ScarnaCard GlassEffect="true">...</ScarnaCard>

    Color меняет фон на цвет темы (Default — нейтральная поверхность bg-content1,
    Transparent — без заливки). Игнорируется, если GlassEffect="true":

    <ScarnaCard Color="Color.Primary">...</ScarnaCard>
*@
@namespace ScarnaUI.Components.DataDisplay
@inherits ScarnaComponentBase

<div class="@Classes" style="@RootStyle" @attributes="UserAttributes">
    @if (HeaderContent is not null)
    {
        <div class="scarna-card__header px-5 py-4 border-b border-divider">@HeaderContent</div>
    }
    <div class="scarna-card__body flex-1 px-5 py-4">@ChildContent</div>
    @if (FooterContent is not null)
    {
        <div class="scarna-card__footer px-5 py-4 border-t border-divider">@FooterContent</div>
    }
</div>

@code {
    /// <summary>Рисовать ли тонкую рамку (в дополнение к тени).</summary>
    [Parameter] public bool Bordered { get; set; }

    /// <summary>Тень под карточкой.</summary>
    [Parameter] public bool Shadow { get; set; } = true;

    [Parameter] public Radius Radius { get; set; } = Radius.Large;

    /// <summary>Полупрозрачный фон с блюром (backdrop-blur) вместо сплошного bg-content1 — как у ScarnaNavBar.</summary>
    [Parameter] public bool GlassEffect { get; set; }

    /// <summary>Фон карточки. Default (по умолчанию) — нейтральная поверхность темы (bg-content1); Transparent — без заливки. Игнорируется при GlassEffect="true".</summary>
    [Parameter] public Color Color { get; set; } = Color.Default;

    [Parameter] public RenderFragment? HeaderContent { get; set; }

    [Parameter] public RenderFragment? FooterContent { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    // text-foreground — только когда Surface() не задаёт свой text-* (Default/Transparent/
    // GlassEffect) — иначе одновременно присутствовали бы два конкурирующих text-*
    // класса (text-foreground и, например, text-primary-foreground), и какой из них
    // победит, зависело бы от порядка правил в сгенерированном Tailwind CSS, а не от
    // того, что здесь написано (тот же нюанс, что и с gap в getting-started.md).
    private bool HasNeutralText => GlassEffect || Color is Color.Default or Color.Transparent;

    private string Classes => CssBuilder.Default("scarna-card flex flex-col overflow-hidden")
        .AddClass("text-foreground", HasNeutralText)
        .AddClass("bg-content1/80 backdrop-blur-md", GlassEffect)
        .AddClass(ScarnaColorVariantClasses.Surface(Color), !GlassEffect)
        .AddClass(ScarnaColorVariantClasses.Radius(Radius))
        .AddClass("border border-divider", Bordered)
        .AddClass("shadow-md", Shadow)
        .AddClass(Class)
        .ToString();
}
