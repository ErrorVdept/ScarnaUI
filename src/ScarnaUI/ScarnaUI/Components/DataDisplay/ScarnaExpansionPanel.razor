@*
    Сворачиваемая панель (аккордеон-секция). Каждая панель независима — если нужно,
    чтобы одновременно была открыта только одна, держите Expanded во внешнем состоянии
    (например, храните "какая панель открыта" в родительском компоненте и биндите).

    <ScarnaExpansionPanel Title="Доставка">
        Бесплатно при заказе от 3000 ₽.
    </ScarnaExpansionPanel>

    Высота анимируется CSS grid-template-rows-трюком (0fr → 1fr) — плавно, без замера
    высоты через JS.
*@
@namespace ScarnaUI.Components.DataDisplay
@inherits ScarnaComponentBase

<div class="@WrapperClasses" style="@Style" @attributes="UserAttributes">
    <button type="button" class="flex w-full items-center justify-between gap-3 px-4 py-3 text-left" @onclick="ToggleAsync" aria-expanded="@Expanded">
        @if (TitleContent is not null)
        {
            @TitleContent
        }
        else
        {
            <span class="font-medium text-foreground">@Title</span>
        }
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
             class="@($"shrink-0 text-foreground/50 transition-transform duration-200 {(Expanded ? "rotate-180" : "")}")">
            <polyline points="6 9 12 15 18 9" />
        </svg>
    </button>
    <div class="grid transition-[grid-template-rows] duration-200 ease-out" style="@($"grid-template-rows: {(Expanded ? "1fr" : "0fr")};")">
        <div class="overflow-hidden">
            <div class="px-4 pb-4 text-sm text-foreground/80">
                @ChildContent
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public string? Title { get; set; }

    [Parameter] public RenderFragment? TitleContent { get; set; }

    /// <summary>Развёрнута ли панель. Поддерживает @bind-Expanded.</summary>
    [Parameter] public bool Expanded { get; set; }

    [Parameter] public EventCallback<bool> ExpandedChanged { get; set; }

    [Parameter] public bool Bordered { get; set; } = true;

    [Parameter] public RenderFragment? ChildContent { get; set; }

    private async Task ToggleAsync()
    {
        Expanded = !Expanded;

        if (ExpandedChanged.HasDelegate)
        {
            await ExpandedChanged.InvokeAsync(Expanded);
        }
    }

    private string WrapperClasses => CssBuilder.Default("scarna-expansion-panel overflow-hidden rounded-scarna-md bg-content1")
        .AddClass("border border-divider", Bordered)
        .AddClass(Class)
        .ToString();
}
