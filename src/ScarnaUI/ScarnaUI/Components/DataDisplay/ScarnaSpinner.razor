@*
    Индикатор загрузки — вращающееся кольцо (indeterminate). Для линейного прогресса
    с конкретным значением см. ScarnaProgress.

    <ScarnaSpinner />
    <ScarnaSpinner Color="ScarnaColor.Success" Size="ScarnaSize.Large" />
*@
@namespace ScarnaUI.Components.DataDisplay
@inherits ScarnaComponentBase

<svg class="@Classes" style="@Style" viewBox="0 0 24 24" fill="none" role="status" aria-label="@Label" @attributes="UserAttributes">
    <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3" class="opacity-20" />
    <path d="M12 2 a10 10 0 0 1 10 10" stroke="currentColor" stroke-width="3" stroke-linecap="round" />
</svg>

@code {
    [Parameter] public ScarnaColor Color { get; set; } = ScarnaColor.Primary;

    [Parameter] public ScarnaSize Size { get; set; } = ScarnaSize.Medium;

    /// <summary>Текст для скринридеров (визуально не отображается).</summary>
    [Parameter] public string Label { get; set; } = "Загрузка";

    private string Classes => CssBuilder.Default("scarna-spinner animate-spin")
        .AddClass(SizeClass)
        .AddClass(ColorClass)
        .AddClass(Class)
        .ToString();

    private string SizeClass => Size switch
    {
        ScarnaSize.Small => "size-4",
        ScarnaSize.Large => "size-8",
        _ => "size-6",
    };

    private string ColorClass => Color switch
    {
        ScarnaColor.Secondary => "text-secondary",
        ScarnaColor.Success => "text-success",
        ScarnaColor.Warning => "text-warning",
        ScarnaColor.Danger => "text-danger",
        ScarnaColor.Default => "text-foreground/60",
        _ => "text-primary",
    };
}
