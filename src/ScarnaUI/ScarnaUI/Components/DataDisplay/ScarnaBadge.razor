@*
    Индикатор-оверлей поверх произвольного содержимого (аватара, иконки) — счётчик
    непрочитанных сообщений, точка "онлайн" и т.п. Не путать с ScarnaChip (тот — самостоятельная метка).

    <ScarnaBadge Content="3">
        <ScarnaAvatar Initials="ИИ" />
    </ScarnaBadge>
*@
@namespace ScarnaUI.Components.DataDisplay
@inherits ScarnaComponentBase

<span class="scarna-badge-anchor relative inline-flex" style="@Style" @attributes="UserAttributes">
    @ChildContent
    @if (Visible)
    {
        <span class="@BadgeClasses">
            @if (!Dot)
            {
                @Content
            }
        </span>
    }
</span>

@code {
    [Parameter] public ScarnaColor Color { get; set; } = ScarnaColor.Danger;

    /// <summary>Содержимое значка (число, короткий текст). Игнорируется, если Dot = true.</summary>
    [Parameter] public string? Content { get; set; }

    /// <summary>Показать вместо содержимого маленькую точку (индикатор "есть событие" без числа).</summary>
    [Parameter] public bool Dot { get; set; }

    /// <summary>Управляет видимостью значка целиком (удобно скрывать при Content == 0).</summary>
    [Parameter] public bool Visible { get; set; } = true;

    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Обводка значка в цвет фона страницы — отделяет его от того, что под ним (по умолчанию включена).</summary>
    [Parameter] public bool Bordered { get; set; } = true;

    private string BadgeClasses => CssBuilder.Default("absolute flex items-center justify-center rounded-full font-semibold")
        .AddClass("ring-2 ring-background", Bordered)
        .AddClass("top-0 right-0 size-2.5 -translate-y-1/4 translate-x-1/4", Dot)
        .AddClass("-top-1 -right-1 min-w-[18px] h-[18px] px-1 text-[10px] -translate-y-0 translate-x-0", !Dot)
        .AddClass(ScarnaColorVariantClasses.Get(Color, ScarnaVariant.Solid))
        .ToString();
}
