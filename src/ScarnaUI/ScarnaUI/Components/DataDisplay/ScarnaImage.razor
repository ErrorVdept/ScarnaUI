@*
    Обёртка над <img> со скруглением, обводкой и запасным содержимым при ошибке загрузки.

    <ScarnaImage Src="/img/cover.jpg" Alt="Обложка" Radius="Radius.Large" />

    Base64: можно передать готовый data:-URI прямо в Src (работает "из коробки" —
    это обычный HTML-атрибут src), либо, если под рукой только сырой base64 без
    префикса, задать MimeType — компонент сам соберёт data:-URI:

    <ScarnaImage Src="@rawBase64" MimeType="image/png" />
*@
@namespace ScarnaUI.Components.DataDisplay
@inherits ScarnaComponentBase

<div class="@WrapperClasses" style="@RootStyle" @attributes="UserAttributes">
    @if (!_failed)
    {
        <img src="@ResolvedSrc" alt="@Alt" loading="@(Lazy ? "lazy" : "eager")"
             class="h-full w-full object-cover"
             @onerror="() => _failed = true" />
    }
    else if (Fallback is not null)
    {
        @Fallback
    }
    else
    {
        <div class="flex h-full w-full items-center justify-center bg-content2 text-foreground/30">
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="3" width="18" height="18" rx="2" />
                <circle cx="9" cy="9" r="2" />
                <path d="M21 15l-5-5L5 21" />
            </svg>
        </div>
    }
</div>

@code {
    private bool _failed;

    [Parameter, EditorRequired] public string Src { get; set; } = string.Empty;

    /// <summary>MIME-тип (например, "image/png"), если Src — сырой base64 без префикса "data:...;base64,". Компонент сам соберёт data:-URI. Если Src уже полноценный URL/data:-URI — не задавайте.</summary>
    [Parameter] public string? MimeType { get; set; }

    [Parameter] public string? Alt { get; set; }

    [Parameter] public Radius Radius { get; set; } = Radius.Large;

    [Parameter] public bool Bordered { get; set; }

    /// <summary>Отложенная загрузка через нативный атрибут loading="lazy" (по умолчанию включена).</summary>
    [Parameter] public bool Lazy { get; set; } = true;

    /// <summary>Содержимое, показываемое вместо изображения, если оно не загрузилось.</summary>
    [Parameter] public RenderFragment? Fallback { get; set; }

    private string ResolvedSrc => string.IsNullOrEmpty(MimeType) ? Src : $"data:{MimeType};base64,{Src}";

    private string WrapperClasses => CssBuilder.Default("scarna-image overflow-hidden bg-content2")
        .AddClass(ScarnaColorVariantClasses.Radius(Radius))
        .AddClass("border border-divider", Bordered)
        .AddClass(Class)
        .ToString();
}
