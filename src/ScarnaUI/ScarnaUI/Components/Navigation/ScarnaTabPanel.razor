@*
    Одна вкладка внутри ScarnaTabs. Сама панель не рисует заголовок — заголовок
    (кнопку с Text) рисует ScarnaTabs, а здесь только содержимое, которое видно,
    когда вкладка активна.
*@
@namespace ScarnaUI.Components.Navigation
@implements IDisposable

@if (IsActive)
{
    <div class="scarna-tab-panel">
        @ChildContent
    </div>
}

@code {
    [CascadingParameter] private ScarnaTabs? Parent { get; set; }

    /// <summary>Текст заголовка вкладки.</summary>
    [Parameter, EditorRequired] public string Text { get; set; } = string.Empty;

    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool IsActive => Parent?.IsSelected(this) ?? false;

    protected override void OnInitialized()
    {
        if (Parent is null)
        {
            throw new InvalidOperationException("ScarnaTabPanel должен использоваться внутри ScarnaTabs.");
        }

        Parent.Register(this);
    }

    public void Dispose() => Parent?.Unregister(this);
}
