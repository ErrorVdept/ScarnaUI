@*
    Группа с одиночным выбором — тот же функционал, что у ScarnaSelect (@bind-Value,
    список пунктов), но без выпадающего списка: все варианты видны сразу, оформлены
    как ScarnaTabs (pill-индикатор плавно едет между кнопками). Хорош для короткого
    списка из 2-5 вариантов (переключатель периода, единицы измерения и т.п.) —
    для длинных списков используйте ScarnaSelect.

    <ScarnaSelectGroup Label="Период" @bind-Value="_period">
        <ScarnaSelectGroupItem Value="@("day")" Text="День" />
        <ScarnaSelectGroupItem Value="@("week")" Text="Неделя" />
        <ScarnaSelectGroupItem Value="@("month")" Text="Месяц" />
    </ScarnaSelectGroup>
*@
@namespace ScarnaUI.Components.Forms
@typeparam TValue
@inherits ScarnaFormComponentBase<TValue>
@attribute [CascadingTypeParameter(nameof(TValue))]
@implements IAsyncDisposable
@inject IJSRuntime JSRuntime

<div class="@WrapperClasses" style="@RootStyle" @attributes="UserAttributes">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="text-sm font-medium text-foreground/80">@Label</label>
    }
    <div @ref="_trackElement" class="@TrackClasses">
        <span class="scarna-tabs__indicator absolute inset-y-1 left-0 rounded-scarna-full bg-content1 shadow-md transition-[transform,width] duration-200 ease-out" style="width:0"></span>
        <CascadingValue Value="this" IsFixed="false">
            @ChildContent
        </CascadingValue>
    </div>
</div>

@code {
    private const string ModulePath = "./_content/ScarnaUI/js/scarna/tabs.js";

    private readonly List<ScarnaSelectGroupItem<TValue>> _items = new();
    private ElementReference _trackElement;
    private IJSObjectReference? _module;

    [Parameter] public string? Label { get; set; }

    /// <summary>Набор `<ScarnaSelectGroupItem>`.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>К какому краю прижимать кнопки вдоль дорожки — как AlignItems в MudBlazor (здесь это justify-content, т.к. поперечная ось и так центрирована). Заметно, только если FullWidth="false".</summary>
    [Parameter] public Justify Justify { get; set; } = Justify.Start;

    /// <summary>Растянуть кнопки на всю ширину родителя поровну, вместо ширины по содержимому.</summary>
    [Parameter] public bool FullWidth { get; set; }

    internal bool IsSelected(ScarnaSelectGroupItem<TValue> item) => EqualityComparer<TValue>.Default.Equals(item.Value, Value);

    internal void Register(ScarnaSelectGroupItem<TValue> item)
    {
        if (!_items.Contains(item))
        {
            _items.Add(item);
            StateHasChanged();
        }
    }

    internal void Unregister(ScarnaSelectGroupItem<TValue> item)
    {
        if (_items.Remove(item))
        {
            StateHasChanged();
        }
    }

    internal async Task SelectAsync(TValue value)
    {
        // Клик приходит из дочернего ScarnaSelectGroupItem — Blazor автоматически
        // перерисовывает компонент, чей обработчик сработал (Item), но НЕ его родителя
        // (эту группу). SetValueAsync сама по себе не запрашивает перерисовку (она
        // рассчитана на вызов из обработчика СВОЕГО ЖЕ компонента, как в ScarnaInput),
        // поэтому без явного StateHasChanged соседние пункты не узнают, что выбор сменился.
        await SetValueAsync(value);
        await InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        _module ??= await JSRuntime.InvokeAsync<IJSObjectReference>("import", ModulePath);
        await _module.InvokeVoidAsync("syncIndicator", _trackElement);
    }

    private string WrapperClasses => CssBuilder.Default("scarna-select-group flex flex-col gap-1").AddClass(Class).ToString();

    // Ровно один из flex/inline-flex — см. такой же комментарий в ScarnaTabs.TrackClasses.
    private string TrackClasses => CssBuilder.Default("scarna-select-group__track relative items-center gap-1 rounded-scarna-full bg-content2 p-1")
        .AddClass("flex w-full", FullWidth)
        .AddClass("inline-flex", !FullWidth)
        .AddClass("[&>button]:flex-1", FullWidth)
        .AddClass(JustifyClass)
        .ToString();

    private string JustifyClass => Justify switch
    {
        Justify.End => "justify-end",
        Justify.Center => "justify-center",
        Justify.SpaceBetween => "justify-between",
        Justify.SpaceAround => "justify-around",
        Justify.SpaceEvenly => "justify-evenly",
        _ => "justify-start",
    };

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // circuit уже закрыт — освобождать нечего
            }
        }
    }
}
