@*
    Выпадающий список с одиночным выбором. Построен на ScarnaPopover (см. docmd/popover.md)
    и ScarnaFormComponentBase — поддерживает @bind-Value как любое другое поле формы.
    Требует ScarnaPopoverProvider в дереве выше.

    <ScarnaSelect Label="Страна" @bind-Value="model.CountryCode" Placeholder="Выберите страну">
        <ScarnaSelectItem Value="@("ru")" Text="Россия" />
        <ScarnaSelectItem Value="@("kz")" Text="Казахстан" />
        <ScarnaSelectItem Value="@("by")" Text="Беларусь" />
    </ScarnaSelect>

    TValue выводится автоматически из типа Value у ScarnaSelectItem (см. CascadingTypeParameter) —
    явно указывать `TValue="string"` обычно не нужно.
*@
@namespace ScarnaUI.Components.Forms
@typeparam TValue
@inherits ScarnaFormComponentBase<TValue>
@attribute [CascadingTypeParameter(nameof(TValue))]

<div class="@WrapperOuterClasses" style="@Style" @attributes="UserAttributes">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="text-sm font-medium text-foreground/80">@Label</label>
    }

    <div @ref="_anchor" class="@FieldWrapperClasses" aria-readonly="@ReadOnly" @onclick="ToggleAsync">
        <span class="@(SelectedLabel is null ? "flex-1 truncate text-foreground/40" : "flex-1 truncate")">
            @(SelectedLabel ?? Placeholder)
        </span>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
             class="@($"shrink-0 text-foreground/50 transition-transform {(_open ? "rotate-180" : "")}")">
            <polyline points="6 9 12 15 18 9" />
        </svg>
    </div>

    @if (IsInvalid && !string.IsNullOrEmpty(ErrorText))
    {
        <span class="text-xs text-danger">@ErrorText</span>
    }
    else if (!string.IsNullOrEmpty(HelperText))
    {
        <span class="text-xs text-foreground/50">@HelperText</span>
    }
</div>

<ScarnaPopover Open="_open" Anchor="_anchor" Position="Position" IsParentFullSize="IsParentFullSize"
              OffsetPx="4" OnClose="CloseAsync" SurfaceClass="min-w-[220px]">
    <div class="scarna-select-menu max-h-64 overflow-y-auto rounded-scarna-md border border-divider bg-content1 p-1 shadow-lg" role="listbox">
        <CascadingValue Value="this" IsFixed="false">
            @ChildContent
        </CascadingValue>
    </div>
</ScarnaPopover>

@code {
    private readonly List<ScarnaSelectItem<TValue>> _items = new();
    private ElementReference _anchor;
    private bool _open;

    [Parameter] public string? Label { get; set; }

    [Parameter] public string? Placeholder { get; set; } = "Выберите...";

    [Parameter] public string? HelperText { get; set; }

    /// <summary>Запрещает открытие списка (клик по полю игнорируется), но, в отличие от Disabled, поле визуально не тускнеет.</summary>
    [Parameter] public bool ReadOnly { get; set; }

    [Parameter] public ScarnaVariant Variant { get; set; } = ScarnaVariant.Bordered;

    /// <summary>Показывать ли контур поля (по умолчанию — да), независимо от Variant.</summary>
    [Parameter] public bool Bordered { get; set; } = true;

    [Parameter] public ScarnaSize Size { get; set; } = ScarnaSize.Medium;

    [Parameter] public ScarnaDensity Density { get; set; } = ScarnaDensity.Normal;

    [Parameter] public ScarnaRadius Radius { get; set; } = ScarnaRadius.Medium;

    /// <summary>Позиция выпадающего списка относительно поля.</summary>
    [Parameter] public ScarnaPosition Position { get; set; } = ScarnaPosition.BottomStart;

    /// <summary>Растянуть выпадающий список на ширину поля (не уже него — см. min-w-[220px] на самой поверхности).</summary>
    [Parameter] public bool IsParentFullSize { get; set; } = true;

    /// <summary>Набор `<ScarnaSelectItem>`.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    // Текст выбранного пункта кэшируется отдельно, а не ищется каждый раз в _items:
    // ScarnaPopover физически размонтирует своё содержимое (а значит и все ScarnaSelectItem)
    // сразу после закрытия — к моменту, когда нужно отрисовать закрытое поле с подписью,
    // _items уже пуст. Кэш обновляется и при явном выборе (SelectAsync), и при повторном
    // открытии — Register сверяет уже установленный Value с только что смонтированными пунктами.
    private string? _selectedLabel;

    private string? SelectedLabel => _selectedLabel;

    internal void Register(ScarnaSelectItem<TValue> item)
    {
        if (!_items.Contains(item))
        {
            _items.Add(item);

            if (EqualityComparer<TValue>.Default.Equals(item.Value, Value))
            {
                _selectedLabel = item.Text;
            }

            StateHasChanged();
        }
    }

    internal void Unregister(ScarnaSelectItem<TValue> item)
    {
        if (_items.Remove(item))
        {
            StateHasChanged();
        }
    }

    internal async Task SelectAsync(TValue value, string text)
    {
        _selectedLabel = text;
        await SetValueAsync(value);
        await CloseAsync();
    }

    private Task ToggleAsync()
    {
        if (ReadOnly)
        {
            return Task.CompletedTask;
        }

        _open = !_open;
        return Task.CompletedTask;
    }

    internal Task CloseAsync()
    {
        _open = false;
        return InvokeAsync(StateHasChanged);
    }

    private string WrapperOuterClasses => CssBuilder.Default("scarna-select-wrapper flex flex-col gap-1")
        .AddClass(Class)
        .ToString();

    private string FieldWrapperClasses => CssBuilder.Default("scarna-select flex cursor-pointer select-none items-center gap-2 transition-colors")
        .AddClass(SizeClass)
        .AddClass(ScarnaColorVariantClasses.Radius(Radius))
        .AddClass(VariantClass)
        .AddClass("ring-1 ring-danger", IsInvalid)
        .ToString();

    private string SizeClass => (Size, Density) switch
    {
        (ScarnaSize.Small, ScarnaDensity.Dense) => "h-7 px-2 text-sm",
        (ScarnaSize.Small, _) => "h-8 px-3 text-sm",
        (ScarnaSize.Large, ScarnaDensity.Dense) => "h-10 px-3 text-base",
        (ScarnaSize.Large, _) => "h-12 px-4 text-base",
        (_, ScarnaDensity.Dense) => "h-8 px-2.5 text-sm",
        _ => "h-10 px-3 text-sm",
    };

    private string VariantClass => (Variant, Bordered) switch
    {
        (ScarnaVariant.Flat, true) => "bg-content2 border border-default",
        (ScarnaVariant.Flat, false) => "bg-content2 border border-transparent",
        (_, true) => "bg-transparent border border-default",
        (_, false) => "bg-transparent border border-transparent",
    };
}
