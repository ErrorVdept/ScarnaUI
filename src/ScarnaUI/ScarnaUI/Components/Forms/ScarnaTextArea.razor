@*
    Многострочное текстовое поле. То же самое, что ScarnaInput, но <textarea>
    вместо <input> — для комментариев, описаний, произвольного текста.

    <ScarnaTextArea Label="Описание" @bind-Value="model.Description" Rows="4" />
*@
@namespace ScarnaUI.Components.Forms
@inherits ScarnaFormComponentBase<string>

<div class="@WrapperOuterClasses" style="@Style" @attributes="UserAttributes">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label for="@_id" class="text-sm font-medium text-foreground/80">@Label</label>
    }

    <div class="@FieldWrapperClasses">
        <textarea id="@_id"
                  class="scarna-textarea__field w-full flex-1 resize-none bg-transparent outline-none text-foreground placeholder:text-foreground/40 disabled:cursor-not-allowed"
                  style="@(AutoResize ? "field-sizing: content;" : null)"
                  placeholder="@Placeholder"
                  rows="@Rows"
                  disabled="@Disabled"
                  readonly="@ReadOnly"
                  @oninput="HandleInputAsync">@Value</textarea>
    </div>

    @if (IsInvalid && !string.IsNullOrEmpty(ErrorText))
    {
        <span class="text-xs text-danger">@ErrorText</span>
    }
    else if (!string.IsNullOrEmpty(HelperText))
    {
        <span class="text-xs text-foreground/50">@HelperText</span>
    }
</div>

@code {
    private readonly string _id = $"scarna-textarea-{Guid.NewGuid():N}";

    [Parameter] public string? Label { get; set; }

    [Parameter] public string? Placeholder { get; set; }

    [Parameter] public string? HelperText { get; set; }

    /// <summary>Количество видимых строк (влияет только на начальную высоту, если AutoResize выключен).</summary>
    [Parameter] public int Rows { get; set; } = 3;

    /// <summary>Автоматически расти по высоте вслед за содержимым (CSS field-sizing, современные Chromium/Edge; в остальных браузерах остаётся Rows).</summary>
    [Parameter] public bool AutoResize { get; set; }

    [Parameter] public bool Disabled { get; set; }

    [Parameter] public bool ReadOnly { get; set; }

    [Parameter] public Variant Variant { get; set; } = Variant.Bordered;

    [Parameter] public bool Bordered { get; set; } = true;

    [Parameter] public Radius Radius { get; set; } = Radius.Medium;

    private async Task HandleInputAsync(ChangeEventArgs e) => await SetValueAsync(e.Value?.ToString());

    private string WrapperOuterClasses => CssBuilder.Default("scarna-textarea-wrapper flex flex-col gap-1")
        .AddClass(Class)
        .ToString();

    private string FieldWrapperClasses => CssBuilder.Default("scarna-textarea flex items-start px-3 py-2 text-sm transition-colors")
        .AddClass(ScarnaColorVariantClasses.Radius(Radius))
        .AddClass(VariantClass)
        .AddClass("ring-1 ring-danger", IsInvalid)
        .ToString();

    private string VariantClass => (Variant, Bordered) switch
    {
        (Variant.Flat, true) => "bg-content2 border border-default focus-within:border-primary",
        (Variant.Flat, false) => "bg-content2 border border-transparent focus-within:bg-content3",
        (_, true) => "bg-transparent border border-default focus-within:border-primary",
        (_, false) => "bg-transparent border border-transparent",
    };
}
