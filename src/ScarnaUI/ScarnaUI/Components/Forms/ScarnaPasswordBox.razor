@*
    Текстовое поле пароля с переключаемым отображением и настраиваемым символом маски
    (по умолчанию "*"). Не использует нативный input[type=password] для скрытого
    состояния — браузер сам решает, каким символом рисовать маску (обычно точка),
    и это никак не настроить через CSS/атрибуты. Вместо этого поле всегда type="text",
    а маскированием (подменой отображаемой строки на MaskChar × длина) занимается сам
    компонент: реальное значение живёт в Value, наружу в DOM идёт замаскированная строка.

    Раз браузер не знает реальных символов, при вводе/удалении нужно самим понять, что
    именно изменилось — ReconcileMasked ниже сравнивает новую отображаемую строку со
    старой маской: длина не изменилась => заменили один символ на позиции первого
    расхождения; выросла => там же произошла вставка; уменьшилась => там же удаление.
    Как следствие, только что введённый символ на миг виден как есть до следующего
    рендера (после которого он тоже маскируется) — это норма для такого подхода и даже
    привычно пользователю (многие мобильные клавиатуры делают ровно то же самое).

    <ScarnaPasswordBox Label="Пароль" @bind-Value="model.Password" />
    <ScarnaPasswordBox Label="PIN" @bind-Value="model.Pin" MaskChar="'•'" />
*@
@namespace ScarnaUI.Components.Forms
@inherits ScarnaFormComponentBase<string>

<div class="@WrapperOuterClasses" style="@Style" @attributes="UserAttributes">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label for="@_id" class="text-sm font-medium text-foreground/80">@Label</label>
    }

    <div class="@FieldWrapperClasses">
        <input id="@_id"
               type="text"
               autocomplete="@(Visible ? "off" : "current-password")"
               class="scarna-passwordbox__field w-full flex-1 bg-transparent outline-none text-foreground placeholder:text-foreground/40 disabled:cursor-not-allowed"
               placeholder="@Placeholder"
               value="@DisplayValue"
               disabled="@Disabled"
               readonly="@ReadOnly"
               @oninput="HandleInputAsync" />
        @if (ShowToggle)
        {
            <button type="button" class="scarna-passwordbox__toggle shrink-0 text-foreground/50 transition-colors hover:text-foreground disabled:pointer-events-none"
                    disabled="@(Disabled || ReadOnly)" @onclick="() => Visible = !Visible" tabindex="-1" aria-label="@(Visible ? "Скрыть пароль" : "Показать пароль")">
                @if (Visible)
                {
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M17.94 17.94A10.94 10.94 0 0 1 12 20c-7 0-11-8-11-8a21.8 21.8 0 0 1 5.06-6.06M9.9 4.24A10.94 10.94 0 0 1 12 4c7 0 11 8 11 8a21.8 21.8 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24" />
                        <line x1="1" y1="1" x2="23" y2="23" />
                    </svg>
                }
                else
                {
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8Z" />
                        <circle cx="12" cy="12" r="3" />
                    </svg>
                }
            </button>
        }
    </div>

    @if (IsInvalid && !string.IsNullOrEmpty(ErrorText))
    {
        <span class="text-xs text-danger">@ErrorText</span>
    }
    else if (!string.IsNullOrEmpty(HelperText))
    {
        <span class="text-xs text-foreground/50">@HelperText</span>
    }
</div>

@code {
    private readonly string _id = $"scarna-passwordbox-{Guid.NewGuid():N}";

    [Parameter] public string? Label { get; set; }

    [Parameter] public string? Placeholder { get; set; }

    [Parameter] public string? HelperText { get; set; }

    /// <summary>Символ, которым маскируется значение, пока пароль скрыт.</summary>
    [Parameter] public char MaskChar { get; set; } = '*';

    /// <summary>Показывать ли кнопку-глазок переключения видимости.</summary>
    [Parameter] public bool ShowToggle { get; set; } = true;

    [Parameter] public bool Disabled { get; set; }

    [Parameter] public bool ReadOnly { get; set; }

    [Parameter] public ScarnaVariant Variant { get; set; } = ScarnaVariant.Bordered;

    [Parameter] public bool Bordered { get; set; } = true;

    [Parameter] public ScarnaSize Size { get; set; } = ScarnaSize.Medium;

    [Parameter] public ScarnaDensity Density { get; set; } = ScarnaDensity.Normal;

    [Parameter] public ScarnaRadius Radius { get; set; } = ScarnaRadius.Medium;

    private bool Visible { get; set; }

    private string DisplayValue => Visible ? (Value ?? string.Empty) : new string(MaskChar, (Value ?? string.Empty).Length);

    private async Task HandleInputAsync(ChangeEventArgs e)
    {
        var newDisplayed = e.Value?.ToString() ?? string.Empty;

        if (Visible)
        {
            await SetValueAsync(newDisplayed);
            return;
        }

        var oldRaw = Value ?? string.Empty;
        var oldMasked = new string(MaskChar, oldRaw.Length);
        await SetValueAsync(ReconcileMasked(oldRaw, oldMasked, newDisplayed));
    }

    /// <summary>
    /// Восстанавливает реальное значение по новой отображаемой (замаскированной) строке,
    /// сравнивая её со старой маской того же символа — см. комментарий к компоненту выше.
    /// </summary>
    private static string ReconcileMasked(string oldRaw, string oldMasked, string newDisplayed)
    {
        var oldLen = oldMasked.Length;
        var newLen = newDisplayed.Length;

        if (newLen == oldLen)
        {
            for (var i = 0; i < newLen; i++)
            {
                if (newDisplayed[i] != oldMasked[i])
                {
                    var raw = oldRaw.ToCharArray();
                    raw[i] = newDisplayed[i];
                    return new string(raw);
                }
            }

            return oldRaw;
        }

        var prefixLen = 0;
        var maxPrefix = Math.Min(oldLen, newLen);
        while (prefixLen < maxPrefix && newDisplayed[prefixLen] == oldMasked[prefixLen])
        {
            prefixLen++;
        }

        if (newLen > oldLen)
        {
            var insertLen = newLen - oldLen;
            var start = Math.Min(prefixLen, newLen - insertLen);
            var inserted = newDisplayed.Substring(start, insertLen);
            return oldRaw.Insert(Math.Clamp(start, 0, oldRaw.Length), inserted);
        }

        var deleteLen = oldLen - newLen;
        var index = Math.Clamp(prefixLen, 0, oldRaw.Length - deleteLen);
        return oldRaw.Remove(index, deleteLen);
    }

    private string WrapperOuterClasses => CssBuilder.Default("scarna-passwordbox-wrapper flex flex-col gap-1")
        .AddClass(Class)
        .ToString();

    private string FieldWrapperClasses => CssBuilder.Default("scarna-passwordbox flex items-center gap-2 transition-colors")
        .AddClass(SizeClass)
        .AddClass(ScarnaColorVariantClasses.Radius(Radius))
        .AddClass(VariantClass)
        .AddClass("ring-1 ring-danger", IsInvalid)
        .ToString();

    private string SizeClass => (Size, Density) switch
    {
        (ScarnaSize.Small, ScarnaDensity.Dense) => "h-7 px-2 text-sm",
        (ScarnaSize.Small, _) => "h-8 px-3 text-sm",
        (ScarnaSize.Large, ScarnaDensity.Dense) => "h-10 px-3 text-base",
        (ScarnaSize.Large, _) => "h-12 px-4 text-base",
        (_, ScarnaDensity.Dense) => "h-8 px-2.5 text-sm",
        _ => "h-10 px-3 text-sm",
    };

    private string VariantClass => (Variant, Bordered) switch
    {
        (ScarnaVariant.Flat, true) => "bg-content2 border border-default focus-within:border-primary",
        (ScarnaVariant.Flat, false) => "bg-content2 border border-transparent focus-within:bg-content3",
        (_, true) => "bg-transparent border border-default focus-within:border-primary",
        (_, false) => "bg-transparent border border-transparent",
    };
}
