@*
    Слайдер числового значения. Под капотом — нативный <input type="range">
    (бесплатно даёт клавиатуру, touch, доступность). Дорожка стилизуется через
    Tailwind-классы + инлайн-градиент (заливка слева от ползунка), а сам ползунок —
    через отдельный рукописный CSS-блок на ::-webkit-slider-thumb/::-moz-range-thumb
    в Styles/input.css (класс .scarna-slider) — см. комментарий там: россыпь мелких
    Tailwind arbitrary-variant классов на этот вендорный псевдоэлемент применялась
    ненадёжно (часть свойств браузер просто не подхватывал), один консолидированный
    блок обычного CSS — куда надёжнее.

    <ScarnaSlider Label="Громкость" @bind-Value="_volume" Min="0" Max="100" ShowValue="true" />
*@
@namespace ScarnaUI.Components.Forms
@inherits ScarnaFormComponentBase<double>
@implements IAsyncDisposable
@inject IJSRuntime JSRuntime

<div class="scarna-slider-wrapper flex flex-col gap-2" style="@RootStyle" @attributes="UserAttributes">
    @if (!string.IsNullOrEmpty(Label) || ShowValue)
    {
        <div class="flex items-center justify-between text-sm">
            @if (!string.IsNullOrEmpty(Label))
            {
                <span class="font-medium text-foreground/80">@Label</span>
            }
            @if (ShowValue)
            {
                <span class="text-foreground/60">@Value.ToString(Format, System.Globalization.CultureInfo.InvariantCulture)</span>
            }
        </div>
    }
    <input type="range"
           min="@Min.ToString(System.Globalization.CultureInfo.InvariantCulture)"
           max="@Max.ToString(System.Globalization.CultureInfo.InvariantCulture)"
           step="@Step.ToString(System.Globalization.CultureInfo.InvariantCulture)"
           value="@Value.ToString(System.Globalization.CultureInfo.InvariantCulture)"
           disabled="@Disabled"
           class="@InputClasses"
           style="@TrackStyle"
           aria-readonly="@ReadOnly"
           @ref="_inputRef"
           @oninput="HandleInputAsync" />
</div>

@code {
    [Parameter] public string? Label { get; set; }

    [Parameter] public double Min { get; set; }

    [Parameter] public double Max { get; set; } = 100;

    [Parameter] public double Step { get; set; } = 1;

    [Parameter] public bool Disabled { get; set; }

    /// <summary>
    /// HTML-атрибут readonly не поддерживается input[type=range] браузерами (в отличие
    /// от текстовых полей) — поэтому здесь ReadOnly реализован вручную: изменения
    /// игнорируются в HandleInputAsync, а pointer-events:none блокирует перетаскивание
    /// ползунка мышью/тачем. В отличие от Disabled, поле не тускнеет — визуально это
    /// обычный слайдер, просто не реагирующий на ввод.
    /// </summary>
    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>Показывать текущее значение справа от подписи.</summary>
    [Parameter] public bool ShowValue { get; set; }

    /// <summary>Формат числа для ShowValue (стандартный .NET numeric format string).</summary>
    [Parameter] public string Format { get; set; } = "0.##";

    [Parameter] public Color Color { get; set; } = Color.Primary;

    private const string ModulePath = "./_content/ScarnaUI/js/scarna/slider.js";

    private ElementReference _inputRef;
    private IJSObjectReference? _module;

    private async Task HandleInputAsync(ChangeEventArgs e)
    {
        if (ReadOnly)
        {
            // Браузер уже переместил ползунок в DOM до этого события (readonly для
            // range не действует) — раз Value в C# не меняется, обычный рендер Blazor
            // это не откатит (в его дереве атрибут и так тот же), поэтому возвращаем
            // value самому DOM-элементу явно через JS. См. комментарий в slider.js.
            _module ??= await JSRuntime.InvokeAsync<IJSObjectReference>("import", ModulePath);
            await _module.InvokeVoidAsync("resetValue", _inputRef, Value.ToString(System.Globalization.CultureInfo.InvariantCulture));
            return;
        }

        if (double.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var parsed))
        {
            await SetValueAsync(parsed);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // circuit уже закрыт — освобождать нечего
            }
        }
    }

    private string InputClasses => CssBuilder.Default("scarna-slider h-5 w-full rounded-scarna-full disabled:cursor-not-allowed disabled:opacity-50")
        .AddClass("cursor-pointer", !ReadOnly)
        .AddClass("pointer-events-none", ReadOnly)
        .ToString();

    private string ColorVar => Color switch
    {
        Color.Secondary => "--scarna-secondary",
        Color.Success => "--scarna-success",
        Color.Warning => "--scarna-warning",
        Color.Danger => "--scarna-danger",
        Color.Default => "--scarna-default",
        _ => "--scarna-primary",
    };

    // Заливка дорожки слева от ползунка (градиент) + цвет обводки ползунка
    // (--scarna-slider-thumb-color, читается CSS-правилом .scarna-slider::-webkit-slider-thumb
    // в input.css) — оба выставляются здесь одним style, чтобы Color влиял сразу на всё.
    private string TrackStyle
    {
        get
        {
            var range = Max - Min;
            var percent = range <= 0 ? 0 : Math.Clamp((Value - Min) / range * 100, 0, 100);

            // Ползунок (::-webkit-slider-thumb/::-moz-range-thumb, ширина 1.75rem — см.
            // input.css) браузер вставляет с отступом в половину своей ширины от каждого
            // края трека: при value=Min центр ползунка не в 0% дорожки, а в 0.875rem от
            // левого края, при value=Max — в (100% - 0.875rem). Линейный градиент "0%..100%
            // от ширины поля" этого не учитывает, поэтому у левого края заливка не дотягивает
            // до ползунка, а у правого — перегоняет его. Граница заливки считается через
            // calc() с тем же инсетом в 0.875rem, что и у самого ползунка.
            var fraction = (percent / 100).ToString("0.####", System.Globalization.CultureInfo.InvariantCulture);
            var stop = $"calc((100% - 1.75rem) * {fraction} + 0.875rem)";
            return $"background: linear-gradient(to right, hsl(var({ColorVar})) 0%, hsl(var({ColorVar})) {stop}, hsl(var(--scarna-default)) {stop}, hsl(var(--scarna-default)) 100%); " +
                   $"--scarna-slider-thumb-color: var({ColorVar});";
        }
    }
}
