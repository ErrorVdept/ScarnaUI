@*
    Готовая кнопка-переключатель светлой/тёмной темы. Читает и меняет тему через
    каскадный ScarnaThemeContext — работает без какого-либо кода в приложении:

    <ScarnaThemeSwitch />
*@
@namespace ScarnaUI.Components.Theme

<button type="button"
        class="scarna-theme-switch inline-flex items-center justify-center size-9 rounded-scarna-full text-foreground/70 hover:bg-content2 hover:text-foreground transition-colors"
        @onclick="ToggleAsync"
        aria-label="Переключить тему"
        title="Переключить тему">
    @if (ThemeContext?.IsDarkMode == true)
    {
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41" />
        </svg>
    }
    else
    {
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z" />
        </svg>
    }
</button>

@code {
    [CascadingParameter] private ScarnaThemeContext? ThemeContext { get; set; }

    private Task ToggleAsync() => ThemeContext?.ToggleDarkModeAsync() ?? Task.CompletedTask;
}
