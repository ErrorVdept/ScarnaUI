@*
    Портал для тостов, добавленных через IToastManager.Add(...). Кладётся один раз
    в layout приложения, обычно рядом с ScarnaDialogProvider.
*@
@namespace ScarnaUI.Components.Overlays
@using ScarnaUI.Services
@inject ToastManager ToastManager
@implements IDisposable

<div class="scarna-snackbar-root fixed bottom-4 right-4 z-[1200] flex w-full max-w-sm flex-col gap-2">
    @foreach (var toast in ToastManager.Toasts)
    {
        <div @key="toast.Id"
             class="@($"scarna-toast flex items-start gap-3 rounded-scarna-md border-l-4 bg-content1 p-3 shadow-lg animate-scarna-slide-up-in {BorderClass(toast.Severity)}")"
             role="status">
            <span class="@($"mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-full text-xs font-bold leading-none {IconClass(toast.Severity)}")">@Icon(toast.Severity)</span>
            <span class="flex-1 text-sm text-foreground">@toast.Message</span>
            <button type="button"
                    class="shrink-0 rounded-scarna-sm p-0.5 text-foreground/50 hover:bg-content2 hover:text-foreground transition-colors"
                    @onclick="() => ToastManager.Remove(toast.Id)"
                    aria-label="Закрыть уведомление">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="6" x2="6" y2="18" />
                    <line x1="6" y1="6" x2="18" y2="18" />
                </svg>
            </button>
        </div>
    }
</div>

@code {
    protected override void OnInitialized() => ToastManager.OnChange += HandleChange;

    private void HandleChange() => InvokeAsync(StateHasChanged);

    private static string BorderClass(ScarnaToastSeverity severity) => severity switch
    {
        ScarnaToastSeverity.Success => "border-success",
        ScarnaToastSeverity.Warning => "border-warning",
        ScarnaToastSeverity.Error => "border-danger",
        _ => "border-primary",
    };

    private static string IconClass(ScarnaToastSeverity severity) => severity switch
    {
        ScarnaToastSeverity.Success => "bg-success/15 text-success",
        ScarnaToastSeverity.Warning => "bg-warning/15 text-warning",
        ScarnaToastSeverity.Error => "bg-danger/15 text-danger",
        _ => "bg-primary/15 text-primary",
    };

    private static string Icon(ScarnaToastSeverity severity) => severity switch
    {
        ScarnaToastSeverity.Success => "✓",
        ScarnaToastSeverity.Warning => "!",
        ScarnaToastSeverity.Error => "✕",
        _ => "i",
    };

    public void Dispose() => ToastManager.OnChange -= HandleChange;
}
