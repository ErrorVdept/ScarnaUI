@*
    Центрирующий контейнер с максимальной шириной и боковыми отступами —
    типовая обёртка страницы (аналог MudContainer).

    <ScarnaContainer Breakpoint="ScarnaContainerMaxWidth.Large">
        ...содержимое страницы...
    </ScarnaContainer>
*@
@namespace ScarnaUI.Components.Layout
@inherits ScarnaComponentBase

<div class="@Classes" style="@RootStyle" @attributes="UserAttributes">
    @ChildContent
</div>

@code {
    /// <summary>
    /// Максимальная ширина контейнера — готовый пресет брейкпоинтов. Называется не
    /// MaxWidth, потому что этот параметр уже занят в ScarnaComponentBase под произвольное
    /// CSS-значение max-width (string?) — Blazor не поддерживает переопределение параметра
    /// с другим типом (override, в отличие от обычного члена класса, требует точного
    /// совпадения типа). Если нужен точный CSS max-width, а не пресет, используйте
    /// унаследованный MaxWidth.
    /// </summary>
    [Parameter] public ScarnaContainerMaxWidth Breakpoint { get; set; } = ScarnaContainerMaxWidth.Large;

    /// <summary>Растянуть на всю ширину без ограничения (эквивалент MaxWidth.False в MudBlazor).</summary>
    [Parameter] public bool Fluid { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string Classes => CssBuilder.Default("scarna-container mx-auto w-full px-4 sm:px-6 lg:px-8")
        .AddClass(MaxWidthClass, !Fluid)
        .AddClass(Class)
        .ToString();

    private string MaxWidthClass => Breakpoint switch
    {
        ScarnaContainerMaxWidth.Small => "max-w-3xl",
        ScarnaContainerMaxWidth.Medium => "max-w-5xl",
        ScarnaContainerMaxWidth.Large => "max-w-6xl",
        ScarnaContainerMaxWidth.ExtraLarge => "max-w-7xl",
        _ => "max-w-6xl",
    };
}
