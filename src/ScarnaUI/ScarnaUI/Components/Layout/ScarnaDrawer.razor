@*
    Выезжающая панель (боковое меню, панель фильтров). В отличие от ScarnaDialog —
    не сервис, а обычный декларативный компонент: кладётся в разметку (обычно в layout)
    и управляется через @bind-Open, как MudDrawer.

    <ScarnaDrawer @bind-Open="_menuOpen" Anchor="ScarnaDrawerAnchor.Left">
        <ScarnaNavLinks />
    </ScarnaDrawer>
    <ScarnaButton OnClick="() => _menuOpen = true">Меню</ScarnaButton>

    Variant задаёт, как панель ведёт себя относительно остального контента —
    см. ScarnaDrawerVariant. По умолчанию Temporary (текущее поведение — overlay
    с подложкой, ничего не раздвигает). Persistent/Mini не рисуют подложку и занимают
    реальное место в потоке (обычный flex-элемент с анимируемой шириной/высотой) —
    поэтому положите ScarnaDrawer рядом с содержимым внутри общего flex-контейнера,
    и оно "само" будет раздвигаться вместе с открытием/закрытием панели, без ручной
    синхронизации отступов в коде страницы:

    <div class="flex">
        <ScarnaDrawer @bind-Open="_open" Variant="ScarnaDrawerVariant.Persistent">...</ScarnaDrawer>
        <main class="flex-1">...</main>
    </div>
*@
@namespace ScarnaUI.Components.Layout
@inherits ScarnaComponentBase

@if (Variant == ScarnaDrawerVariant.Temporary && Open)
{
    <div class="fixed inset-0 z-[1050] bg-overlay/50 animate-scarna-fade-in" @onclick="HandleBackdropClick"></div>
}
<aside class="@Classes" style="@CombinedStyle" @attributes="UserAttributes">
    @ChildContent
</aside>

@code {
    /// <summary>Открыта ли панель. Поддерживает @bind-Open.</summary>
    [Parameter] public bool Open { get; set; }

    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    [Parameter] public ScarnaDrawerAnchor Anchor { get; set; } = ScarnaDrawerAnchor.Left;

    /// <summary>Temporary (по умолчанию) — overlay с подложкой. Persistent/Mini — занимает место в потоке, раздвигая соседние элементы.</summary>
    [Parameter] public ScarnaDrawerVariant Variant { get; set; } = ScarnaDrawerVariant.Temporary;

    /// <summary>
    /// Ширина панели (для Left/Right) — любое CSS-значение, например "280px".
    /// Переопределяет (override, не new — Blazor не поддерживает скрытие параметров)
    /// одноимённый параметр ScarnaComponentBase: там — просто произвольная ширина
    /// корневого блока (string?), здесь — размер раскрытой панели, участвующий
    /// в анимации Persistent/Mini, и всегда непустой (string с default) — отсюда
    /// осознанное сужение nullability, подавляем предупреждение об этом ниже.
    /// </summary>
#pragma warning disable CS8765 // сужение nullability при override — см. комментарий выше
    [Parameter] public override string Width { get; set; } = "280px";

    /// <summary>Высота панели (для Top/Bottom) — любое CSS-значение. См. Width — та же причина override.</summary>
    [Parameter] public override string Height { get; set; } = "280px";
#pragma warning restore CS8765

    /// <summary>Ширина/высота в закрытом состоянии у Variant.Mini (обычно под одни иконки). Для Temporary/Persistent не используется — там закрытое состояние либо за экраном, либо нулевого размера.</summary>
    [Parameter] public string MiniWidth { get; set; } = "72px";

    [Parameter] public bool CloseOnBackdropClick { get; set; } = true;

    /// <summary>Фон панели. Default (по умолчанию) — нейтральная поверхность темы (bg-content1); Transparent — без заливки; остальные — сплошная заливка цветом темы (например, тем же Color, что и у ScarnaNavBar, чтобы Drawer и AppBar были одного цвета).</summary>
    [Parameter] public Color Color { get; set; } = Color.Default;

    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool IsHorizontal => Anchor is ScarnaDrawerAnchor.Left or ScarnaDrawerAnchor.Right;

    private async Task HandleBackdropClick()
    {
        if (!CloseOnBackdropClick)
        {
            return;
        }

        Open = false;

        if (OpenChanged.HasDelegate)
        {
            await OpenChanged.InvokeAsync(false);
        }
    }

    private string Classes => CssBuilder.Default("scarna-drawer overflow-y-auto overflow-x-hidden")
        .AddClass(ScarnaColorVariantClasses.Surface(Color))
        .AddClass(TemporaryClasses, Variant == ScarnaDrawerVariant.Temporary)
        .AddClass(PersistentClasses, Variant != ScarnaDrawerVariant.Temporary)
        .AddClass(Class)
        .ToString();

    // Temporary: position:fixed поверх всего, слайд через translate — ничего не раздвигает,
    // поэтому и не нужно место в потоке документа.
    private string TemporaryClasses => CssBuilder.Default("fixed z-[1060] shadow-xl transition-transform duration-200 ease-out")
        .AddClass(AnchorClass)
        .ToString();

    private string AnchorClass => Anchor switch
    {
        ScarnaDrawerAnchor.Right => $"top-0 right-0 bottom-0 {(Open ? "translate-x-0" : "translate-x-full")}",
        ScarnaDrawerAnchor.Top => $"top-0 left-0 right-0 {(Open ? "translate-y-0" : "-translate-y-full")}",
        ScarnaDrawerAnchor.Bottom => $"bottom-0 left-0 right-0 {(Open ? "translate-y-0" : "translate-y-full")}",
        _ => $"top-0 left-0 bottom-0 {(Open ? "translate-x-0" : "-translate-x-full")}",
    };

    // Persistent/Mini: обычный flex-элемент (relative, shrink-0) — реальная ширина/высота
    // анимируется через CombinedStyle, поэтому соседи по флекс-контейнеру раздвигаются
    // сами, безо всякой ручной синхронизации отступов на стороне страницы.
    private string PersistentClasses => CssBuilder.Default("relative shrink-0 transition-[width,height] duration-200 ease-out")
        .AddClass(PersistentBorderClass)
        .ToString();

    private string PersistentBorderClass => Anchor switch
    {
        ScarnaDrawerAnchor.Right => "border-l border-divider",
        ScarnaDrawerAnchor.Top => "border-b border-divider",
        ScarnaDrawerAnchor.Bottom => "border-t border-divider",
        _ => "border-r border-divider",
    };

    // MinWidth/MinHeight/MaxWidth/MaxHeight из ScarnaComponentBase
    // подмешиваются через BuildStyle — свои Width/Height (см. override string Width/Height
    // выше) уже посчитаны в sizeStyle и передаются как ownStyle. includeWidthHeight:false —
    // иначе BuildStyle сам добавил бы ещё и "чистые" Width/Height по обеим осям сразу
    // (у него нет своей логики Anchor), задвоив уже посчитанный sizeStyle и заодно наложив
    // лишнее ограничение на ось, которую Anchor не использует (например, height на
    // Anchor=Left, где панель должна тянуться на всю доступную высоту).
    private string? CombinedStyle
    {
        get
        {
            var sizeStyle = Variant == ScarnaDrawerVariant.Temporary
                ? (IsHorizontal ? $"width: {NormalizeLength(Width)};" : $"height: {NormalizeLength(Height)};")
                : PersistentSizeStyle;

            return BuildStyle(sizeStyle, includeWidthHeight: false);
        }
    }

    private string PersistentSizeStyle
    {
        get
        {
            var collapsedSize = Variant == ScarnaDrawerVariant.Mini ? MiniWidth : "0px";
            var size = NormalizeLength(Open ? (IsHorizontal ? Width : Height) : collapsedSize);
            return IsHorizontal ? $"width: {size};" : $"height: {size};";
        }
    }
}
