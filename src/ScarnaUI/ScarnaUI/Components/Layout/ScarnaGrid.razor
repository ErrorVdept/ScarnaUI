@*
    12-колоночная CSS-grid сетка (аналог MudGrid). Используется вместе с ScarnaItem:

    <ScarnaGrid Spacing="4">
        <ScarnaItem Xs="12" Md="6"><ScarnaCard>...</ScarnaCard></ScarnaItem>
        <ScarnaItem Xs="12" Md="6"><ScarnaCard>...</ScarnaCard></ScarnaItem>
    </ScarnaGrid>
*@
@namespace ScarnaUI.Components.Layout
@inherits ScarnaComponentBase

<div class="@Classes" style="@CombinedStyle" @attributes="UserAttributes">
    @ChildContent
</div>

@code {
    /// <summary>Отступ между ячейками в шагах Tailwind-шкалы (1 = 0.25rem).</summary>
    [Parameter] public int Spacing { get; set; } = 4;

    /// <summary>Распределение свободного места вдоль строки (justify-content) — как Justify в MudBlazor. Заметно, только если ячейки не заполняют всю ширину.</summary>
    [Parameter] public ScarnaJustify Justify { get; set; } = ScarnaJustify.Start;

    /// <summary>Выравнивание содержимого ячеек по вертикали (align-items) — как AlignItems в MudBlazor.</summary>
    [Parameter] public ScarnaAlign Align { get; set; } = ScarnaAlign.Stretch;

    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string Classes => CssBuilder.Default("scarna-grid grid grid-cols-12")
        .AddClass(JustifyClass)
        .AddClass(AlignClass)
        .AddClass(Class)
        .ToString();

    private string JustifyClass => Justify switch
    {
        ScarnaJustify.End => "justify-end",
        ScarnaJustify.Center => "justify-center",
        ScarnaJustify.SpaceBetween => "justify-between",
        ScarnaJustify.SpaceAround => "justify-around",
        ScarnaJustify.SpaceEvenly => "justify-evenly",
        _ => "justify-start",
    };

    private string AlignClass => Align switch
    {
        ScarnaAlign.Start => "items-start",
        ScarnaAlign.End => "items-end",
        ScarnaAlign.Center => "items-center",
        ScarnaAlign.Baseline => "items-baseline",
        _ => "items-stretch",
    };

    private string CombinedStyle
    {
        get
        {
            // InvariantCulture — иначе на локалях с запятой как разделителем дробной части
            // получилось бы невалидное "gap: 0,5rem", и браузер тихо съедал бы отступы.
            var gap = $"gap: {(Spacing * 0.25).ToString(System.Globalization.CultureInfo.InvariantCulture)}rem;";
            return string.IsNullOrWhiteSpace(Style) ? gap : $"{gap} {Style}";
        }
    }
}
