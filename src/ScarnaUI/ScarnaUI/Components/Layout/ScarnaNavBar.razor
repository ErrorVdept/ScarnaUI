@*
    Верхняя панель приложения (аналог MudAppBar/шапки сайта). Формализует то, что
    в демо раньше собиралось вручную из <header>+ScarnaStack — задаёт высоту,
    подложку с блюром и границу снизу, содержимое — произвольное.

    <ScarnaNavBar Density="ScarnaDensity.Dense" Justify="Justify.SpaceBetween">
        <a href="/" class="font-semibold">Logo</a>
        <ScarnaStack Row="true" Spacing="4"><NavLink href="/">Главная</NavLink></ScarnaStack>
    </ScarnaNavBar>

    По умолчанию (Color.Default) — полупрозрачная подложка с блюром (GlassEffect="true").
    Чтобы AppBar был того же сплошного цвета, что и Color.Default у ScarnaDrawer
    (bg-content1), отключите блюр:

    <ScarnaNavBar GlassEffect="false">...</ScarnaNavBar>
    <ScarnaDrawer>...</ScarnaDrawer>

    Боковой паддинг (px-4 sm:px-6 lg:px-8) — часть Classes корневого <header>, а не
    вложенного элемента (раньше был на ScarnaContainer внутри — Class снаружи его не
    доставал), поэтому переопределяется как у любого другого компонента:

    <ScarnaNavBar Class="px-0!">...</ScarnaNavBar>
*@
@namespace ScarnaUI.Components.Layout
@inherits ScarnaComponentBase

<header class="@Classes" style="@RootStyle" @attributes="UserAttributes">
    <div class="@RowClasses">
        @ChildContent
    </div>
</header>

@code {
    /// <summary>Прилипает к верху при прокрутке (position: sticky).</summary>
    [Parameter] public bool Sticky { get; set; } = true;

    [Parameter] public bool Bordered { get; set; } = true;

    /// <summary>Normal (по умолчанию, 56px) — обычная высота. Dense — компактная (48px).</summary>
    [Parameter] public ScarnaDensity Density { get; set; } = ScarnaDensity.Normal;

    /// <summary>Цвет фона панели. Default (по умолчанию) — нейтральная подложка (см. GlassEffect); любой другой — сплошная заливка цветом.</summary>
    [Parameter] public Color Color { get; set; } = Color.Default;

    /// <summary>
    /// Полупрозрачная подложка с блюром вместо сплошного bg-content1 — как одноимённый
    /// параметр у ScarnaPaper, но включён по умолчанию (исторический вид AppBar, чтобы
    /// не ломать внешний вид у всех существующих потребителей). Действует только при
    /// Color="Color.Default" — у цветных вариантов заливка всегда сплошная. Выключите,
    /// чтобы AppBar получил тот же сплошной bg-content1, что и Color.Default у ScarnaDrawer.
    /// </summary>
    [Parameter] public bool GlassEffect { get; set; } = true;

    /// <summary>Распределение содержимого по горизонтали — как AlignItems в MudBlazor (justify-content внутренней строки).</summary>
    [Parameter] public Justify Justify { get; set; } = Justify.SpaceBetween;

    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string Classes => CssBuilder.Default("scarna-navbar z-30 px-4 sm:px-6 lg:px-8")
        .AddClass(ColorClass)
        .AddClass("sticky top-0", Sticky)
        .AddClass("border-b border-divider", Bordered)
        .AddClass(Class)
        .ToString();

    private string ColorClass => CssBuilder.Default(ScarnaColorVariantClasses.Surface(Color, GlassEffect ? "bg-background/80 backdrop-blur" : "bg-content1"))
        .AddClass("text-foreground", Color is Color.Default or Color.Transparent)
        .ToString();

    private string RowClasses => CssBuilder.Default("flex items-center gap-4")
        .AddClass(Density == ScarnaDensity.Dense ? "h-12" : "h-14")
        .AddClass(JustifyClass)
        .ToString();

    private string JustifyClass => Justify switch
    {
        Justify.Start => "justify-start",
        Justify.End => "justify-end",
        Justify.Center => "justify-center",
        Justify.SpaceAround => "justify-around",
        Justify.SpaceEvenly => "justify-evenly",
        _ => "justify-between",
    };
}
