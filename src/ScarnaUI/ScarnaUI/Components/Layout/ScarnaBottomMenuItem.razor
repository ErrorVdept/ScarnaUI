@*
    Один пункт ScarnaBottomMenu — иконка сверху, подпись снизу, как в мобильных tab bar.
*@
@namespace ScarnaUI.Components.Layout
@inherits ScarnaComponentBase
@implements IDisposable

<button type="button" class="@Classes" style="@RootStyle" @onclick="HandleClickAsync" aria-current="@(IsActive ? "page" : null)" @attributes="UserAttributes">
    <span class="@IconClasses">@ChildContent</span>
    @if (!string.IsNullOrEmpty(Text))
    {
        <span class="text-[11px] font-medium leading-none">@Text</span>
    }
</button>

@code {
    [CascadingParameter] private ScarnaBottomMenu? Parent { get; set; }

    /// <summary>Подпись под иконкой.</summary>
    [Parameter] public string? Text { get; set; }

    /// <summary>Иконка (обычно svg 20-22px).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Коллбэк клика — вызывается в дополнение к выбору пункта в родительском ScarnaBottomMenu.</summary>
    [Parameter] public EventCallback OnClick { get; set; }

    private bool IsActive => Parent?.IsSelected(this) ?? false;

    protected override void OnInitialized()
    {
        if (Parent is null)
        {
            throw new InvalidOperationException("ScarnaBottomMenuItem должен использоваться внутри ScarnaBottomMenu.");
        }

        Parent.Register(this);
    }

    private async Task HandleClickAsync()
    {
        if (Parent is not null)
        {
            await Parent.SelectAsync(this);
        }

        if (OnClick.HasDelegate)
        {
            await OnClick.InvokeAsync();
        }
    }

    private string Classes => CssBuilder.Default("scarna-bottom-menu-item flex flex-1 flex-col items-center justify-center gap-1 py-2 transition-colors")
        .AddClass(IsActive ? "text-primary" : "text-foreground/50 hover:text-foreground/80")
        .AddClass(Class)
        .ToString();

    private string IconClasses => CssBuilder.Default("flex items-center justify-center [&_svg]:size-5")
        .ToString();

    public void Dispose() => Parent?.Unregister(this);
}
