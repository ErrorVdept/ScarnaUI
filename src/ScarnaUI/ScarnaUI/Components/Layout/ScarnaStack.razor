@*
    Flex-контейнер для расстановки дочерних элементов в ряд/колонку с равным отступом —
    аналог MudStack. Самый часто используемый layout-компонент библиотеки.

    <ScarnaStack Spacing="3" Row>
        <ScarnaButton>Отмена</ScarnaButton>
        <ScarnaButton Color="Color.Primary">Сохранить</ScarnaButton>
    </ScarnaStack>
*@
@namespace ScarnaUI.Components.Layout
@inherits ScarnaComponentBase

<div class="@Classes" style="@StyleValue" @attributes="UserAttributes">
    @ChildContent
</div>

@code {
    /// <summary>Направление: true — flex-row (в ряд), false (по умолчанию) — flex-column.</summary>
    [Parameter] public bool Row { get; set; }

    /// <summary>Отступ между элементами в шагах Tailwind-шкалы gap (1 = 0.25rem). По умолчанию 2 (0.5rem).</summary>
    [Parameter] public int Spacing { get; set; } = 2;

    /// <summary>Перенос элементов на новую строку/столбец при нехватке места.</summary>
    [Parameter] public bool Wrap { get; set; }

    /// <summary>Выравнивание по главной оси (justify-content).</summary>
    [Parameter] public Justify Justify { get; set; } = Justify.Start;

    /// <summary>Выравнивание по поперечной оси (align-items).</summary>
    [Parameter] public Align Align { get; set; } = Align.Stretch;

    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string? StyleValue => CombineStyle();

    private string CombineStyle()
    {
        // Important: без InvariantCulture на серверах с локалью, где разделитель дробной
        // части — запятая (например, ru-RU), получилось бы невалидное CSS "gap: 0,5rem"
        // (браузер тихо игнорирует всё объявление, из-за чего "пропадали" отступы).
        var gap = $"gap: {(Spacing * 0.25).ToString(System.Globalization.CultureInfo.InvariantCulture)}rem;";
        return string.IsNullOrWhiteSpace(Style) ? gap : $"{gap} {Style}";
    }

    private string Classes => CssBuilder.Default("scarna-stack flex")
        .AddClass("flex-row", Row)
        .AddClass("flex-col", !Row)
        .AddClass("flex-wrap", Wrap)
        .AddClass(JustifyClass)
        .AddClass(AlignClass)
        .AddClass(Class)
        .ToString();

    private string JustifyClass => Justify switch
    {
        Justify.End => "justify-end",
        Justify.Center => "justify-center",
        Justify.SpaceBetween => "justify-between",
        Justify.SpaceAround => "justify-around",
        Justify.SpaceEvenly => "justify-evenly",
        _ => "justify-start",
    };

    private string AlignClass => Align switch
    {
        Align.Start => "items-start",
        Align.End => "items-end",
        Align.Center => "items-center",
        Align.Baseline => "items-baseline",
        _ => "items-stretch",
    };
}
