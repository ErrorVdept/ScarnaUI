@*
    Ячейка 12-колоночной сетки ScarnaGrid. Числа — сколько из 12 колонок занять на
    соответствующей ширине экрана (как в MudItem/Bootstrap-grid).

    <ScarnaItem Xs="12" Md="4">...</ScarnaItem>  — во всю ширину на мобильных, треть на десктопе

    Технический нюанс: классы вида "md:col-span-6" должны присутствовать в исходниках
    буквально, иначе Tailwind (статический анализ classes во время сборки CSS) их не
    сгенерирует — поэтому ниже не строка-интерполяция, а честный switch по каждому брейкпоинту.
*@
@namespace ScarnaUI.Components.Layout
@inherits ScarnaComponentBase

<div class="@Classes" style="@RootStyle" @attributes="UserAttributes">
    @ChildContent
</div>

@code {
    /// <summary>Ширина по умолчанию (мобильные и выше), 1-12. По умолчанию — во всю ширину.</summary>
    [Parameter] public int Xs { get; set; } = 12;

    /// <summary>Ширина от breakpoint sm (≥640px), 1-12.</summary>
    [Parameter] public int? Sm { get; set; }

    /// <summary>Ширина от breakpoint md (≥768px), 1-12.</summary>
    [Parameter] public int? Md { get; set; }

    /// <summary>Ширина от breakpoint lg (≥1024px), 1-12.</summary>
    [Parameter] public int? Lg { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string Classes => CssBuilder.Default("scarna-item")
        .AddClass(XsClass(Xs))
        .AddClass(Sm is { } sm ? SmClass(sm) : null)
        .AddClass(Md is { } md ? MdClass(md) : null)
        .AddClass(Lg is { } lg ? LgClass(lg) : null)
        .AddClass(Class)
        .ToString();

    private static string XsClass(int n) => n switch
    {
        1 => "col-span-1", 2 => "col-span-2", 3 => "col-span-3", 4 => "col-span-4",
        5 => "col-span-5", 6 => "col-span-6", 7 => "col-span-7", 8 => "col-span-8",
        9 => "col-span-9", 10 => "col-span-10", 11 => "col-span-11", _ => "col-span-12",
    };

    private static string SmClass(int n) => n switch
    {
        1 => "sm:col-span-1", 2 => "sm:col-span-2", 3 => "sm:col-span-3", 4 => "sm:col-span-4",
        5 => "sm:col-span-5", 6 => "sm:col-span-6", 7 => "sm:col-span-7", 8 => "sm:col-span-8",
        9 => "sm:col-span-9", 10 => "sm:col-span-10", 11 => "sm:col-span-11", _ => "sm:col-span-12",
    };

    private static string MdClass(int n) => n switch
    {
        1 => "md:col-span-1", 2 => "md:col-span-2", 3 => "md:col-span-3", 4 => "md:col-span-4",
        5 => "md:col-span-5", 6 => "md:col-span-6", 7 => "md:col-span-7", 8 => "md:col-span-8",
        9 => "md:col-span-9", 10 => "md:col-span-10", 11 => "md:col-span-11", _ => "md:col-span-12",
    };

    private static string LgClass(int n) => n switch
    {
        1 => "lg:col-span-1", 2 => "lg:col-span-2", 3 => "lg:col-span-3", 4 => "lg:col-span-4",
        5 => "lg:col-span-5", 6 => "lg:col-span-6", 7 => "lg:col-span-7", 8 => "lg:col-span-8",
        9 => "lg:col-span-9", 10 => "lg:col-span-10", 11 => "lg:col-span-11", _ => "lg:col-span-12",
    };
}
