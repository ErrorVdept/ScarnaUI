@*
    Нижнее меню — панель вкладок, прибитая к низу экрана, как в мобильных приложениях
    (iOS tab bar / Android bottom navigation). В отличие от ScarnaDrawer(Anchor.Bottom) —
    не выезжающая панель поверх контента, а всегда видимая строка навигации.

    <ScarnaBottomMenu @bind-SelectedIndex="_tab">
        <ScarnaBottomMenuItem Text="Главная"><Icon /></ScarnaBottomMenuItem>
        <ScarnaBottomMenuItem Text="Поиск"><Icon /></ScarnaBottomMenuItem>
        <ScarnaBottomMenuItem Text="Профиль"><Icon /></ScarnaBottomMenuItem>
    </ScarnaBottomMenu>

    Фон настраивается так же, как у ScarnaPaper (Bordered/Shadow/Radius/GlassEffect).
    Floating переключает вид на плавающую панель с отступом снизу и с боков (как
    пилюля, а не полоса во всю ширину) — обычно вместе с Radius="Radius.Full" и Shadow="true":

    <ScarnaBottomMenu Floating="true" Radius="Radius.Full" Shadow="true" @bind-SelectedIndex="_tab">
        ...
    </ScarnaBottomMenu>
*@
@namespace ScarnaUI.Components.Layout
@inherits ScarnaComponentBase

<nav class="@Classes" style="@Style" @attributes="UserAttributes">
    <CascadingValue Value="this" IsFixed="false">
        @ChildContent
    </CascadingValue>
</nav>

@code {
    private readonly List<ScarnaBottomMenuItem> _items = new();

    /// <summary>Индекс активного пункта. Поддерживает @bind-SelectedIndex.</summary>
    [Parameter] public int SelectedIndex { get; set; }

    [Parameter] public EventCallback<int> SelectedIndexChanged { get; set; }

    /// <summary>Плавающая панель с отступом снизу и с боков (inset-x-4 bottom-4) вместо полосы во всю ширину экрана. Обычно вместе с Radius="Radius.Full" и Shadow="true".</summary>
    [Parameter] public bool Floating { get; set; }

    /// <summary>Рисовать ли рамку (сверху — в обычном виде, по периметру — в Floating).</summary>
    [Parameter] public bool Bordered { get; set; } = true;

    /// <summary>Тень под панелью.</summary>
    [Parameter] public bool Shadow { get; set; }

    /// <summary>Радиус скругления углов. По умолчанию без скругления (полоса во всю ширину); для Floating обычно Radius.Full.</summary>
    [Parameter] public Radius Radius { get; set; } = Radius.None;

    /// <summary>Полупрозрачный фон с блюром (backdrop-blur) вместо сплошного bg-content1 — как у ScarnaNavBar.</summary>
    [Parameter] public bool GlassEffect { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    internal void Register(ScarnaBottomMenuItem item)
    {
        if (!_items.Contains(item))
        {
            _items.Add(item);
            StateHasChanged();
        }
    }

    internal void Unregister(ScarnaBottomMenuItem item)
    {
        if (_items.Remove(item))
        {
            StateHasChanged();
        }
    }

    internal bool IsSelected(ScarnaBottomMenuItem item) => _items.IndexOf(item) == SelectedIndex;

    internal async Task SelectAsync(ScarnaBottomMenuItem item)
    {
        var index = _items.IndexOf(item);
        if (index < 0 || index == SelectedIndex)
        {
            return;
        }

        SelectedIndex = index;

        if (SelectedIndexChanged.HasDelegate)
        {
            await SelectedIndexChanged.InvokeAsync(index);
        }
    }

    private string Classes => CssBuilder.Default("scarna-bottom-menu fixed z-[1040] flex items-stretch justify-around overflow-hidden text-foreground transition-colors duration-150")
        .AddClass(PositionClasses)
        .AddClass("bg-content1/80 backdrop-blur-md", GlassEffect)
        .AddClass("bg-content1", !GlassEffect)
        .AddClass(ScarnaColorVariantClasses.Radius(Radius))
        .AddClass("border-t border-divider", Bordered && !Floating)
        .AddClass("border border-divider", Bordered && Floating)
        .AddClass("shadow-lg", Shadow)
        .AddClass(Class)
        .ToString();

    private string PositionClasses => Floating
        ? "inset-x-4 bottom-4 mb-[env(safe-area-inset-bottom)]"
        : "inset-x-0 bottom-0 pb-[env(safe-area-inset-bottom)]";
}
