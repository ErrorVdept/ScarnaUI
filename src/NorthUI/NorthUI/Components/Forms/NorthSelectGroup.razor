@*
    Группа с одиночным выбором — тот же функционал, что у NorthSelect (@bind-Value,
    список пунктов), но без выпадающего списка: все варианты видны сразу, оформлены
    как NorthTabs (pill-индикатор плавно едет между кнопками). Хорош для короткого
    списка из 2-5 вариантов (переключатель периода, единицы измерения и т.п.) —
    для длинных списков используйте NorthSelect.

    <NorthSelectGroup Label="Период" @bind-Value="_period">
        <NorthSelectGroupItem Value="@("day")" Text="День" />
        <NorthSelectGroupItem Value="@("week")" Text="Неделя" />
        <NorthSelectGroupItem Value="@("month")" Text="Месяц" />
    </NorthSelectGroup>
*@
@namespace NorthUI.Components.Forms
@typeparam TValue
@inherits NorthFormComponentBase<TValue>
@attribute [CascadingTypeParameter(nameof(TValue))]
@implements IAsyncDisposable
@inject IJSRuntime JSRuntime

<div class="@WrapperClasses" style="@Style" @attributes="UserAttributes">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="text-sm font-medium text-foreground/80">@Label</label>
    }
    <div @ref="_trackElement" class="@TrackClasses">
        <span class="north-tabs__indicator absolute inset-y-1 left-0 rounded-north-full bg-content1 shadow-md transition-[transform,width] duration-200 ease-out" style="width:0"></span>
        <CascadingValue Value="this" IsFixed="false">
            @ChildContent
        </CascadingValue>
    </div>
</div>

@code {
    private const string ModulePath = "./_content/NorthUI/js/north/tabs.js";

    private readonly List<NorthSelectGroupItem<TValue>> _items = new();
    private ElementReference _trackElement;
    private IJSObjectReference? _module;

    [Parameter] public string? Label { get; set; }

    /// <summary>Набор `<NorthSelectGroupItem>`.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>К какому краю прижимать кнопки вдоль дорожки — как AlignItems в MudBlazor (здесь это justify-content, т.к. поперечная ось и так центрирована). Заметно, только если FullWidth="false".</summary>
    [Parameter] public NorthJustify Justify { get; set; } = NorthJustify.Start;

    /// <summary>Растянуть кнопки на всю ширину родителя поровну, вместо ширины по содержимому.</summary>
    [Parameter] public bool FullWidth { get; set; }

    internal bool IsSelected(NorthSelectGroupItem<TValue> item) => EqualityComparer<TValue>.Default.Equals(item.Value, Value);

    internal void Register(NorthSelectGroupItem<TValue> item)
    {
        if (!_items.Contains(item))
        {
            _items.Add(item);
            StateHasChanged();
        }
    }

    internal void Unregister(NorthSelectGroupItem<TValue> item)
    {
        if (_items.Remove(item))
        {
            StateHasChanged();
        }
    }

    internal async Task SelectAsync(TValue value)
    {
        // Клик приходит из дочернего NorthSelectGroupItem — Blazor автоматически
        // перерисовывает компонент, чей обработчик сработал (Item), но НЕ его родителя
        // (эту группу). SetValueAsync сама по себе не запрашивает перерисовку (она
        // рассчитана на вызов из обработчика СВОЕГО ЖЕ компонента, как в NorthInput),
        // поэтому без явного StateHasChanged соседние пункты не узнают, что выбор сменился.
        await SetValueAsync(value);
        await InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        _module ??= await JSRuntime.InvokeAsync<IJSObjectReference>("import", ModulePath);
        await _module.InvokeVoidAsync("syncIndicator", _trackElement);
    }

    private string WrapperClasses => CssBuilder.Default("north-select-group flex flex-col gap-1").AddClass(Class).ToString();

    private string TrackClasses => CssBuilder.Default("north-select-group__track relative flex items-center gap-1 rounded-north-full bg-content2 p-1")
        .AddClass("w-full", FullWidth)
        .AddClass("inline-flex", !FullWidth)
        .AddClass("[&>button]:flex-1", FullWidth)
        .AddClass(JustifyClass)
        .ToString();

    private string JustifyClass => Justify switch
    {
        NorthJustify.End => "justify-end",
        NorthJustify.Center => "justify-center",
        NorthJustify.SpaceBetween => "justify-between",
        NorthJustify.SpaceAround => "justify-around",
        NorthJustify.SpaceEvenly => "justify-evenly",
        _ => "justify-start",
    };

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // circuit уже закрыт — освобождать нечего
            }
        }
    }
}
