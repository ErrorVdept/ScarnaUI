@*
    Числовое поле со ступенчатыми кнопками +/-. Клавиатурный ввод тоже работает
    (нативный input[type=number], но со скрытыми родными стрелками — свои кнопки
    по краям их полностью заменяют, дублировать было бы избыточно).

    <NorthNumericField Label="Количество" @bind-Value="_qty" Min="0" Max="99" Step="1" />
    <NorthNumericField Label="Цена" @bind-Value="_price" Format="NorthNumberFormat.Decimal" Step="0.5" />
*@
@namespace NorthUI.Components.Forms
@inherits NorthFormComponentBase<double>

<div class="@WrapperOuterClasses" style="@Style" @attributes="UserAttributes">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="text-sm font-medium text-foreground/80">@Label</label>
    }

    <div class="@FieldWrapperClasses">
        <button type="button" class="north-numeric__step flex h-full shrink-0 items-center justify-center px-2 text-foreground/60 transition-colors hover:bg-content2 disabled:pointer-events-none disabled:opacity-40"
                disabled="@(Disabled || ReadOnly || Value <= Min)" @onclick="Decrement" aria-label="Уменьшить" tabindex="-1">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="5" y1="12" x2="19" y2="12" /></svg>
        </button>
        <input type="number"
               class="north-numeric__input w-full flex-1 appearance-none border-0 bg-transparent text-center outline-none text-foreground placeholder:text-foreground/40 disabled:cursor-not-allowed [-moz-appearance:textfield] [&::-webkit-inner-spin-button]:appearance-none [&::-webkit-outer-spin-button]:appearance-none"
               value="@FormattedValue"
               min="@Min.ToString(System.Globalization.CultureInfo.InvariantCulture)"
               max="@Max.ToString(System.Globalization.CultureInfo.InvariantCulture)"
               step="@Step.ToString(System.Globalization.CultureInfo.InvariantCulture)"
               disabled="@Disabled"
               readonly="@ReadOnly"
               @oninput="HandleInputAsync" />
        <button type="button" class="north-numeric__step flex h-full shrink-0 items-center justify-center px-2 text-foreground/60 transition-colors hover:bg-content2 disabled:pointer-events-none disabled:opacity-40"
                disabled="@(Disabled || ReadOnly || Value >= Max)" @onclick="Increment" aria-label="Увеличить" tabindex="-1">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
        </button>
    </div>

    @if (IsInvalid && !string.IsNullOrEmpty(ErrorText))
    {
        <span class="text-xs text-danger">@ErrorText</span>
    }
    else if (!string.IsNullOrEmpty(HelperText))
    {
        <span class="text-xs text-foreground/50">@HelperText</span>
    }
</div>

@code {
    [Parameter] public string? Label { get; set; }

    [Parameter] public string? HelperText { get; set; }

    [Parameter] public double Min { get; set; } = double.MinValue;

    [Parameter] public double Max { get; set; } = double.MaxValue;

    [Parameter] public double Step { get; set; } = 1;

    /// <summary>Целое или дробное значение — как выбор типа переменной у MudNumericField. Integer округляет любой ввод/шаг до целого.</summary>
    [Parameter] public NorthNumberFormat Format { get; set; } = NorthNumberFormat.Decimal;

    [Parameter] public bool Disabled { get; set; }

    [Parameter] public bool ReadOnly { get; set; }

    [Parameter] public NorthVariant Variant { get; set; } = NorthVariant.Bordered;

    [Parameter] public bool Bordered { get; set; } = true;

    [Parameter] public NorthSize Size { get; set; } = NorthSize.Medium;

    [Parameter] public NorthDensity Density { get; set; } = NorthDensity.Normal;

    [Parameter] public NorthRadius Radius { get; set; } = NorthRadius.Medium;

    private string FormattedValue => Format == NorthNumberFormat.Integer
        ? Value.ToString("F0", System.Globalization.CultureInfo.InvariantCulture)
        : Value.ToString(System.Globalization.CultureInfo.InvariantCulture);

    private double Normalize(double value)
    {
        value = Math.Clamp(value, Min, Max);
        return Format == NorthNumberFormat.Integer ? Math.Round(value, MidpointRounding.AwayFromZero) : value;
    }

    private async Task HandleInputAsync(ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var parsed))
        {
            await SetValueAsync(Normalize(parsed));
        }
    }

    private Task Decrement() => SetValueAsync(Normalize(Value - Step));

    private Task Increment() => SetValueAsync(Normalize(Value + Step));

    private string WrapperOuterClasses => CssBuilder.Default("north-numeric-wrapper flex flex-col gap-1")
        .AddClass(Class)
        .ToString();

    private string FieldWrapperClasses => CssBuilder.Default("north-numeric flex items-center overflow-hidden transition-colors")
        .AddClass(SizeClass)
        .AddClass(NorthColorVariantClasses.Radius(Radius))
        .AddClass(VariantClass)
        .AddClass("ring-1 ring-danger", IsInvalid)
        .ToString();

    private string SizeClass => (Size, Density) switch
    {
        (NorthSize.Small, NorthDensity.Dense) => "h-7 text-sm",
        (NorthSize.Small, _) => "h-8 text-sm",
        (NorthSize.Large, NorthDensity.Dense) => "h-10 text-base",
        (NorthSize.Large, _) => "h-12 text-base",
        (_, NorthDensity.Dense) => "h-8 text-sm",
        _ => "h-10 text-sm",
    };

    private string VariantClass => (Variant, Bordered) switch
    {
        (NorthVariant.Flat, true) => "bg-content2 border border-default focus-within:border-primary",
        (NorthVariant.Flat, false) => "bg-content2 border border-transparent",
        (_, true) => "bg-transparent border border-default focus-within:border-primary",
        (_, false) => "bg-transparent border border-transparent",
    };
}
