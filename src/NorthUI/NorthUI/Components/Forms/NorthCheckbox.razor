@*
    Чекбокс. Поддерживает @bind-Value (bool) и подпись рядом (ChildContent).

    <NorthCheckbox @bind-Value="model.AcceptTerms">Согласен с условиями</NorthCheckbox>
*@
@namespace NorthUI.Components.Forms
@inherits NorthFormComponentBase<bool>

<label class="@WrapperClasses" style="@Style" @attributes="UserAttributes">
    <input type="checkbox" class="sr-only peer" checked="@Value" disabled="@Disabled" aria-readonly="@ReadOnly" @onclick:preventDefault="ReadOnly" @onchange="HandleChangeAsync" />
    <span class="@BoxClasses" aria-hidden="true">
        @* Иконка рендерится всегда (а не через @if) и анимируется классом — так браузер
           может проиграть transition при появлении. При @if элемент создавался бы уже
           в конечном состоянии, и анимировать смену было бы нечем. *@
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"
             class="@($"transition-all duration-150 ease-out {(Value ? "scale-100 opacity-100" : "scale-50 opacity-0")}")">
            <polyline points="20 6 9 17 4 12" />
        </svg>
    </span>
    @if (ChildContent is not null)
    {
        <span class="text-sm text-foreground select-none">@ChildContent</span>
    }
</label>

@code {
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Запрещает переключение (клик отменяется через @onclick:preventDefault), но, в отличие от Disabled, чекбокс визуально не тускнеет.</summary>
    [Parameter] public bool ReadOnly { get; set; }

    /// <summary>Цвет заливки в отмеченном состоянии.</summary>
    [Parameter] public NorthColor Color { get; set; } = NorthColor.Primary;

    /// <summary>Normal (по умолчанию) — обычный размер. Dense — уменьшенный квадрат, для плотных списков.</summary>
    [Parameter] public NorthDensity Density { get; set; } = NorthDensity.Normal;

    /// <summary>Подпись рядом с чекбоксом.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private async Task HandleChangeAsync(ChangeEventArgs e)
    {
        if (ReadOnly)
        {
            return;
        }

        await SetValueAsync((bool)(e.Value ?? false));
    }

    private string WrapperClasses => CssBuilder.Default("north-checkbox inline-flex items-center cursor-pointer select-none")
        .AddClass(Density == NorthDensity.Dense ? "gap-1.5" : "gap-2")
        .AddClass("opacity-50 cursor-not-allowed", Disabled)
        .AddClass(Class)
        .ToString();

    private string BoxClasses => CssBuilder.Default("flex items-center justify-center shrink-0 border-2 rounded-north-sm transition-colors text-white")
        .AddClass(Density == NorthDensity.Dense ? "size-4" : "size-5")
        .AddClass(CheckedColorClasses, Value)
        .AddClass("border-default bg-transparent", !Value)
        .ToString();

    private string CheckedColorClasses => Color switch
    {
        NorthColor.Secondary => "bg-secondary border-secondary text-secondary-foreground",
        NorthColor.Success => "bg-success border-success text-success-foreground",
        NorthColor.Warning => "bg-warning border-warning text-warning-foreground",
        NorthColor.Danger => "bg-danger border-danger text-danger-foreground",
        NorthColor.Default => "bg-default border-default text-default-foreground",
        _ => "bg-primary border-primary text-primary-foreground",
    };
}
