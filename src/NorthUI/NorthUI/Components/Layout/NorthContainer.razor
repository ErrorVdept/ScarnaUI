@*
    Центрирующий контейнер с максимальной шириной и боковыми отступами —
    типовая обёртка страницы (аналог MudContainer).

    <NorthContainer MaxWidth="NorthContainerMaxWidth.Large">
        ...содержимое страницы...
    </NorthContainer>
*@
@namespace NorthUI.Components.Layout
@inherits NorthComponentBase

<div class="@Classes" style="@Style" @attributes="UserAttributes">
    @ChildContent
</div>

@code {
    /// <summary>Максимальная ширина контейнера.</summary>
    [Parameter] public NorthContainerMaxWidth MaxWidth { get; set; } = NorthContainerMaxWidth.Large;

    /// <summary>Растянуть на всю ширину без ограничения (эквивалент MaxWidth.False в MudBlazor).</summary>
    [Parameter] public bool Fluid { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string Classes => CssBuilder.Default("north-container mx-auto w-full px-4 sm:px-6 lg:px-8")
        .AddClass(MaxWidthClass, !Fluid)
        .AddClass(Class)
        .ToString();

    private string MaxWidthClass => MaxWidth switch
    {
        NorthContainerMaxWidth.Small => "max-w-3xl",
        NorthContainerMaxWidth.Medium => "max-w-5xl",
        NorthContainerMaxWidth.Large => "max-w-6xl",
        NorthContainerMaxWidth.ExtraLarge => "max-w-7xl",
        _ => "max-w-6xl",
    };
}
