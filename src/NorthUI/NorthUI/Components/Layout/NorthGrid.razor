@*
    12-колоночная CSS-grid сетка (аналог MudGrid). Используется вместе с NorthItem:

    <NorthGrid Spacing="4">
        <NorthItem Xs="12" Md="6"><NorthCard>...</NorthCard></NorthItem>
        <NorthItem Xs="12" Md="6"><NorthCard>...</NorthCard></NorthItem>
    </NorthGrid>
*@
@namespace NorthUI.Components.Layout
@inherits NorthComponentBase

<div class="@Classes" style="@CombinedStyle" @attributes="UserAttributes">
    @ChildContent
</div>

@code {
    /// <summary>Отступ между ячейками в шагах Tailwind-шкалы (1 = 0.25rem).</summary>
    [Parameter] public int Spacing { get; set; } = 4;

    /// <summary>Распределение свободного места вдоль строки (justify-content) — как Justify в MudBlazor. Заметно, только если ячейки не заполняют всю ширину.</summary>
    [Parameter] public NorthJustify Justify { get; set; } = NorthJustify.Start;

    /// <summary>Выравнивание содержимого ячеек по вертикали (align-items) — как AlignItems в MudBlazor.</summary>
    [Parameter] public NorthAlign Align { get; set; } = NorthAlign.Stretch;

    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string Classes => CssBuilder.Default("north-grid grid grid-cols-12")
        .AddClass(JustifyClass)
        .AddClass(AlignClass)
        .AddClass(Class)
        .ToString();

    private string JustifyClass => Justify switch
    {
        NorthJustify.End => "justify-end",
        NorthJustify.Center => "justify-center",
        NorthJustify.SpaceBetween => "justify-between",
        NorthJustify.SpaceAround => "justify-around",
        NorthJustify.SpaceEvenly => "justify-evenly",
        _ => "justify-start",
    };

    private string AlignClass => Align switch
    {
        NorthAlign.Start => "items-start",
        NorthAlign.End => "items-end",
        NorthAlign.Center => "items-center",
        NorthAlign.Baseline => "items-baseline",
        _ => "items-stretch",
    };

    private string CombinedStyle
    {
        get
        {
            // InvariantCulture — иначе на локалях с запятой как разделителем дробной части
            // получилось бы невалидное "gap: 0,5rem", и браузер тихо съедал бы отступы.
            var gap = $"gap: {(Spacing * 0.25).ToString(System.Globalization.CultureInfo.InvariantCulture)}rem;";
            return string.IsNullOrWhiteSpace(Style) ? gap : $"{gap} {Style}";
        }
    }
}
