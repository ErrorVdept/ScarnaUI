@*
    Выезжающая панель (боковое меню, панель фильтров). В отличие от NorthDialog —
    не сервис, а обычный декларативный компонент: кладётся в разметку (обычно в layout)
    и управляется через @bind-Open, как MudDrawer.

    <NorthDrawer @bind-Open="_menuOpen" Anchor="NorthDrawerAnchor.Left">
        <NorthNavLinks />
    </NorthDrawer>
    <NorthButton OnClick="() => _menuOpen = true">Меню</NorthButton>

    Variant задаёт, как панель ведёт себя относительно остального контента —
    см. NorthDrawerVariant. По умолчанию Temporary (текущее поведение — overlay
    с подложкой, ничего не раздвигает). Persistent/Mini не рисуют подложку и занимают
    реальное место в потоке (обычный flex-элемент с анимируемой шириной/высотой) —
    поэтому положите NorthDrawer рядом с содержимым внутри общего flex-контейнера,
    и оно "само" будет раздвигаться вместе с открытием/закрытием панели, без ручной
    синхронизации отступов в коде страницы:

    <div class="flex">
        <NorthDrawer @bind-Open="_open" Variant="NorthDrawerVariant.Persistent">...</NorthDrawer>
        <main class="flex-1">...</main>
    </div>
*@
@namespace NorthUI.Components.Layout
@inherits NorthComponentBase

@if (Variant == NorthDrawerVariant.Temporary && Open)
{
    <div class="fixed inset-0 z-[1050] bg-overlay/50 animate-north-fade-in" @onclick="HandleBackdropClick"></div>
}
<aside class="@Classes" style="@CombinedStyle" @attributes="UserAttributes">
    @ChildContent
</aside>

@code {
    /// <summary>Открыта ли панель. Поддерживает @bind-Open.</summary>
    [Parameter] public bool Open { get; set; }

    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    [Parameter] public NorthDrawerAnchor Anchor { get; set; } = NorthDrawerAnchor.Left;

    /// <summary>Temporary (по умолчанию) — overlay с подложкой. Persistent/Mini — занимает место в потоке, раздвигая соседние элементы.</summary>
    [Parameter] public NorthDrawerVariant Variant { get; set; } = NorthDrawerVariant.Temporary;

    /// <summary>Ширина панели (для Left/Right) — любое CSS-значение, например "280px".</summary>
    [Parameter] public string Width { get; set; } = "280px";

    /// <summary>Высота панели (для Top/Bottom) — любое CSS-значение.</summary>
    [Parameter] public string Height { get; set; } = "280px";

    /// <summary>Ширина/высота в закрытом состоянии у Variant.Mini (обычно под одни иконки). Для Temporary/Persistent не используется — там закрытое состояние либо за экраном, либо нулевого размера.</summary>
    [Parameter] public string MiniWidth { get; set; } = "72px";

    [Parameter] public bool CloseOnBackdropClick { get; set; } = true;

    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool IsHorizontal => Anchor is NorthDrawerAnchor.Left or NorthDrawerAnchor.Right;

    private async Task HandleBackdropClick()
    {
        if (!CloseOnBackdropClick)
        {
            return;
        }

        Open = false;

        if (OpenChanged.HasDelegate)
        {
            await OpenChanged.InvokeAsync(false);
        }
    }

    private string Classes => CssBuilder.Default("north-drawer bg-content1 overflow-y-auto overflow-x-hidden")
        .AddClass(TemporaryClasses, Variant == NorthDrawerVariant.Temporary)
        .AddClass(PersistentClasses, Variant != NorthDrawerVariant.Temporary)
        .AddClass(Class)
        .ToString();

    // Temporary: position:fixed поверх всего, слайд через translate — ничего не раздвигает,
    // поэтому и не нужно место в потоке документа.
    private string TemporaryClasses => CssBuilder.Default("fixed z-[1060] shadow-xl transition-transform duration-200 ease-out")
        .AddClass(AnchorClass)
        .ToString();

    private string AnchorClass => Anchor switch
    {
        NorthDrawerAnchor.Right => $"top-0 right-0 bottom-0 {(Open ? "translate-x-0" : "translate-x-full")}",
        NorthDrawerAnchor.Top => $"top-0 left-0 right-0 {(Open ? "translate-y-0" : "-translate-y-full")}",
        NorthDrawerAnchor.Bottom => $"bottom-0 left-0 right-0 {(Open ? "translate-y-0" : "translate-y-full")}",
        _ => $"top-0 left-0 bottom-0 {(Open ? "translate-x-0" : "-translate-x-full")}",
    };

    // Persistent/Mini: обычный flex-элемент (relative, shrink-0) — реальная ширина/высота
    // анимируется через CombinedStyle, поэтому соседи по флекс-контейнеру раздвигаются
    // сами, безо всякой ручной синхронизации отступов на стороне страницы.
    private string PersistentClasses => CssBuilder.Default("relative shrink-0 transition-[width,height] duration-200 ease-out")
        .AddClass(PersistentBorderClass)
        .ToString();

    private string PersistentBorderClass => Anchor switch
    {
        NorthDrawerAnchor.Right => "border-l border-divider",
        NorthDrawerAnchor.Top => "border-b border-divider",
        NorthDrawerAnchor.Bottom => "border-t border-divider",
        _ => "border-r border-divider",
    };

    private string CombinedStyle
    {
        get
        {
            var sizeStyle = Variant == NorthDrawerVariant.Temporary
                ? (IsHorizontal ? $"width: {Width};" : $"height: {Height};")
                : PersistentSizeStyle;

            return string.IsNullOrWhiteSpace(Style) ? sizeStyle : $"{sizeStyle} {Style}";
        }
    }

    private string PersistentSizeStyle
    {
        get
        {
            var collapsedSize = Variant == NorthDrawerVariant.Mini ? MiniWidth : "0px";
            var size = Open ? (IsHorizontal ? Width : Height) : collapsedSize;
            return IsHorizontal ? $"width: {size};" : $"height: {size};";
        }
    }
}
