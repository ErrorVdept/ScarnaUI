@*
    Линейная полоса прогресса. Determinate (по умолчанию) — конкретное значение
    Value/Max; Indeterminate — бегущая полоса для операций неизвестной длительности.

    <NorthProgress Label="Загрузка файла" Value="64" ShowValue="true" />
    <NorthProgress Indeterminate="true" />
*@
@namespace NorthUI.Components.DataDisplay
@inherits NorthComponentBase

<div class="north-progress-wrapper flex flex-col gap-1.5" style="@Style" @attributes="UserAttributes">
    @if (!string.IsNullOrEmpty(Label) || (ShowValue && !Indeterminate))
    {
        <div class="flex items-center justify-between text-sm">
            @if (!string.IsNullOrEmpty(Label))
            {
                <span class="font-medium text-foreground/80">@Label</span>
            }
            @if (ShowValue && !Indeterminate)
            {
                <span class="text-foreground/60">@PercentClamped.ToString("0")%</span>
            }
        </div>
    }
    <div class="@TrackClasses" role="progressbar" aria-valuemin="0" aria-valuemax="@Max" aria-valuenow="@(Indeterminate ? null : Value)">
        @if (Indeterminate)
        {
            <div class="@($"h-full w-1/3 rounded-north-full animate-north-progress-indeterminate {FillColorClass}")"></div>
        }
        else
        {
            <div class="@($"h-full rounded-north-full transition-[width] duration-300 ease-out {FillColorClass}")"
                 style="@($"width: {PercentClamped.ToString(System.Globalization.CultureInfo.InvariantCulture)}%")"></div>
        }
    </div>
</div>

@code {
    [Parameter] public string? Label { get; set; }

    [Parameter] public double Value { get; set; }

    [Parameter] public double Max { get; set; } = 100;

    /// <summary>Бегущая полоса вместо конкретного значения — для операций неизвестной длительности.</summary>
    [Parameter] public bool Indeterminate { get; set; }

    /// <summary>Показывать процент справа от подписи (игнорируется при Indeterminate).</summary>
    [Parameter] public bool ShowValue { get; set; }

    [Parameter] public NorthColor Color { get; set; } = NorthColor.Primary;

    [Parameter] public NorthSize Size { get; set; } = NorthSize.Medium;

    private double PercentClamped => Max <= 0 ? 0 : Math.Clamp(Value / Max * 100, 0, 100);

    private string TrackClasses => CssBuilder.Default("north-progress-track w-full overflow-hidden rounded-north-full bg-content2")
        .AddClass(SizeClass)
        .ToString();

    private string SizeClass => Size switch
    {
        NorthSize.Small => "h-1",
        NorthSize.Large => "h-3",
        _ => "h-2",
    };

    private string FillColorClass => Color switch
    {
        NorthColor.Secondary => "bg-secondary",
        NorthColor.Success => "bg-success",
        NorthColor.Warning => "bg-warning",
        NorthColor.Danger => "bg-danger",
        NorthColor.Default => "bg-default",
        _ => "bg-primary",
    };
}
