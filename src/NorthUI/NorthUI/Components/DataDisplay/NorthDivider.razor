@*
    Тонкая разделительная линия.

    <NorthDivider />
    <NorthDivider Vertical Class="h-6" />
*@
@namespace NorthUI.Components.DataDisplay
@inherits NorthComponentBase

<div class="@Classes" style="@Style" role="separator" aria-orientation="@(Vertical ? "vertical" : "horizontal")" @attributes="UserAttributes"></div>

@code {
    /// <summary>Вертикальная линия вместо горизонтальной (нужна явная высота через Class/Style у родителя).</summary>
    [Parameter] public bool Vertical { get; set; }

    private string Classes => CssBuilder.Default("north-divider shrink-0 bg-divider")
        .AddClass("w-full h-px", !Vertical)
        .AddClass("h-full w-px", Vertical)
        .AddClass(Class)
        .ToString();
}
