@*
    Маленькая компактная метка — легче NorthChip: меньше паддингов, без Size (всегда
    один компактный размер) и без встроенной кнопки закрытия. Для кликабельных тегов
    с крестиком/иконкой и выбором размера используйте NorthChip.

    <NorthTag>новое</NorthTag>
    <NorthTag Color="NorthColor.Success">активен</NorthTag>
*@
@namespace NorthUI.Components.DataDisplay
@inherits NorthComponentBase

<span class="@Classes" style="@Style" @attributes="UserAttributes">@ChildContent</span>

@code {
    [Parameter] public NorthColor Color { get; set; } = NorthColor.Default;

    [Parameter] public NorthVariant Variant { get; set; } = NorthVariant.Flat;

    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string Classes => CssBuilder.Default("north-tag inline-flex items-center h-5 px-1.5 rounded-north-sm text-[11px] font-medium leading-none whitespace-nowrap")
        .AddClass(NorthColorVariantClasses.Get(Color, Variant))
        .AddClass(Class)
        .ToString();
}
