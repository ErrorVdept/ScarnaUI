@*
    Один пункт меню NorthMenu. Клик вызывает OnClick и закрывает родительское меню.
*@
@namespace NorthUI.Components.Navigation

<button type="button" class="@Classes" role="menuitem" disabled="@Disabled" @onclick="HandleClickAsync">
    @StartContent
    <span class="flex-1 truncate">@ChildContent</span>
</button>

@code {
    [CascadingParameter] private NorthMenu? Menu { get; set; }

    /// <summary>Цвет текста пункта — используйте Danger для деструктивных действий (удаление и т.п.).</summary>
    [Parameter] public NorthColor Color { get; set; } = NorthColor.Default;

    [Parameter] public bool Disabled { get; set; }

    /// <summary>Иконка перед текстом.</summary>
    [Parameter] public RenderFragment? StartContent { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    [Parameter] public EventCallback OnClick { get; set; }

    private async Task HandleClickAsync()
    {
        if (Disabled)
        {
            return;
        }

        if (OnClick.HasDelegate)
        {
            await OnClick.InvokeAsync();
        }

        if (Menu is not null)
        {
            await Menu.CloseAsync();
        }
    }

    private string Classes => CssBuilder.Default("north-menu-item flex w-full items-center gap-2 rounded-north-sm px-3 py-2 text-left text-sm transition-colors")
        .AddClass(ColorClass)
        .AddClass("opacity-50 cursor-not-allowed", Disabled)
        .ToString();

    private string ColorClass => Color switch
    {
        NorthColor.Danger => "text-danger hover:bg-danger/10",
        _ => "text-foreground hover:bg-content2",
    };
}
