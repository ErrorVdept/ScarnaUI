@*
    Одна вкладка внутри NorthTabs. Сама панель не рисует заголовок — заголовок
    (кнопку с Text) рисует NorthTabs, а здесь только содержимое, которое видно,
    когда вкладка активна.
*@
@namespace NorthUI.Components.Navigation
@implements IDisposable

@if (IsActive)
{
    <div class="north-tab-panel">
        @ChildContent
    </div>
}

@code {
    [CascadingParameter] private NorthTabs? Parent { get; set; }

    /// <summary>Текст заголовка вкладки.</summary>
    [Parameter, EditorRequired] public string Text { get; set; } = string.Empty;

    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool IsActive => Parent?.IsSelected(this) ?? false;

    protected override void OnInitialized()
    {
        if (Parent is null)
        {
            throw new InvalidOperationException("NorthTabPanel должен использоваться внутри NorthTabs.");
        }

        Parent.Register(this);
    }

    public void Dispose() => Parent?.Unregister(this);
}
