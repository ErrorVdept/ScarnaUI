@*
    Вкладки с "pill"-фоном под активной вкладкой (не 2px-подчёркивание, как в MudBlazor —
    именно заливка фоном, см. INFO.md про причину переезда с MudBlazor на свою разметку).
    Фон плавно "переезжает" между вкладками (JS измеряет активную кнопку и двигает
    отдельный индикатор через transform — CSS-переходами позицию между произвольными
    flex-элементами не анимировать без знания их размеров).

    <NorthTabs @bind-SelectedIndex="_tab">
        <NorthTabPanel Text="Профиль">...</NorthTabPanel>
        <NorthTabPanel Text="Настройки">...</NorthTabPanel>
    </NorthTabs>
*@
@namespace NorthUI.Components.Navigation
@inherits NorthComponentBase
@implements IAsyncDisposable
@inject IJSRuntime JSRuntime

<div class="@Classes" style="@Style" @attributes="UserAttributes">
    <div @ref="_trackElement" class="@TrackClasses">
        <span class="north-tabs__indicator absolute inset-y-1 left-0 rounded-north-full bg-content1 shadow-md transition-[transform,width] duration-200 ease-out" style="width:0"></span>
        @foreach (var panel in _panels)
        {
            <button type="button" class="@HeaderClasses(panel)" data-tab-active="@(IsSelected(panel) ? "true" : "false")" @onclick="() => SelectAsync(panel)">
                @panel.Text
            </button>
        }
    </div>
    <div class="north-tabs__content mt-3">
        <CascadingValue Value="this" IsFixed="false">
            @ChildContent
        </CascadingValue>
    </div>
</div>

@code {
    private const string ModulePath = "./_content/NorthUI/js/north/tabs.js";

    private readonly List<NorthTabPanel> _panels = new();
    private ElementReference _trackElement;
    private IJSObjectReference? _module;

    /// <summary>Индекс активной вкладки. Поддерживает @bind-SelectedIndex.</summary>
    [Parameter] public int SelectedIndex { get; set; }

    [Parameter] public EventCallback<int> SelectedIndexChanged { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Выравнивание заголовков вдоль дорожки — как AlignItems в MudBlazor, но здесь это распределение по главной оси (justify-content), т.к. поперечная и так центрирована. Заметно, только если FullWidth="false" и заголовки не заполняют всю ширину.</summary>
    [Parameter] public NorthJustify Justify { get; set; } = NorthJustify.Start;

    /// <summary>Растянуть заголовки на всю ширину дорожки поровну (вместо ширины по содержимому).</summary>
    [Parameter] public bool FullWidth { get; set; }

    /// <summary>Вызывается панелью в OnInitialized, чтобы попасть в список заголовков.</summary>
    internal void Register(NorthTabPanel panel)
    {
        if (!_panels.Contains(panel))
        {
            _panels.Add(panel);
            StateHasChanged();
        }
    }

    internal void Unregister(NorthTabPanel panel)
    {
        if (_panels.Remove(panel))
        {
            StateHasChanged();
        }
    }

    internal bool IsSelected(NorthTabPanel panel) => _panels.IndexOf(panel) == SelectedIndex;

    private async Task SelectAsync(NorthTabPanel panel)
    {
        var index = _panels.IndexOf(panel);
        if (index < 0 || index == SelectedIndex)
        {
            return;
        }

        SelectedIndex = index;

        if (SelectedIndexChanged.HasDelegate)
        {
            await SelectedIndexChanged.InvokeAsync(index);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Пересчитываем позицию индикатора на каждом рендере — дёшево (пара чтений
        // layout-свойств), а вкладок обычно немного. Так индикатор остаётся на месте
        // и после смены заголовков (Register/Unregister), и после resize контейнера.
        _module ??= await JSRuntime.InvokeAsync<IJSObjectReference>("import", ModulePath);
        await _module.InvokeVoidAsync("syncIndicator", _trackElement);
    }

    private string HeaderClasses(NorthTabPanel panel) => CssBuilder.Default("relative z-10 whitespace-nowrap rounded-north-full px-4 py-1.5 text-sm font-medium transition-colors")
        .AddClass("text-foreground", IsSelected(panel))
        .AddClass("text-foreground/60 hover:text-foreground", !IsSelected(panel))
        .ToString();

    private string Classes => CssBuilder.Default("north-tabs").AddClass(Class).ToString();

    private string TrackClasses => CssBuilder.Default("north-tabs__track relative flex items-center gap-1 rounded-north-full bg-content2 p-1")
        .AddClass("w-full", FullWidth)
        .AddClass("inline-flex", !FullWidth)
        .AddClass("[&>button]:flex-1", FullWidth)
        .AddClass(JustifyClass)
        .ToString();

    private string JustifyClass => Justify switch
    {
        NorthJustify.End => "justify-end",
        NorthJustify.Center => "justify-center",
        NorthJustify.SpaceBetween => "justify-between",
        NorthJustify.SpaceAround => "justify-around",
        NorthJustify.SpaceEvenly => "justify-evenly",
        _ => "justify-start",
    };

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // circuit уже закрыт — освобождать нечего
            }
        }
    }
}
