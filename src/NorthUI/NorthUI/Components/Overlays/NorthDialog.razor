@*
    Готовый "скелет" содержимого диалога: заголовок + кнопка закрытия + тело + панель
    действий. Используется ВНУТРИ компонента, который вы показываете через
    INorthDialogService.ShowAsync&lt;TComponent&gt;() — не путать с NorthDialogProvider.

    Пример (MyConfirmDialog.razor):

    <NorthDialog Title="Удалить файл?">
        <DialogContent>Это действие необратимо.</DialogContent>
        <DialogActions>
            <NorthButton Variant="NorthVariant.Light" OnClick="Cancel">Отмена</NorthButton>
            <NorthButton Color="NorthColor.Danger" OnClick="Confirm">Удалить</NorthButton>
        </DialogActions>
    </NorthDialog>

    @code {
        [CascadingParameter] private NorthDialogReference DialogReference { get; set; } = default!;
        private void Cancel() => DialogReference.Close(NorthDialogResult.Cancel());
        private void Confirm() => DialogReference.Close(NorthDialogResult.Ok());
    }
*@
@namespace NorthUI.Components.Overlays
@using NorthUI.Services

<div class="north-dialog flex flex-col">
    @if (!string.IsNullOrEmpty(Title) || TitleContent is not null)
    {
        <div class="north-dialog__header flex items-center justify-between gap-4 px-6 py-4 border-b border-divider">
            <div class="text-lg font-semibold text-foreground">
                @if (TitleContent is not null)
                {
                    @TitleContent
                }
                else
                {
                    @Title
                }
            </div>
            @if (ShowCloseButton)
            {
                <button type="button"
                        class="north-dialog__close rounded-north-sm p-1 text-foreground/60 hover:bg-content2 hover:text-foreground transition-colors"
                        @onclick="HandleCloseButtonClick"
                        aria-label="Закрыть">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="18" y1="6" x2="6" y2="18" />
                        <line x1="6" y1="6" x2="18" y2="18" />
                    </svg>
                </button>
            }
        </div>
    }

    <div class="north-dialog__body px-6 py-4 text-foreground/90">
        @DialogContent
    </div>

    @if (DialogActions is not null)
    {
        <div class="north-dialog__footer flex items-center justify-end gap-2 px-6 py-4 border-t border-divider">
            @DialogActions
        </div>
    }
</div>

@code {
    /// <summary>Даётся провайдером — ссылка на текущий диалог, нужна, чтобы его закрыть.</summary>
    [CascadingParameter]
    public NorthDialogReference DialogReference { get; set; } = default!;

    /// <summary>Простой текстовый заголовок. Для сложной разметки используйте TitleContent.</summary>
    [Parameter] public string? Title { get; set; }

    [Parameter] public RenderFragment? TitleContent { get; set; }

    /// <summary>Показывать ли крестик закрытия в заголовке.</summary>
    [Parameter] public bool ShowCloseButton { get; set; } = true;

    [Parameter] public RenderFragment? DialogContent { get; set; }

    [Parameter] public RenderFragment? DialogActions { get; set; }

    private void HandleCloseButtonClick() => DialogReference.Close(NorthDialogResult.Cancel());
}
