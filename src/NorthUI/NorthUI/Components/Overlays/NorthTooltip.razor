@*
    Всплывающая подсказка по наведению/фокусу. Построена на NorthPopover —
    живой пример того, как декларативные компоненты используют примитив поповера.

    <NorthTooltip Text="Сохранить изменения">
        <NorthButton>💾</NorthButton>
    </NorthTooltip>
*@
@namespace NorthUI.Components.Overlays

<span @ref="_anchor" class="north-tooltip-anchor inline-flex" @onmouseenter="Show" @onmouseleave="Hide" @onfocusin="Show" @onfocusout="Hide">
    @ChildContent
</span>

<NorthPopover Open="_open" Anchor="_anchor" Position="Position" OffsetPx="6" CloseOnOutsideClick="false">
    <div class="pointer-events-none rounded-north-sm bg-foreground px-2.5 py-1.5 text-xs font-medium text-background shadow-lg">
        @Text
    </div>
</NorthPopover>

@code {
    private ElementReference _anchor;
    private bool _open;

    /// <summary>Текст подсказки.</summary>
    [Parameter, EditorRequired] public string Text { get; set; } = string.Empty;

    /// <summary>Позиция подсказки относительно якоря. По умолчанию — сверху по центру.</summary>
    [Parameter] public NorthPosition Position { get; set; } = NorthPosition.Top;

    /// <summary>Элемент, над которым при наведении/фокусе появляется подсказка.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private void Show() => _open = true;

    private void Hide() => _open = false;
}
