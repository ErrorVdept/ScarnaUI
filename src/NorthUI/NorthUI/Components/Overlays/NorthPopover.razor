@*
    Переиспользуемая "плавающая поверхность", привязанная к якорному элементу.
    На ней строятся Select/Autocomplete, Menu, Tooltip, DatePicker и т.п. — сами эти
    компоненты не занимаются позиционированием, они просто оборачивают своё содержимое
    в NorthPopover и управляют параметром Open.

    Пример использования внутри другого компонента:
    <div @ref="_anchor">...trigger...</div>
    <NorthPopover Open="_open" Anchor="_anchor" OnClose="@(() => _open = false)">
        <div class="p-2">Содержимое поповера</div>
    </NorthPopover>

    Сам NorthPopover ничего не рендерит непосредственно в месте использования —
    содержимое регистрируется в NorthPopoverProvider (см. Surface() ниже) и физически
    рендерится там, в конце документа.
*@
@namespace NorthUI.Components.Overlays
@implements IDisposable
@inject IJSRuntime JSRuntime

@code {
    private const string ModulePath = "./_content/NorthUI/js/north/popover.js";

    /// <summary>Открыт ли поповер.</summary>
    [Parameter] public bool Open { get; set; }

    /// <summary>Якорный элемент, относительно которого позиционируется поповер (захватывается вызывающим компонентом через @ref).</summary>
    [Parameter, EditorRequired] public ElementReference Anchor { get; set; }

    /// <summary>Содержимое поповера.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Позиция поповера относительно якоря (сторона + выравнивание одним значением).</summary>
    [Parameter] public NorthPosition Position { get; set; } = NorthPosition.BottomStart;

    /// <summary>Отступ от якоря в пикселях.</summary>
    [Parameter] public int OffsetPx { get; set; } = 8;

    /// <summary>Закрывать ли поповер по клику вне его и вне якоря.</summary>
    [Parameter] public bool CloseOnOutsideClick { get; set; } = true;

    /// <summary>Дополнительные CSS-классы на контейнер поверхности.</summary>
    [Parameter] public string? SurfaceClass { get; set; }

    /// <summary>Растянуть поверхность на ширину якоря (родительского элемента) — например, чтобы выпадающий список Select был не уже, чем поле.</summary>
    [Parameter] public bool IsParentFullSize { get; set; }

    /// <summary>Вызывается при клике снаружи или нажатии Escape — сам поповер себя не закрывает, решение остаётся за вызывающим кодом.</summary>
    [Parameter] public EventCallback OnClose { get; set; }

    [CascadingParameter] private NorthPopoverProvider? Provider { get; set; }

    private readonly Guid _id = Guid.NewGuid();
    private ElementReference _surfaceElement;
    private DotNetObjectReference<NorthPopover>? _selfRef;
    private IJSObjectReference? _module;
    private bool _sessionActive;
    private bool _wasOpen;

    protected override void OnParametersSet()
    {
        if (Provider is null)
        {
            throw new InvalidOperationException(
                "NorthPopover требует NorthPopoverProvider выше по дереву компонентов. " +
                "Добавьте <NorthPopoverProvider> в корень layout приложения.");
        }

        if (Open)
        {
            // Перерегистрируем фрагмент и при первом открытии, и при каждом обновлении
            // содержимого — Blazor сравнит дерево и обновит только изменившееся.
            Provider.Register(_id, Surface());
        }
        else if (_wasOpen)
        {
            Provider.Unregister(_id);
            _sessionActive = false;
            _ = CloseInteropAsync();
        }

        _wasOpen = Open;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!Open)
        {
            return;
        }

        _module ??= await JSRuntime.InvokeAsync<IJSObjectReference>("import", ModulePath);

        if (!_sessionActive)
        {
            _selfRef ??= DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync(
                "open", _id.ToString(), Anchor, _surfaceElement,
                SideToken, AlignToken, OffsetPx, CloseOnOutsideClick, _selfRef, IsParentFullSize);
            _sessionActive = true;
        }
        else
        {
            await _module.InvokeVoidAsync("position", _id.ToString(), Anchor, _surfaceElement, SideToken, AlignToken, OffsetPx, IsParentFullSize);
        }
    }

    private string SideToken => Position.ToSideAlign().Side.ToString().ToLowerInvariant();
    private string AlignToken => Position.ToSideAlign().Align.ToString().ToLowerInvariant();

    /// <summary>Вызывается из popover.js по клику вне поповера/якоря.</summary>
    [JSInvokable]
    public Task OnOutsideInteractionAsync() => OnClose.HasDelegate ? OnClose.InvokeAsync() : Task.CompletedTask;

    /// <summary>Вызывается из popover.js по нажатию Escape.</summary>
    [JSInvokable]
    public Task OnEscapeAsync() => OnClose.HasDelegate ? OnClose.InvokeAsync() : Task.CompletedTask;

    private async Task CloseInteropAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("close", _id.ToString());
            }
            catch (JSDisconnectedException)
            {
                // circuit уже закрыт — закрывать нечего
            }
        }
    }

    /// <summary>
    /// Фрагмент, который физически рендерится внутри NorthPopoverProvider (портал).
    ///
    /// position:fixed прописан здесь же, в разметке, а не только выставляется из JS —
    /// это принципиально: пока элемент в обычном потоке (block-уровня внутри
    /// position:fixed родителя-портала), он растягивается на всю ширину этого родителя,
    /// и JS при первом вызове position() измеряет popoverRect ИМЕННО в этом состоянии
    /// (getBoundingClientRect идёт раньше простановки position:fixed в самом JS).
    /// Из-за этого первое открытие вычисляло позицию по неверным (растянутым на весь
    /// экран, с иначе перенесённым текстом) размерам — а после скролла/resize, когда JS
    /// пересчитывал position() уже К УЖЕ position:fixed элементу, размеры получались
    /// верными, и поповер "запрыгивал" на своё настоящее место. Проставив position:fixed
    /// сразу в разметке, JS с первого раза измеряет те же размеры, что увидит пользователь.
    ///
    /// visibility:hidden держится до тех пор, пока JS не вычислит и не проставит
    /// координаты — это убирает "мигание" поповера в углу экрана на первом кадре.
    /// </summary>
    private RenderFragment Surface() =>
    @<div @ref="_surfaceElement"
          class="@($"north-popover-surface pointer-events-auto {SurfaceClass}")"
          style="visibility:hidden; position:fixed; top:0; left:0;">
        @ChildContent
    </div>;

    public void Dispose()
    {
        Provider?.Unregister(_id);
        _selfRef?.Dispose();
        if (_module is not null)
        {
            _ = _module.InvokeVoidAsync("close", _id.ToString());
        }
    }
}
