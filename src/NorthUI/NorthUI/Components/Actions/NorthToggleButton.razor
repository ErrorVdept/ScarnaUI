@*
    Кнопка-переключатель — как чекбокс (bool), но выглядит как обычная кнопка,
    которая "нажата"/"не нажата" (аналог MudToggleIconButton, только с произвольным
    содержимым, не только иконкой).

    <NorthToggleButton @bind-Value="_bold">Ж</NorthToggleButton>
*@
@namespace NorthUI.Components.Actions
@inherits NorthFormComponentBase<bool>

<button type="button" class="@Classes" disabled="@Disabled" aria-pressed="@Value" @onclick="ToggleAsync">
    @ChildContent
</button>

@code {
    [Parameter] public NorthColor Color { get; set; } = NorthColor.Primary;

    [Parameter] public NorthSize Size { get; set; } = NorthSize.Medium;

    [Parameter] public NorthRadius Radius { get; set; } = NorthRadius.Medium;

    [Parameter] public bool Disabled { get; set; }

    /// <summary>Обводка в невключённом состоянии (по умолчанию — да, чтобы кнопка была заметна на фоне).</summary>
    [Parameter] public bool Bordered { get; set; } = true;

    [Parameter] public RenderFragment? ChildContent { get; set; }

    private Task ToggleAsync() => Disabled ? Task.CompletedTask : SetValueAsync(!Value);

    private string Classes => CssBuilder.Default("north-toggle-btn inline-flex items-center justify-center font-medium select-none transition-[background-color,border-color,color,transform] duration-150 active:scale-[0.97] disabled:opacity-50 disabled:pointer-events-none")
        .AddClass(SizeClass)
        .AddClass(NorthColorVariantClasses.Radius(Radius))
        .AddClass(Value ? NorthColorVariantClasses.Get(Color, NorthVariant.Solid) : "bg-transparent text-foreground/70 hover:bg-content2")
        .AddClass("border border-default", Bordered && !Value)
        .ToString();

    private string SizeClass => Size switch
    {
        NorthSize.Small => "h-8 px-3 text-sm",
        NorthSize.Large => "h-12 px-6 text-base",
        _ => "h-10 px-4 text-sm",
    };
}
