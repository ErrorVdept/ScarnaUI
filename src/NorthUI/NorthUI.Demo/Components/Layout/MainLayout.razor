@inherits LayoutComponentBase
@inject INavigator Navigator

<NorthThemeProvider>
    <NorthPopoverProvider>
        <div class="min-h-screen bg-background text-foreground">
            <NorthNavBar>
                <a href="/" class="text-lg font-semibold text-foreground">North<span class="text-primary">UI</span></a>
                <NorthStack Row="true" Spacing="6" Align="NorthAlign.Center">
                    <NavLink href="/" Match="NavLinkMatch.All" class="text-sm text-foreground/70 hover:text-foreground">Обзор</NavLink>
                    <NavLink href="/getting-started" class="text-sm text-foreground/70 hover:text-foreground">Установка</NavLink>
                    <NavLink href="/components" class="text-sm text-foreground/70 hover:text-foreground">Компоненты</NavLink>
                    <NavLink href="/componentlib" class="text-sm text-foreground/70 hover:text-foreground">Документация</NavLink>

                    <NorthMenu>
                        <Trigger>
                            <span class="inline-flex cursor-pointer items-center gap-1 text-sm text-foreground/70 hover:text-foreground">
                                Примеры
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9" /></svg>
                            </span>
                        </Trigger>
                        <MenuContent>
                            <NorthMenuItem OnClick='() => Navigator.NavigateTo("/showcase/stackoverflow")'>
                                <StartContent>
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2" /><line x1="2" y1="9" x2="22" y2="9" /></svg>
                                </StartContent>
                                <ChildContent>Stack Overflow</ChildContent>
                            </NorthMenuItem>
                            <NorthMenuItem OnClick='() => Navigator.NavigateTo("/showcase/tasks")'>
                                <StartContent>
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" /><rect x="14" y="3" width="7" height="7" /><rect x="14" y="14" width="7" height="7" /><rect x="3" y="14" width="7" height="7" /></svg>
                                </StartContent>
                                <ChildContent>Доска задач</ChildContent>
                            </NorthMenuItem>
                            <NorthDivider Class="my-1" />
                            <NorthMenuItem OnClick='() => Navigator.NavigateTo("/showcase/main-layout")'>
                                <StartContent>
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" /><line x1="9" y1="3" x2="9" y2="21" /></svg>
                                </StartContent>
                                <ChildContent>Layout wireframes</ChildContent>
                            </NorthMenuItem>
                        </MenuContent>
                    </NorthMenu>

                    <NorthThemeSwitch />
                </NorthStack>
            </NorthNavBar>

            <main class="py-8">
                @Body
            </main>
        </div>
    </NorthPopoverProvider>

    <NorthDialogProvider />
    <NorthSnackbarProvider />
</NorthThemeProvider>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
