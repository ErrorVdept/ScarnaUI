@page "/componentlib/list"

<DocPage Title="NorthList" Lead="Список с опциональным выбором — SelectionMode.None (просто кликабельные пункты), .Single или .Multiple."
         Files="@(new[] { "Components/DataDisplay/NorthList.razor", "Components/DataDisplay/NorthListItem.razor", "Components/DataDisplay/NorthListEnums.cs" })">

    <DocSection Title="Single" Description="@@bind-Value — один выбранный пункт." Row="false" Code="@SingleCode">
        <NorthList SelectionMode="NorthListSelectionMode.Single" @bind-Value="_selected" Bordered="true">
            <NorthListItem Value="@("inbox")">Входящие</NorthListItem>
            <NorthListItem Value="@("sent")">Отправленные</NorthListItem>
            <NorthListItem Value="@("trash")">Корзина</NorthListItem>
        </NorthList>
        <span class="text-sm text-foreground/60">Выбрано: @(_selected ?? "—")</span>
    </DocSection>

    <DocSection Title="Multiple" Description="@@bind-SelectedValues — несколько выбранных пунктов." Row="false" Code="@MultipleCode">
        <NorthList SelectionMode="NorthListSelectionMode.Multiple" @bind-SelectedValues="_selectedFruits" Bordered="true">
            <NorthListItem Value="@("apple")">Яблоко</NorthListItem>
            <NorthListItem Value="@("banana")">Банан</NorthListItem>
            <NorthListItem Value="@("cherry")">Вишня</NorthListItem>
        </NorthList>
        <span class="text-sm text-foreground/60">Выбрано: @string.Join(", ", _selectedFruits)</span>
    </DocSection>

    <DocSection Title="None — просто кликабельный список" Description="TValue указывается явно, т.к. ни Value, ни SelectedValues не заданы." Row="false" Code="@NoneCode">
        <NorthList TValue="string" SelectionMode="NorthListSelectionMode.None" Bordered="true">
            <NorthListItem Value="@("home")" OnClick='() => _lastClicked = "Главная"'>Главная</NorthListItem>
            <NorthListItem Value="@("orders")" OnClick='() => _lastClicked = "Заказы"'>Заказы</NorthListItem>
            <NorthListItem Value="@("settings")" OnClick='() => _lastClicked = "Настройки"'>Настройки</NorthListItem>
        </NorthList>
        <span class="text-sm text-foreground/60">Последний клик: @(_lastClicked ?? "—")</span>
    </DocSection>

    <DocApiTable Rows="@_listRows" />
    <DocApiTable Title="Параметры NorthListItem" Rows="@_itemRows" />

</DocPage>

@code {
    private string? _selected = "inbox";
    private IReadOnlyCollection<string> _selectedFruits = new List<string> { "banana" };
    private string? _lastClicked;

    private const string SingleCode =
        """
        <NorthList SelectionMode="NorthListSelectionMode.Single" @bind-Value="_selected">
            <NorthListItem Value="@("inbox")">Входящие</NorthListItem>
            <NorthListItem Value="@("sent")">Отправленные</NorthListItem>
        </NorthList>
        """;

    private const string MultipleCode =
        """
        <NorthList SelectionMode="NorthListSelectionMode.Multiple" @bind-SelectedValues="_selectedFruits">
            <NorthListItem Value="@("apple")">Яблоко</NorthListItem>
            <NorthListItem Value="@("banana")">Банан</NorthListItem>
        </NorthList>
        """;

    private const string NoneCode =
        """
        <NorthList TValue="string" SelectionMode="NorthListSelectionMode.None">
            <NorthListItem Value="@("home")" OnClick="GoHome">Главная</NorthListItem>
        </NorthList>
        """;

    private readonly List<DocApiRow> _listRows = new()
    {
        new("SelectionMode", "NorthListSelectionMode", "None", "None/Single/Multiple"),
        new("Value / ValueChanged", "TValue? / ...", "—", "Выбранное значение при Single"),
        new("SelectedValues / SelectedValuesChanged", "IReadOnlyCollection<TValue>? / ...", "—", "Выбранные значения при Multiple"),
        new("Bordered", "bool", "false", "Обводка списка"),
        new("Density", "NorthDensity", "Normal", "Зарезервировано для компактного режима"),
        new("ChildContent", "RenderFragment?", "—", "Набор NorthListItem"),
    };

    private readonly List<DocApiRow> _itemRows = new()
    {
        new("Value", "TValue", "—", "Обязательный. Значение пункта"),
        new("StartContent", "RenderFragment?", "—", "Иконка/аватар перед текстом"),
        new("ChildContent", "RenderFragment?", "—", "Содержимое пункта"),
        new("Disabled", "bool", "false", "—"),
        new("OnClick", "EventCallback", "—", "Доп. обработчик клика — вызывается при любом SelectionMode, в т.ч. None"),
    };
}
