@page "/componentlib/table"

<DocPage Title="NorthTable" Lead="Обёртка стилизации над обычной HTML-таблицей — аналог MudSimpleTable. Разметку thead/tbody вы пишете сами."
         Files="@(new[] { "Components/DataDisplay/NorthTable.razor" })">

    <DocSection Title="Базовое использование" Description="Hover — подсветка строки при наведении." Row="false" Code="@BasicCode">
        <NorthTable Hover="true">
            <thead>
                <tr><th>Имя</th><th>Email</th><th>Статус</th></tr>
            </thead>
            <tbody>
                <tr><td>Иван Петров</td><td>ivan@example.com</td><td><NorthChip Color="NorthColor.Success" Size="NorthSize.Small">Активен</NorthChip></td></tr>
                <tr><td>Анна Смирнова</td><td>anna@example.com</td><td><NorthChip Color="NorthColor.Warning" Size="NorthSize.Small">Ожидает</NorthChip></td></tr>
                <tr><td>Пётр Иванов</td><td>petr@example.com</td><td><NorthChip Color="NorthColor.Default" Size="NorthSize.Small">Неактивен</NorthChip></td></tr>
            </tbody>
        </NorthTable>
    </DocSection>

    <DocSection Title="Striped и Dense" Row="false" Code="@StripedCode">
        <NorthTable Striped="true" Density="NorthDensity.Dense">
            <thead>
                <tr><th>Товар</th><th>Кол-во</th><th>Цена</th></tr>
            </thead>
            <tbody>
                <tr><td>Кроссовки</td><td>1</td><td>4 990 ₽</td></tr>
                <tr><td>Носки</td><td>3</td><td>590 ₽</td></tr>
                <tr><td>Шнурки</td><td>2</td><td>190 ₽</td></tr>
            </tbody>
        </NorthTable>
    </DocSection>

    <DocApiTable Rows="@_rows" />

</DocPage>

@code {
    private const string BasicCode =
        """
        <NorthTable Hover="true">
            <thead>
                <tr><th>Имя</th><th>Email</th><th>Статус</th></tr>
            </thead>
            <tbody>
                <tr>
                    <td>Иван Петров</td>
                    <td>ivan@example.com</td>
                    <td><NorthChip Color="NorthColor.Success" Size="NorthSize.Small">Активен</NorthChip></td>
                </tr>
            </tbody>
        </NorthTable>
        """;

    private const string StripedCode =
        """
        <NorthTable Striped="true" Density="NorthDensity.Dense">
            <thead>
                <tr><th>Товар</th><th>Кол-во</th><th>Цена</th></tr>
            </thead>
            <tbody>
                <tr><td>Кроссовки</td><td>1</td><td>4 990 ₽</td></tr>
            </tbody>
        </NorthTable>
        """;

    private readonly List<DocApiRow> _rows = new()
    {
        new("Hover", "bool", "true", "Подсветка строки <tbody> при наведении"),
        new("Striped", "bool", "false", "Зебра — чередующийся фон чётных строк"),
        new("Bordered", "bool", "true", "Обводка контейнера таблицы"),
        new("Density", "NorthDensity", "Normal", "Dense — компактные отступы ячеек, для больших наборов данных"),
        new("ChildContent", "RenderFragment?", "—", "Произвольная разметка thead/tbody"),
    };
}
