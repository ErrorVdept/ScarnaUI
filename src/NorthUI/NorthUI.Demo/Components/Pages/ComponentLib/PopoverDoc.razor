@page "/componentlib/popover"

<DocPage Title="NorthPopover" Lead="Низкоуровневый примитив позиционирования 'плавающей поверхности' относительно якорного элемента — на нём построены NorthTooltip, NorthMenu, NorthSelect."
         Files="@(new[] { "Components/Overlays/NorthPopover.razor", "Components/Overlays/NorthPopoverProvider.razor" })">

    <DocSection Title="Пример" Description="NorthPopoverProvider уже есть в MainLayout, отдельно подключать не нужно. Якорь захватывается через @@ref." Code="@ExampleCode">
        <div @ref="_anchor" @onclick="() => _open = !_open" class="cursor-pointer">
            <NorthButton Variant="NorthVariant.Bordered">Открыть поповер</NorthButton>
        </div>
        <NorthPopover Open="_open" Anchor="_anchor" Position="NorthPosition.BottomStart" OnClose="() => _open = false">
            <div class="rounded-north-md border border-divider bg-content1 p-3 shadow-lg">
                <p class="text-sm text-foreground/80">Содержимое поповера</p>
            </div>
        </NorthPopover>
    </DocSection>

    <DocApiTable Rows="@_rows" />

</DocPage>

@code {
    private ElementReference _anchor;
    private bool _open;

    private const string ExampleCode =
        """
        <div @ref="_anchor" @onclick="() => _open = !_open">Открыть поповер</div>

        <NorthPopover Open="_open" Anchor="_anchor" Position="NorthPosition.BottomStart"
                      OnClose="() => _open = false">
            <div class="p-2 bg-content1 rounded-north-md shadow-lg">Содержимое</div>
        </NorthPopover>

        @code {
            private ElementReference _anchor;
            private bool _open;
        }
        """;

    private readonly List<DocApiRow> _rows = new()
    {
        new("Open", "bool", "—", "Открыт ли поповер"),
        new("Anchor", "ElementReference", "—", "Обязательный. Якорный элемент (захватывается вызывающим компонентом через @ref)"),
        new("ChildContent", "RenderFragment?", "—", "Содержимое поповера"),
        new("Position", "NorthPosition", "BottomStart", "Единое свойство позиции — сторона + выравнивание, 12 значений"),
        new("IsParentFullSize", "bool", "false", "Растянуть поверхность на ширину якоря (родителя)"),
        new("OffsetPx", "int", "8", "Отступ от якоря в пикселях"),
        new("CloseOnOutsideClick", "bool", "true", "Закрывать по клику вне поповера/якоря"),
        new("SurfaceClass", "string?", "—", "Доп. CSS-классы на контейнер поверхности"),
        new("OnClose", "EventCallback", "—", "Клик снаружи или Escape — сам поповер себя не закрывает, решение остаётся за вызывающим кодом"),
    };
}
