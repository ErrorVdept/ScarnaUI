@page "/componentlib/input"

<DocPage Title="NorthInput" Lead="Однострочное текстовое поле с поддержкой @@bind-Value и подсветкой ошибок валидации."
         Files="@(new[] { "Components/Forms/NorthInput.razor" })">

    <DocSection Title="Интерактивный пример" Description="Значение обновляется по мере ввода." Code="@InteractiveCode" Row="false">
        <NorthInput Label="Имя" Placeholder="Введите имя" @bind-Value="_name" HelperText="Как к вам обращаться" />
        <span class="text-sm text-foreground/60">Значение: @_name</span>
    </DocSection>

    <DocSection Title="Варианты и размеры" Code="@VariantsCode">
        <NorthInput Placeholder="Bordered (по умолчанию)" Class="w-48" />
        <NorthInput Placeholder="Flat" Variant="NorthVariant.Flat" Class="w-48" />
        <NorthInput Placeholder="Small" Size="NorthSize.Small" Class="w-40" />
        <NorthInput Placeholder="Large" Size="NorthSize.Large" Class="w-40" />
        <NorthInput Placeholder="Dense" Density="NorthDensity.Dense" Class="w-40" />
    </DocSection>

    <DocSection Title="Состояния" Code="@StatesCode">
        <NorthInput Value="Только чтение" ReadOnly="true" Class="w-48" />
        <NorthInput Placeholder="Отключено" Disabled="true" Class="w-48" />
        <NorthInput Label="Купон" Value="ABC" Error="true" ErrorText="Купон не найден" Class="w-48" />
    </DocSection>

    <DocApiTable Rows="@_rows" />

</DocPage>

@code {
    private string? _name;

    private const string InteractiveCode =
        """
        <NorthInput Label="Имя" Placeholder="Введите имя" @bind-Value="_name" HelperText="Как к вам обращаться" />
        <span class="text-sm text-foreground/60">Значение: @_name</span>

        @code {
            private string? _name;
        }
        """;

    private const string VariantsCode =
        """
        <NorthInput Placeholder="Bordered (по умолчанию)" />
        <NorthInput Placeholder="Flat" Variant="NorthVariant.Flat" />
        <NorthInput Placeholder="Small" Size="NorthSize.Small" />
        <NorthInput Placeholder="Large" Size="NorthSize.Large" />
        <NorthInput Placeholder="Dense" Density="NorthDensity.Dense" />
        """;

    private const string StatesCode =
        """
        <NorthInput Value="Только чтение" ReadOnly="true" />
        <NorthInput Placeholder="Отключено" Disabled="true" />
        <NorthInput Label="Купон" Value="ABC" Error="true" ErrorText="Купон не найден" />
        """;

    private readonly List<DocApiRow> _rows = new()
    {
        new("Value / ValueChanged / ValueExpression", "string?", "—", "Механика @bind-Value"),
        new("Label", "string?", "—", "Подпись над полем"),
        new("Placeholder", "string?", "—", "Плейсхолдер"),
        new("HelperText", "string?", "—", "Подсказка под полем (скрывается при ошибке)"),
        new("ErrorText", "string?", "—", "Текст ошибки под полем"),
        new("Error", "bool", "false", "Принудительно пометить поле невалидным"),
        new("Type", "string", "\"text\"", "HTML type (text/email/password/number...)"),
        new("Disabled", "bool", "false", "—"),
        new("ReadOnly", "bool", "false", "—"),
        new("Variant", "NorthVariant", "Bordered", "Bordered — контур на прозрачном фоне, Flat — заливка без контура"),
        new("Bordered", "bool", "true", "Показывать ли контур поля, независимо от Variant"),
        new("Size", "NorthSize", "Medium", "Small/Medium/Large"),
        new("Density", "NorthDensity", "Normal", "Normal — обычная высота, Dense — уменьшенная для плотных панелей"),
        new("Radius", "NorthRadius", "Medium", "Радиус поля"),
        new("StartContent", "RenderFragment?", "—", "Иконка/префикс перед полем"),
        new("EndContent", "RenderFragment?", "—", "Иконка/кнопка после поля"),
    };
}
