@page "/componentlib/navbar"

<DocPage Title="NorthNavBar" Lead="Верхняя панель приложения — задаёт высоту, подложку и границу снизу; содержимое произвольное (логотип, ссылки, действия)."
         Files="@(new[] { "Components/Layout/NorthNavBar.razor" })">

    <DocSection Title="Пример" Description="Эта страница уже использует NorthNavBar в MainLayout — здесь показан ещё один экземпляр (Sticky=false) внутри рамки, чтобы не накладываться на настоящую панель сверху." Code="@ExampleCode" Row="false">
        <div class="overflow-hidden rounded-north-md border border-divider">
            <NorthNavBar Sticky="false">
                <a href="/" class="text-lg font-semibold">Logo</a>
                <NorthStack Row="true" Spacing="6">
                    <span class="text-sm text-foreground/70">Главная</span>
                    <span class="text-sm text-foreground/70">О нас</span>
                </NorthStack>
            </NorthNavBar>
            <div class="p-4 text-sm text-foreground/50">Содержимое страницы ниже панели...</div>
        </div>
    </DocSection>

    <DocSection Title="Цвет и плотность" Description="Density='Dense' — компактная высота 48px; Color — сплошная заливка." Code="@ColorCode" Row="false">
        <div class="overflow-hidden rounded-north-md border border-divider">
            <NorthNavBar Sticky="false" Density="NorthDensity.Dense" Color="NorthColor.Primary">
                <span class="font-semibold">Dense + Primary</span>
                <NorthThemeSwitch />
            </NorthNavBar>
        </div>
    </DocSection>

    <DocApiTable Rows="@_rows" />

</DocPage>

@code {
    private const string ExampleCode =
        """
        <NorthNavBar>
            <a href="/" class="text-lg font-semibold">Logo</a>
            <NorthStack Row="true" Spacing="6">
                <NavLink href="/">Главная</NavLink>
                <NavLink href="/about">О нас</NavLink>
            </NorthStack>
        </NorthNavBar>
        """;

    private const string ColorCode =
        """
        <NorthNavBar Density="NorthDensity.Dense" Color="NorthColor.Primary">
            <span class="font-semibold">Dense + Primary</span>
            <NorthThemeSwitch />
        </NorthNavBar>
        """;

    private readonly List<DocApiRow> _rows = new()
    {
        new("Sticky", "bool", "true", "Прилипает к верху при прокрутке"),
        new("Bordered", "bool", "true", "Граница снизу"),
        new("Fluid", "bool", "true", "Растянуть содержимое на всю ширину (без NorthContainer.MaxWidth)"),
        new("Density", "NorthDensity", "Normal", "Normal — 56px высотой, Dense — 48px"),
        new("Color", "NorthColor", "Default", "Default — нейтральная подложка с блюром; любой другой — сплошная заливка цветом"),
        new("Justify", "NorthJustify", "SpaceBetween", "Распределение содержимого по горизонтали"),
        new("ChildContent", "RenderFragment?", "—", "Содержимое панели"),
    };
}
