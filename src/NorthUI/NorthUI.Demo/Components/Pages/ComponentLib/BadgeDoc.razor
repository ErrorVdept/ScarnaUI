@page "/componentlib/badge"

<DocPage Title="NorthBadge" Lead="Индикатор-оверлей поверх произвольного содержимого — счётчик, точка-статус и т.п."
         Files="@(new[] { "Components/DataDisplay/NorthBadge.razor" })">

    <DocSection Title="Текст и точка" Code="@BasicCode">
        <NorthBadge Content="5">
            <NorthAvatar Initials="ВГ" />
        </NorthBadge>
        <NorthBadge Dot="true" Color="NorthColor.Success">
            <NorthAvatar Initials="ОК" />
        </NorthBadge>
        <NorthBadge Content="99+" Color="NorthColor.Primary">
            <NorthAvatar Initials="АБ" />
        </NorthBadge>
    </DocSection>

    <DocSection Title="Visible" Description="Управляет видимостью значка целиком, без изменения разметки." Code="@VisibleCode">
        <NorthButton Size="NorthSize.Small" Variant="NorthVariant.Light" OnClick="() => _hasUnread = !_hasUnread">
            @(_hasUnread ? "Отметить прочитанным" : "Показать непрочитанные")
        </NorthButton>
        <NorthBadge Content="3" Visible="@_hasUnread">
            <NorthAvatar Initials="ИИ" />
        </NorthBadge>
    </DocSection>

    <DocSection Title="Bordered" Code="@BorderedCode">
        <NorthBadge Dot="true" Color="NorthColor.Danger" Bordered="true">
            <NorthAvatar Initials="НБ" />
        </NorthBadge>
        <NorthBadge Dot="true" Color="NorthColor.Danger" Bordered="false">
            <NorthAvatar Initials="НБ" />
        </NorthBadge>
    </DocSection>

    <DocApiTable Rows="@_rows" />

</DocPage>

@code {
    private bool _hasUnread = true;

    private const string BasicCode =
        """
        <NorthBadge Content="5">
            <NorthAvatar Initials="ВГ" />
        </NorthBadge>
        <NorthBadge Dot="true" Color="NorthColor.Success">
            <NorthAvatar Initials="ОК" />
        </NorthBadge>
        <NorthBadge Content="99+" Color="NorthColor.Primary">
            <NorthAvatar Initials="АБ" />
        </NorthBadge>
        """;

    private const string VisibleCode =
        """
        <NorthBadge Content="@unreadCount.ToString()" Visible="@(unreadCount > 0)">
            <NorthAvatar Initials="ИИ" />
        </NorthBadge>
        """;

    private const string BorderedCode =
        """
        <NorthBadge Dot="true" Color="NorthColor.Danger" Bordered="true">
            <NorthAvatar Initials="НБ" />
        </NorthBadge>
        <NorthBadge Dot="true" Color="NorthColor.Danger" Bordered="false">
            <NorthAvatar Initials="НБ" />
        </NorthBadge>
        """;

    private readonly List<DocApiRow> _rows = new()
    {
        new("Color", "NorthColor", "Danger", "Цвет заливки значка"),
        new("Content", "string?", "—", "Текст/число внутри значка (игнорируется при Dot)"),
        new("Dot", "bool", "false", "Показать маленькую точку вместо текста"),
        new("Visible", "bool", "true", "Управляет видимостью значка целиком"),
        new("Bordered", "bool", "true", "Обводка в цвет фона страницы, отделяет значок от того, что под ним"),
        new("ChildContent", "RenderFragment?", "—", "Элемент, поверх которого рисуется значок"),
    };
}
