@page "/componentlib/stack"

<DocPage Title="NorthStack" Lead="Flex-контейнер для расстановки дочерних элементов в ряд или колонку с равным отступом между ними — самый часто используемый layout-компонент."
         Files="@(new[] { "Components/Layout/NorthStack.razor" })">

    <DocSection Title="Row / Column" Description="Row переключает направление на flex-row." Code="@RowCode">
        <NorthStack Row="true" Spacing="3">
            <NorthChip>Один</NorthChip>
            <NorthChip>Два</NorthChip>
            <NorthChip>Три</NorthChip>
        </NorthStack>
    </DocSection>

    <DocSection Title="Spacing" Description="Отступ между элементами в шагах по 0.25rem." Code="@SpacingCode">
        <NorthStack Row="true" Spacing="1">
            <NorthChip>1</NorthChip><NorthChip>1</NorthChip>
        </NorthStack>
        <NorthStack Row="true" Spacing="6">
            <NorthChip>6</NorthChip><NorthChip>6</NorthChip>
        </NorthStack>
    </DocSection>

    <DocSection Title="Justify / Align" Description="Распределение и выравнивание по поперечной оси." Code="@JustifyCode" Row="false">
        <NorthStack Row="true" Justify="NorthJustify.SpaceBetween" Class="border border-divider rounded-north-md p-3">
            <span>Итого: 1 200 ₽</span>
            <NorthButton Color="NorthColor.Primary">Оформить</NorthButton>
        </NorthStack>
        <NorthStack Row="true" Spacing="3" Align="NorthAlign.Center" Class="border border-divider rounded-north-md p-3">
            <NorthAvatar Initials="ИИ" />
            <span class="text-sm text-foreground/70">Выровнено по центру</span>
        </NorthStack>
    </DocSection>

    <DocApiTable Rows="@_rows" />

</DocPage>

@code {
    private const string RowCode =
        """
        <NorthStack Row="true" Spacing="3">
            <NorthChip>Один</NorthChip>
            <NorthChip>Два</NorthChip>
            <NorthChip>Три</NorthChip>
        </NorthStack>
        """;

    private const string SpacingCode =
        """
        <NorthStack Row="true" Spacing="1">
            <NorthChip>1</NorthChip><NorthChip>1</NorthChip>
        </NorthStack>
        <NorthStack Row="true" Spacing="6">
            <NorthChip>6</NorthChip><NorthChip>6</NorthChip>
        </NorthStack>
        """;

    private const string JustifyCode =
        """
        <NorthStack Row="true" Justify="NorthJustify.SpaceBetween">
            <span>Итого: 1 200 ₽</span>
            <NorthButton Color="NorthColor.Primary">Оформить</NorthButton>
        </NorthStack>

        <NorthStack Row="true" Spacing="3" Align="NorthAlign.Center">
            <NorthAvatar Initials="ИИ" />
            <span>Выровнено по центру</span>
        </NorthStack>
        """;

    private readonly List<DocApiRow> _rows = new()
    {
        new("Row", "bool", "false", "true — flex-row, false — flex-column"),
        new("Spacing", "int", "2", "Отступ между элементами в шагах по 0.25rem (2 = 0.5rem)"),
        new("Wrap", "bool", "false", "Перенос элементов при нехватке места"),
        new("Justify", "NorthJustify", "Start", "Start / End / Center / SpaceBetween / SpaceAround / SpaceEvenly"),
        new("Align", "NorthAlign", "Stretch", "Start / End / Center / Stretch / Baseline"),
    };
}
