@*
    Левое меню документации — список всех компонентов/сервисов по категориям
    (данные из ComponentLibNav, единые с карточками на Index.razor). Активная
    страница подсвечивается через NavLink (Match=All, т.к. маршруты не вложены
    друг в друга). Прилипает при скролле и скроллится независимо от страницы,
    если сам не помещается по высоте.
*@
@namespace NorthUI.Demo.Components.Pages.ComponentLib.Shared

<aside class="north-lib-sidebar hidden w-56 shrink-0 lg:block">
    <nav class="sticky top-20 max-h-[calc(100vh-6rem)] overflow-y-auto pb-8 pr-2">
        <NavLink href="/componentlib" Match="NavLinkMatch.All" class="mb-4 block text-sm font-semibold text-foreground hover:text-primary">
            ← Все компоненты
        </NavLink>
        @foreach (var group in ComponentLibNav.Groups)
        {
            <div class="mb-4">
                <p class="mb-1.5 px-2 text-xs font-semibold uppercase tracking-wide text-foreground/40">@group.Title</p>
                <ul class="flex flex-col">
                    @foreach (var item in group.Items)
                    {
                        <li>
                            <NavLink href="@item.Href" Match="NavLinkMatch.All"
                                     class="block rounded-north-sm px-2 py-1 text-sm text-foreground/70 transition-colors hover:bg-content2 hover:text-foreground"
                                     ActiveClass="bg-primary/10 text-primary font-medium hover:bg-primary/10 hover:text-primary">
                                @item.Name
                            </NavLink>
                        </li>
                    }
                </ul>
            </div>
        }
    </nav>
</aside>
