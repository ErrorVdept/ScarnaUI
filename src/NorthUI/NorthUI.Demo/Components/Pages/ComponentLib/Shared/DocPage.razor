@*
    Каркас страницы интерактивной документации одного компонента/сервиса —
    как страницы на mudblazor.com. Задаёт заголовок, хлебную крошку, вводное
    описание и (опционально) список файлов исходников. Секции с живыми примерами
    (DocSection) и таблица API (DocApiTable) кладутся внутрь как ChildContent.
*@
@namespace NorthUI.Demo.Components.Pages.ComponentLib.Shared

<NorthContainer>
    <NorthStack Spacing="6" Class="pb-16">
        <div>
            <NavLink href="/componentlib" class="text-sm text-foreground/50 hover:text-foreground">← Библиотека компонентов</NavLink>
            <h1 class="mt-2 text-2xl font-semibold">@Title</h1>
            @if (!string.IsNullOrEmpty(Lead))
            {
                <p class="mt-2 max-w-3xl text-sm text-foreground/70">@Lead</p>
            }
            @if (Files is { Count: > 0 })
            {
                <div class="mt-3 flex flex-wrap gap-2">
                    @foreach (var file in Files)
                    {
                        <NorthTag>@file</NorthTag>
                    }
                </div>
            }
        </div>

        @ChildContent
    </NorthStack>
</NorthContainer>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;

    /// <summary>Короткое вводное описание компонента под заголовком.</summary>
    [Parameter] public string? Lead { get; set; }

    /// <summary>Пути файлов исходников — показываются тегами под заголовком (как "Файлы" в docmd/*.md).</summary>
    [Parameter] public IReadOnlyList<string>? Files { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }
}
