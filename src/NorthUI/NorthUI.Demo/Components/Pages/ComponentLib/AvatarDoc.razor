@page "/componentlib/avatar"

<DocPage Title="NorthAvatar" Lead="Круглый аватар: изображение по Src, инициалы при его отсутствии/ошибке, иначе — иконка-силуэт."
         Files="@(new[] { "Components/DataDisplay/NorthAvatar.razor" })">

    <DocSection Title="Изображение и инициалы" Code="@BasicCode">
        <NorthAvatar Src="https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?w=200" Alt="Пейзаж" />
        <NorthAvatar Initials="ИИ" Color="NorthColor.Primary" />
        <NorthAvatar Initials="АБ" Color="NorthColor.Secondary" />
        <NorthAvatar />
    </DocSection>

    <DocSection Title="Размеры" Code="@SizesCode">
        <NorthAvatar Initials="ММ" Size="NorthSize.Small" />
        <NorthAvatar Initials="ММ" Size="NorthSize.Medium" />
        <NorthAvatar Initials="ММ" Size="NorthSize.Large" />
    </DocSection>

    <DocSection Title="Bordered и цвета" Code="@ColorsCode">
        <NorthAvatar Initials="ОК" Color="NorthColor.Success" Bordered="true" />
        <NorthAvatar Initials="ВГ" Color="NorthColor.Warning" Bordered="true" />
        <NorthAvatar Initials="НД" Color="NorthColor.Danger" Bordered="true" />
    </DocSection>

    <DocApiTable Rows="@_rows" />

</DocPage>

@code {
    private const string BasicCode =
        """
        <NorthAvatar Src="/img/user.jpg" Alt="Иван Иванов" />
        <NorthAvatar Initials="ИИ" Color="NorthColor.Primary" />
        <NorthAvatar Initials="АБ" Color="NorthColor.Secondary" />
        <NorthAvatar />
        """;

    private const string SizesCode =
        """
        <NorthAvatar Initials="ММ" Size="NorthSize.Small" />
        <NorthAvatar Initials="ММ" Size="NorthSize.Medium" />
        <NorthAvatar Initials="ММ" Size="NorthSize.Large" />
        """;

    private const string ColorsCode =
        """
        <NorthAvatar Initials="ОК" Color="NorthColor.Success" Bordered="true" />
        <NorthAvatar Initials="ВГ" Color="NorthColor.Warning" Bordered="true" />
        <NorthAvatar Initials="НД" Color="NorthColor.Danger" Bordered="true" />
        """;

    private readonly List<DocApiRow> _rows = new()
    {
        new("Src", "string?", "—", "URL изображения"),
        new("Alt", "string?", "—", "alt для изображения"),
        new("Initials", "string?", "—", "Инициалы (1-2 буквы), показываются, если нет Src или изображение не загрузилось"),
        new("Size", "NorthSize", "Medium", "Small/Medium/Large"),
        new("Color", "NorthColor", "Default", "Цвет фона под инициалами"),
        new("Bordered", "bool", "false", "Тонкая обводка в цвет фона страницы, отделяет от подложки"),
    };
}
