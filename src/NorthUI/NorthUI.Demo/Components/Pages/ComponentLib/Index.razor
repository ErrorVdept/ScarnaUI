            new Item("NorthCheckbox", "/componentlib/checkbox", "Чекбокс"),
            new Item("NorthSwitch", "/componentlib/switch", "Переключатель"),
            new Item("NorthSelect", "/componentlib/select", "Выпадающий список"),
            new Item("NorthSelectGroup", "/componentlib/select-group", "Сегментированный переключатель"),
        }),
        new("Data display", new[]
        {
            new Item("NorthCard", "/componentlib/card", "Карточка"),
            new Item("NorthChip", "/componentlib/chip", "Метка/тег"),
            new Item("NorthTag", "/componentlib/tag", "Компактная метка"),
            new Item("NorthBadge", "/componentlib/badge", "Индикатор-оверлей"),
