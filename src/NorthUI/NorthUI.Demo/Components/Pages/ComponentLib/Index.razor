@page "/componentlib"

<NorthContainer>
    <NorthStack Spacing="8" Class="pb-16">
        <div>
            <h1 class="text-2xl font-semibold">Библиотека компонентов</h1>
            <p class="mt-2 max-w-2xl text-sm text-foreground/70">
                Интерактивная документация NorthUI — как на mudblazor.com: живой пример на
                каждый компонент, кнопка "Показать код" и таблица параметров.
            </p>
        </div>

        @foreach (var group in _groups)
        {
            <section>
                <h2 class="mb-3 text-lg font-semibold text-foreground/90">@group.Title</h2>
                <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
                    @foreach (var item in group.Items)
                    {
                        <NavLink href="@item.Href" class="north-lib-card block rounded-north-md border border-divider bg-content1 p-4 transition-colors hover:border-primary hover:bg-content2">
                            <span class="block font-medium text-foreground">@item.Name</span>
                            <span class="mt-1 block text-xs text-foreground/50">@item.Description</span>
                        </NavLink>
                    }
                </div>
            </section>
        }
    </NorthStack>
</NorthContainer>

@code {
    private sealed record Item(string Name, string Href, string Description);
    private sealed record Group(string Title, Item[] Items);

    private readonly Group[] _groups =
    {
        new("Actions", new[]
        {
            new Item("NorthButton", "/componentlib/button", "Кнопка"),
            new Item("NorthToggleButton", "/componentlib/toggle-button", "Кнопка-переключатель"),
        }),
        new("Forms", new[]
        {
            new Item("NorthInput", "/componentlib/input", "Текстовое поле"),
            new Item("NorthTextArea", "/componentlib/textarea", "Многострочное поле"),
            new Item("NorthPasswordBox", "/componentlib/password-box", "Поле пароля"),
