@page "/componentlib/progress"

<DocPage Title="NorthProgress" Lead="Линейная полоса прогресса — аналог MudProgressLinear. Determinate (значение) и Indeterminate (бегущая)."
         Files="@(new[] { "Components/DataDisplay/NorthProgress.razor" })">

    <DocSection Title="Determinate" Row="false" Code="@DeterminateCode">
        <NorthProgress Label="Загрузка файла" Value="64" ShowValue="true" />
        <NorthProgress Label="Ошибка" Value="30" Color="NorthColor.Danger" ShowValue="true" Size="NorthSize.Small" />
    </DocSection>

    <DocSection Title="Indeterminate" Row="false" Code="@IndeterminateCode">
        <NorthProgress Label="Синхронизация" Indeterminate="true" Color="NorthColor.Secondary" />
    </DocSection>

    <DocSection Title="Размеры" Row="false" Code="@SizesCode">
        <NorthProgress Label="Small" Value="50" Size="NorthSize.Small" ShowValue="true" />
        <NorthProgress Label="Medium" Value="50" Size="NorthSize.Medium" ShowValue="true" />
        <NorthProgress Label="Large" Value="50" Size="NorthSize.Large" ShowValue="true" />
    </DocSection>

    <DocApiTable Rows="@_rows" />

</DocPage>

@code {
    private const string DeterminateCode =
        """
        <NorthProgress Label="Загрузка файла" Value="64" ShowValue="true" />
        <NorthProgress Label="Ошибка" Value="30" Color="NorthColor.Danger" ShowValue="true" Size="NorthSize.Small" />
        """;

    private const string IndeterminateCode =
        """
        <NorthProgress Label="Синхронизация" Indeterminate="true" Color="NorthColor.Secondary" />
        """;

    private const string SizesCode =
        """
        <NorthProgress Label="Small" Value="50" Size="NorthSize.Small" ShowValue="true" />
        <NorthProgress Label="Medium" Value="50" Size="NorthSize.Medium" ShowValue="true" />
        <NorthProgress Label="Large" Value="50" Size="NorthSize.Large" ShowValue="true" />
        """;

    private readonly List<DocApiRow> _rows = new()
    {
        new("Label", "string?", "—", "Подпись над полосой"),
        new("Value", "double", "0", "Текущее значение (игнорируется при Indeterminate)"),
        new("Max", "double", "100", "Максимум"),
        new("Indeterminate", "bool", "false", "Бегущая полоса вместо конкретного значения"),
        new("ShowValue", "bool", "false", "Показывать процент справа от подписи"),
        new("Color", "NorthColor", "Primary", "Цвет заливки"),
        new("Size", "NorthSize", "Medium", "Высота полосы: Small (4px) / Medium (8px) / Large (12px)"),
    };
}
