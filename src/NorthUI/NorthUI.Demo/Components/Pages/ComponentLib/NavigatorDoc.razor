@page "/componentlib/navigator"
@inject INavigator Navigator

<DocPage Title="Navigator (INavigator)" Lead="Императивный сервис навигации — обёртка над встроенным NavigationManager, даёт готовые хелперы для подсветки активного пункта в NorthBottomMenu/NorthNavBar."
         Files="@(new[] { "Services/INavigator.cs", "Services/Navigator.cs" })">

    <DocSection Title="Текущее состояние" Description="Uri и IsActive читаются напрямую — обновляются при каждой перерисовке страницы." Code="@StateCode" Row="false">
        <p class="text-sm text-foreground/70">Navigator.Uri: <code class="text-xs">@Navigator.Uri</code></p>
        <p class="text-sm text-foreground/70">Navigator.IsActive("/componentlib"): <code class="text-xs">@Navigator.IsActive("/componentlib")</code></p>
    </DocSection>

    <DocSection Title="Навигация" Description="NavigateTo переходит на другой адрес — здесь на другую страницу документации." Code="@NavigateCode">
        <NorthButton Variant="NorthVariant.Bordered" OnClick='() => Navigator.NavigateTo("/componentlib/theme-switch")'>
            Перейти к NorthThemeSwitch
        </NorthButton>
    </DocSection>

    <DocApiTable Title="Члены INavigator" Rows="@_rows" />

</DocPage>

@code {
    private const string StateCode =
        """
        @inject INavigator Navigator

        <p>Navigator.Uri: @Navigator.Uri</p>
        <p>Navigator.IsActive("/componentlib"): @Navigator.IsActive("/componentlib")</p>
        """;

    private const string NavigateCode =
        """
        <NorthButton OnClick='() => Navigator.NavigateTo("/orders/5")'>К заказу</NorthButton>

        <NorthBottomMenuItem Text="Заказы" OnClick='() => Navigator.NavigateTo("/orders")'>
            <span class="@(Navigator.IsActive("/orders") ? "text-primary" : "")">...</span>
        </NorthBottomMenuItem>
        """;

    private readonly List<DocApiRow> _rows = new()
    {
        new("Uri", "string", "—", "Текущий абсолютный URI"),
        new("BaseUri", "string", "—", "Базовый URI приложения"),
        new("LocationChanged", "event", "—", "Событие смены адреса (в т.ч. кнопки браузера 'назад'/'вперёд')"),
        new("NavigateTo(uri, forceLoad, replace)", "void", "—", "Переход на другой адрес"),
        new("Refresh(replace)", "void", "—", "Полная перезагрузка текущей страницы (аналог F5, всегда forceLoad)"),
        new("ToBaseRelativePath(uri?)", "string", "—", "Адрес относительно BaseUri, без домена и ведущего \"/\""),
        new("IsActive(uri, exact)", "bool", "exact: false", "True, если uri совпадает с текущим адресом. exact=false считает активным и любой дочерний путь"),
    };
}
