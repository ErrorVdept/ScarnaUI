@page "/componentlib/spinner"

<DocPage Title="NorthSpinner" Lead="Вращающееся кольцо-индикатор загрузки (indeterminate, без конкретного значения прогресса)."
         Files="@(new[] { "Components/DataDisplay/NorthSpinner.razor" })">

    <DocSection Title="Цвета" Code="@ColorsCode">
        <NorthSpinner />
        <NorthSpinner Color="NorthColor.Primary" />
        <NorthSpinner Color="NorthColor.Secondary" />
        <NorthSpinner Color="NorthColor.Success" />
        <NorthSpinner Color="NorthColor.Warning" />
        <NorthSpinner Color="NorthColor.Danger" />
    </DocSection>

    <DocSection Title="Размеры" Code="@SizesCode">
        <NorthSpinner Size="NorthSize.Small" />
        <NorthSpinner Size="NorthSize.Medium" />
        <NorthSpinner Size="NorthSize.Large" />
    </DocSection>

    <DocApiTable Rows="@_rows" />

</DocPage>

@code {
    private const string ColorsCode =
        """
        <NorthSpinner />
        <NorthSpinner Color="NorthColor.Primary" />
        <NorthSpinner Color="NorthColor.Secondary" />
        <NorthSpinner Color="NorthColor.Success" />
        <NorthSpinner Color="NorthColor.Warning" />
        <NorthSpinner Color="NorthColor.Danger" />
        """;

    private const string SizesCode =
        """
        <NorthSpinner Size="NorthSize.Small" />
        <NorthSpinner Size="NorthSize.Medium" />
        <NorthSpinner Size="NorthSize.Large" />
        """;

    private readonly List<DocApiRow> _rows = new()
    {
        new("Color", "NorthColor", "Primary", "Цвет кольца"),
        new("Size", "NorthSize", "Medium", "Small/Medium/Large"),
        new("Label", "string", "\"Загрузка\"", "Текст для скринридеров (aria-label), визуально не отображается"),
    };
}
