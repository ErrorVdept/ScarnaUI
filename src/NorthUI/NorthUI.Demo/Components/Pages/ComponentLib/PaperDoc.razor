@page "/componentlib/paper"

<DocPage Title="NorthPaper" Lead="Простая поверхность — фон content1, скругление, опциональные рамка/тень. Почти как NorthCard, но без Header/Footer."
         Files="@(new[] { "Components/DataDisplay/NorthPaper.razor" })">

    <DocSection Title="Базовая поверхность" Code="@BasicCode">
        <NorthPaper>Обычная поверхность</NorthPaper>
        <NorthPaper Bordered="true" Shadow="false">Bordered, без тени</NorthPaper>
        <NorthPaper Radius="NorthRadius.None">Radius.None</NorthPaper>
    </DocSection>

    <DocSection Title="Hovered" Description="Смена фона (bg-content2) при наведении — без смещения/тени, чтобы не «прыгало» в плотных сетках плиток." Code="@HoveredCode">
        <NorthPaper Hovered="true" Class="w-40 text-center">Наведи курсор</NorthPaper>
    </DocSection>

    <DocSection Title="OnClick" Description='Если задан — поверхность кликабельна (role="button", доступна с клавиатуры: Enter/Space). Не задан — обычный статичный div, как у NorthCard.' Code="@ClickCode">
        <NorthPaper Hovered="true" Class="w-48 text-center" OnClick="HandleClick">
            Кликни меня
        </NorthPaper>
        <span class="text-sm text-foreground/60">Кликов: @_clicks</span>
    </DocSection>

    <DocApiTable Rows="@_rows" />

</DocPage>

@code {
    private int _clicks;

    private void HandleClick() => _clicks++;

    private const string BasicCode =
        """
        <NorthPaper>Обычная поверхность</NorthPaper>
        <NorthPaper Bordered="true" Shadow="false">Bordered, без тени</NorthPaper>
        <NorthPaper Radius="NorthRadius.None">Radius.None</NorthPaper>
        """;

    private const string HoveredCode =
        """
        <NorthPaper Hovered="true" Class="w-40 text-center">Наведи курсор</NorthPaper>
        """;

    private const string ClickCode =
        """
        <NorthPaper Hovered="true" Class="w-48 text-center" OnClick="HandleClick">
            Кликни меня
        </NorthPaper>

        @code {
            private int _clicks;
            private void HandleClick() => _clicks++;
        }
        """;

    private readonly List<DocApiRow> _rows = new()
    {
        new("Bordered", "bool", "false", "Тонкая рамка в дополнение к тени"),
        new("Shadow", "bool", "true", "Тень под поверхностью"),
        new("Hovered", "bool", "false", "Смена фона (bg-content2) при наведении"),
        new("Radius", "NorthRadius", "Medium", "Радиус скругления"),
        new("OnClick", "EventCallback<MouseEventArgs>", "—", "Если задан — поверхность кликабельна (role=\"button\", Enter/Space). Не задан — обычный статичный контейнер"),
        new("ChildContent", "RenderFragment?", "—", "Содержимое"),
    };
}
