@page "/componentlib/code-block"

<DocPage Title="NorthCodeBlock" Lead="Блок кода: моноширинный шрифт, опциональная кнопка копирования в правом верхнем углу. По умолчанию высота авто."
         Files="@(new[] { "Components/DataDisplay/NorthCodeBlock.razor", "wwwroot/js/north/codeblock.js" })">

    <DocSection Title="Базовое использование" Description="По умолчанию — авторастягиваемая высота и кнопка копирования." Row="false" Code="@BasicCode">
        <NorthCodeBlock Code="dotnet add package NorthUI" />
    </DocSection>

    <DocSection Title="MaxLines" Description="После указанного количества строк появляется вертикальная прокрутка." Row="false" Code="@MaxLinesCode">
        <NorthCodeBlock Code="@_longSnippet" MaxLines="6" />
    </DocSection>

    <DocSection Title="Lines" Description="Точное количество строк — фиксированная высота независимо от объёма содержимого (короткий код не сжимает блок, длинный — прокручивается)." Row="false" Code="@LinesCode">
        <NorthCodeBlock Code="builder.Services.AddNorthUI();" Lines="4" />
    </DocSection>

    <DocSection Title="ShowCopyButton = false" Row="false" Code="@NoCopyCode">
        <NorthCodeBlock Code="dotnet add package NorthUI" ShowCopyButton="false" />
    </DocSection>

    <DocApiTable Rows="@_rows" />

</DocPage>

@code {
    private readonly string _longSnippet = string.Join('\n', Enumerable.Range(1, 15).Select(i => $"Console.WriteLine(\"Строка {i}\");"));

    private const string BasicCode =
        """
        <NorthCodeBlock Code="dotnet add package NorthUI" />
        """;

    private const string MaxLinesCode =
        """
        <NorthCodeBlock Code="@longSnippet" MaxLines="6" />
        """;

    private const string LinesCode =
        """
        <NorthCodeBlock Code="builder.Services.AddNorthUI();" Lines="4" />
        """;

    private const string NoCopyCode =
        """
        <NorthCodeBlock Code="dotnet add package NorthUI" ShowCopyButton="false" />
        """;

    private readonly List<DocApiRow> _rows = new()
    {
        new("Code", "string", "—", "Текст кода (обязательный)"),
        new("ShowCopyButton", "bool", "true", "Кнопка копирования в правом верхнем углу"),
        new("MinLines", "int?", "—", "Минимальное количество видимых строк"),
        new("MaxLines", "int?", "—", "Максимальное количество видимых строк — дальше вертикальная прокрутка"),
        new("Lines", "int?", "—", "Точное количество строк (вместо MinLines/MaxLines) — фиксированная высота"),
        new("Radius", "NorthRadius", "Medium", "Радиус скругления"),
    };
}
