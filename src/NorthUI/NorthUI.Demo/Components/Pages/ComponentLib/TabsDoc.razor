@page "/componentlib/tabs"

<DocPage Title="NorthTabs" Lead="Вкладки с pill-фоном под активной вкладкой — заливка, а не подчёркивание."
         Files="@(new[] { "Components/Navigation/NorthTabs.razor", "Components/Navigation/NorthTabPanel.razor" })">

    <DocSection Title="Пример" Code="@ExampleCode" Row="false">
        <NorthTabs @bind-SelectedIndex="_tab">
            <NorthTabPanel Text="Профиль">
                <p class="text-sm text-foreground/70">Содержимое вкладки «Профиль».</p>
            </NorthTabPanel>
            <NorthTabPanel Text="Настройки">
                <p class="text-sm text-foreground/70">Содержимое вкладки «Настройки».</p>
            </NorthTabPanel>
            <NorthTabPanel Text="Безопасность">
                <p class="text-sm text-foreground/70">Содержимое вкладки «Безопасность».</p>
            </NorthTabPanel>
        </NorthTabs>
    </DocSection>

    <DocSection Title="FullWidth" Description="Растягивает заголовки на всю ширину дорожки поровну." Code="@FullWidthCode" Row="false">
        <NorthTabs @bind-SelectedIndex="_tab2" FullWidth="true">
            <NorthTabPanel Text="Один">1</NorthTabPanel>
            <NorthTabPanel Text="Два">2</NorthTabPanel>
        </NorthTabs>
    </DocSection>

    <DocApiTable Title="Параметры NorthTabs" Rows="@_tabsRows" />
    <DocApiTable Title="Параметры NorthTabPanel" Rows="@_panelRows" />

</DocPage>

@code {
    private int _tab;
    private int _tab2;

    private const string ExampleCode =
        """
        <NorthTabs @bind-SelectedIndex="_tab">
            <NorthTabPanel Text="Профиль">
                <ProfileForm />
            </NorthTabPanel>
            <NorthTabPanel Text="Настройки">
                <SettingsForm />
            </NorthTabPanel>
        </NorthTabs>

        @code {
            private int _tab;
        }
        """;

    private const string FullWidthCode =
        """
        <NorthTabs @bind-SelectedIndex="_tab" FullWidth="true">
            <NorthTabPanel Text="Один">1</NorthTabPanel>
            <NorthTabPanel Text="Два">2</NorthTabPanel>
        </NorthTabs>
        """;

    private readonly List<DocApiRow> _tabsRows = new()
    {
        new("SelectedIndex", "int", "0", "Индекс активной вкладки, поддерживает @bind-SelectedIndex"),
        new("Justify", "NorthJustify", "Start", "К какому краю прижимать заголовки (заметно, только если FullWidth=false)"),
        new("FullWidth", "bool", "false", "Растянуть заголовки на всю ширину дорожки поровну"),
        new("ChildContent", "RenderFragment?", "—", "Набор <NorthTabPanel>"),
    };

    private readonly List<DocApiRow> _panelRows = new()
    {
        new("Text", "string", "—", "Обязательный. Текст заголовка вкладки"),
        new("ChildContent", "RenderFragment?", "—", "Содержимое, видимое только когда вкладка активна"),
    };
}
