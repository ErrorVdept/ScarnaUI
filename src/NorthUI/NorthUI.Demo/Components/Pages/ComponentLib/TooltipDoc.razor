@page "/componentlib/tooltip"

<DocPage Title="NorthTooltip" Lead="Всплывающая подсказка по наведению курсора/фокусу клавиатурой, построенная поверх NorthPopover."
         Files="@(new[] { "Components/Overlays/NorthTooltip.razor" })">

    <DocSection Title="Пример" Code="@ExampleCode">
        <NorthTooltip Text="Сохранить изменения">
            <NorthButton>💾</NorthButton>
        </NorthTooltip>
        <NorthTooltip Text="Всплывающая подсказка снизу" Position="NorthPosition.Bottom">
            <NorthButton Variant="NorthVariant.Bordered">Наведите курсор</NorthButton>
        </NorthTooltip>
    </DocSection>

    <DocApiTable Rows="@_rows" />

</DocPage>

@code {
    private const string ExampleCode =
        """
        <NorthTooltip Text="Сохранить изменения">
            <NorthButton>💾</NorthButton>
        </NorthTooltip>

        <NorthTooltip Text="Всплывающая подсказка снизу" Position="NorthPosition.Bottom">
            <NorthButton Variant="NorthVariant.Bordered">Наведите курсор</NorthButton>
        </NorthTooltip>
        """;

    private readonly List<DocApiRow> _rows = new()
    {
        new("Text", "string", "—", "Обязательный. Текст подсказки"),
        new("Position", "NorthPosition", "Top", "Позиция подсказки относительно якоря"),
        new("ChildContent", "RenderFragment?", "—", "Элемент-триггер (то, над чем наводят курсор)"),
    };
}
