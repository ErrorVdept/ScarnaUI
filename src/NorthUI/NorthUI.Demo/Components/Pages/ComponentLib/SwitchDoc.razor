@page "/componentlib/switch"

<DocPage Title="NorthSwitch" Lead="Переключатель (toggle) — семантически то же, что чекбокс, но с метафорой вкл/выкл."
         Files="@(new[] { "Components/Forms/NorthSwitch.razor" })">

    <DocSection Title="Интерактивный пример" Code="@InteractiveCode">
        <NorthSwitch @bind-Value="_notify" Color="NorthColor.Success">Уведомления по email</NorthSwitch>
        <span class="text-sm text-foreground/60">Значение: @_notify</span>
    </DocSection>

    <DocSection Title="Цвета" Code="@ColorsCode">
        <NorthSwitch Value="true" Color="NorthColor.Default">Default</NorthSwitch>
        <NorthSwitch Value="true" Color="NorthColor.Primary">Primary</NorthSwitch>
        <NorthSwitch Value="true" Color="NorthColor.Secondary">Secondary</NorthSwitch>
        <NorthSwitch Value="true" Color="NorthColor.Success">Success</NorthSwitch>
        <NorthSwitch Value="true" Color="NorthColor.Warning">Warning</NorthSwitch>
        <NorthSwitch Value="true" Color="NorthColor.Danger">Danger</NorthSwitch>
    </DocSection>

    <DocSection Title="Плотность и состояния" Code="@StatesCode">
        <NorthSwitch Density="NorthDensity.Dense" Value="true">Dense переключатель</NorthSwitch>
        <NorthSwitch Value="true" ReadOnly="true">ReadOnly переключатель</NorthSwitch>
        <NorthSwitch Value="true" Disabled="true">Disabled переключатель</NorthSwitch>
    </DocSection>

    <DocApiTable Rows="@_rows" />

</DocPage>

@code {
    private bool _notify = true;

    private const string InteractiveCode =
        """
        <NorthSwitch @bind-Value="_notify" Color="NorthColor.Success">Уведомления по email</NorthSwitch>
        <span class="text-sm text-foreground/60">Значение: @_notify</span>

        @code {
            private bool _notify = true;
        }
        """;

    private const string ColorsCode =
        """
        <NorthSwitch Value="true" Color="NorthColor.Default">Default</NorthSwitch>
        <NorthSwitch Value="true" Color="NorthColor.Primary">Primary</NorthSwitch>
        <NorthSwitch Value="true" Color="NorthColor.Secondary">Secondary</NorthSwitch>
        <NorthSwitch Value="true" Color="NorthColor.Success">Success</NorthSwitch>
        <NorthSwitch Value="true" Color="NorthColor.Warning">Warning</NorthSwitch>
        <NorthSwitch Value="true" Color="NorthColor.Danger">Danger</NorthSwitch>
        """;

    private const string StatesCode =
        """
        <NorthSwitch Density="NorthDensity.Dense" Value="true">Dense переключатель</NorthSwitch>
        <NorthSwitch Value="true" ReadOnly="true">ReadOnly переключатель</NorthSwitch>
        <NorthSwitch Value="true" Disabled="true">Disabled переключатель</NorthSwitch>
        """;

    private readonly List<DocApiRow> _rows = new()
    {
        new("Value / ValueChanged / ValueExpression", "bool", "—", "Механика @bind-Value"),
        new("Disabled", "bool", "false", "—"),
        new("ReadOnly", "bool", "false", "Запрещает переключение, но не тускнеет (в отличие от Disabled)"),
        new("Color", "NorthColor", "Primary", "Цвет дорожки во включённом состоянии"),
        new("Density", "NorthDensity", "Normal", "Dense — уменьшенная дорожка для плотных списков"),
        new("ChildContent", "RenderFragment?", "—", "Подпись рядом с переключателем"),
    };
}
