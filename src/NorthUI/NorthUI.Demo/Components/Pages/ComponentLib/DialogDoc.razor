@page "/componentlib/dialog"
@inject INorthDialogService DialogService

<DocPage Title="Диалоги (INorthDialogService)" Lead="Императивный сервис показа модальных диалогов — открывает модалку поверх всего приложения без ручного bool _isOpen в каждом месте использования."
         Files="@(new[] { "Components/Overlays/NorthDialog.razor", "Services/INorthDialogService.cs", "Services/NorthDialogModels.cs" })">

    <DocSection Title="Пример" Description="NorthDialogProvider уже есть в MainLayout. Диалог — обычный компонент (здесь используется демонстрационный DemoConfirmDialog), результат приходит через Task<NorthDialogResult>." Code="@ExampleCode">
        <NorthButton Color="NorthColor.Danger" Variant="NorthVariant.Flat" OnClick="OpenConfirmDialogAsync">
            Открыть диалог
        </NorthButton>
        <span class="text-sm text-foreground/60">Результат: @(_lastResult ?? "—")</span>
    </DocSection>

    <DocApiTable Title="Параметры" Rows="@_rows" />

</DocPage>

@code {
    private string? _lastResult;

    private async Task OpenConfirmDialogAsync()
    {
        var result = await DialogService.ShowAsync<DemoConfirmDialog>(new NorthDialogOptions { Size = NorthDialogSize.Small });
        _lastResult = result.Cancelled ? "Отменено" : "Подтверждено";
    }

    private const string ExampleCode =
        """
        @inject INorthDialogService DialogService

        <NorthButton Color="NorthColor.Danger" OnClick="DeleteAsync">Удалить</NorthButton>

        @code {
            private async Task DeleteAsync()
            {
                var result = await DialogService.ShowAsync<DemoConfirmDialog>(
                    new NorthDialogOptions { Size = NorthDialogSize.Small });

                if (!result.Cancelled)
                {
                    // пользователь подтвердил
                }
            }
        }
        """;

    private readonly List<DocApiRow> _rows = new()
    {
        new("Title", "string?", "—", "Используется, только если ваш компонент не рисует собственный заголовок (NorthDialogOptions)"),
        new("Size", "NorthDialogSize", "Medium", "Small/Medium/Large/FullScreen (NorthDialogOptions)"),
        new("CloseOnEscapeKey", "bool", "true", "Закрывать по Escape — результат Cancel() (NorthDialogOptions)"),
        new("CloseOnBackdropClick", "bool", "true", "Закрывать по клику на подложку (NorthDialogOptions)"),
        new("ShowAsync<TComponent>(options?)", "Task<NorthDialogResult>", "—", "Показать диалог без параметров компонента"),
        new("ShowAsync<TComponent>(dict, options?)", "Task<NorthDialogResult>", "—", "Показать диалог с параметрами компонента"),
        new("Close(reference, result?)", "void", "—", "Принудительно закрыть диалог снаружи"),
    };
}
