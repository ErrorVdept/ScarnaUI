@page "/components"
@inject INorthDialogService DialogService
@inject IToastManager ToastManager

<PageTitle>NorthUI — компоненты</PageTitle>

<NorthDrawer @bind-Open="_tocOpen" Anchor="NorthDrawerAnchor.Left" Width="260px">
    <div class="flex items-center justify-between border-b border-divider px-4 py-3">
        <span class="font-semibold">Оглавление</span>
        <NorthButton Size="NorthSize.Small" Variant="NorthVariant.Light" OnClick="() => _tocOpen = false">✕</NorthButton>
    </div>
    <nav class="scrollable-v p-3">
        <NorthStack Spacing="1">
            @foreach (var item in _toc)
            {
                @* href полный ("/components#id"), не голый "#id" — у Blazor-приложений
                   всегда есть <base href="/"> в <head>, а с ним href="#id" резолвится
                   БРАУЗЕРОМ относительно этого base, а не текущего пути, и уводит на
                   "/#id" (корень сайта) вместо прокрутки текущей страницы. *@
                <a href="@($"/components#{item.Id}")" class="block rounded-north-sm px-2 py-1.5 text-sm text-foreground/70 transition-colors hover:bg-content2 hover:text-foreground" @onclick="() => _tocOpen = false">@item.Title</a>
            }
        </NorthStack>
    </nav>
</NorthDrawer>

<NorthContainer>
    <NorthButton Variant="NorthVariant.Light" Size="NorthSize.Small" Class="mb-6" OnClick="() => _tocOpen = true">
        <StartIcon>
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6" /><line x1="3" y1="12" x2="21" y2="12" /><line x1="3" y1="18" x2="21" y2="18" /></svg>
        </StartIcon>
        <ChildContent>Оглавление</ChildContent>
    </NorthButton>

    <NorthStack Spacing="10" Class="pb-16">

        <section id="buttons">
            <h2 class="mb-4 text-xl font-semibold">Buttons</h2>
            <NorthCard>
                <NorthStack Spacing="4">
                    <NorthStack Row="true" Spacing="3" Wrap="true">
                        <NorthButton Color="NorthColor.Default">Default</NorthButton>
                        <NorthButton Color="NorthColor.Primary">Primary</NorthButton>
                        <NorthButton Color="NorthColor.Secondary">Secondary</NorthButton>
                        <NorthButton Color="NorthColor.Success">Success</NorthButton>
                        <NorthButton Color="NorthColor.Warning">Warning</NorthButton>
                        <NorthButton Color="NorthColor.Danger">Danger</NorthButton>
                    </NorthStack>
                    <NorthStack Row="true" Spacing="3" Wrap="true">
                        <NorthButton Color="NorthColor.Primary" Variant="NorthVariant.Solid">Solid</NorthButton>
                        <NorthButton Color="NorthColor.Primary" Variant="NorthVariant.Flat">Flat</NorthButton>
                        <NorthButton Color="NorthColor.Primary" Variant="NorthVariant.Bordered">Bordered</NorthButton>
                        <NorthButton Color="NorthColor.Primary" Variant="NorthVariant.Light">Light</NorthButton>
                        <NorthButton Color="NorthColor.Primary" Variant="NorthVariant.Faded">Faded</NorthButton>
                        <NorthButton Color="NorthColor.Primary" Variant="NorthVariant.Shadow">Shadow</NorthButton>
                    </NorthStack>
                    <NorthStack Row="true" Spacing="3" Align="NorthAlign.Center" Wrap="true">
                        <NorthButton Size="NorthSize.Small">Small</NorthButton>
                        <NorthButton Size="NorthSize.Medium">Medium</NorthButton>
                        <NorthButton Size="NorthSize.Large">Large</NorthButton>
                        <NorthButton Loading="true">Loading</NorthButton>
                        <NorthButton Disabled="true">Disabled</NorthButton>
                    </NorthStack>
                </NorthStack>
            </NorthCard>
        </section>

        <section id="forms">
            <h2 class="mb-4 text-xl font-semibold">Forms</h2>
            <NorthCard>
                <NorthGrid Spacing="6">
                    <NorthItem Xs="12" Md="6">
                        <NorthInput Label="Имя" Placeholder="Введите имя" @bind-Value="_name" HelperText="Как к вам обращаться" />
                    </NorthItem>
                    <NorthItem Xs="12" Md="6">
                        <NorthInput Label="Email" Type="email" Variant="NorthVariant.Flat" @bind-Value="_email" Error="@(!string.IsNullOrEmpty(_email) && !_email.Contains('@'))" ErrorText="Некорректный email" />
                    </NorthItem>
                    <NorthItem Xs="12" Md="6">
                        <NorthSelect Label="Страна" @bind-Value="_country" Placeholder="Выберите страну">
                            <NorthSelectItem Value="@("ru")" Text="Россия" />
                            <NorthSelectItem Value="@("kz")" Text="Казахстан" />
                            <NorthSelectItem Value="@("by")" Text="Беларусь" />
                        </NorthSelect>
                    </NorthItem>
                    <NorthItem Xs="12">
                        <NorthStack Row="true" Spacing="6">
                            <NorthCheckbox @bind-Value="_agree">Согласен с условиями</NorthCheckbox>
                            <NorthSwitch @bind-Value="_notify" Color="NorthColor.Success">Уведомления</NorthSwitch>
                        </NorthStack>
                    </NorthItem>
                    <NorthItem Xs="12" Md="6">
                        <NorthSlider Label="Громкость" @bind-Value="_volume" ShowValue="true" />
                    </NorthItem>
                    <NorthItem Xs="12" Md="6">
                        <NorthNumericField Label="Количество (целое)" @bind-Value="_qty" Min="0" Max="99" Step="1" Format="NorthNumberFormat.Integer" />
                    </NorthItem>
                    <NorthItem Xs="12" Md="6">
                        <NorthSelectGroup Label="Период (FullWidth)" @bind-Value="_period" FullWidth="true">
                            <NorthSelectGroupItem Value="@("day")" Text="День" />
                            <NorthSelectGroupItem Value="@("week")" Text="Неделя" />
                            <NorthSelectGroupItem Value="@("month")" Text="Месяц" />
                        </NorthSelectGroup>
                    </NorthItem>
                    <NorthItem Xs="12" Md="6">
                        <p class="mb-2 text-sm font-medium text-foreground/80">ToggleButton</p>
                        <NorthStack Row="true" Spacing="2">
                            <NorthToggleButton @bind-Value="_bold">Ж</NorthToggleButton>
                            <NorthToggleButton @bind-Value="_italic">К</NorthToggleButton>
                            <NorthToggleButton @bind-Value="_underline">Ч</NorthToggleButton>
                        </NorthStack>
                    </NorthItem>
                    <NorthItem Xs="12">
                        <NorthDivider Class="mb-4" />
                        <p class="mb-3 text-sm text-foreground/60">Плотность Dense — для панелей фильтров и таблиц</p>
                        <NorthStack Row="true" Spacing="4" Align="NorthAlign.Center" Wrap="true">
                            <NorthInput Placeholder="Normal" Class="w-40" />
                            <NorthInput Placeholder="Dense" Density="NorthDensity.Dense" Class="w-40" />
                            <NorthCheckbox Density="NorthDensity.Dense" Value="true">Dense чекбокс</NorthCheckbox>
                            <NorthSwitch Density="NorthDensity.Dense" Value="true" Color="NorthColor.Primary">Dense переключатель</NorthSwitch>
                        </NorthStack>
                    </NorthItem>
                    <NorthItem Xs="12">
                        <NorthDivider Class="mb-4" />
                        <p class="mb-3 text-sm text-foreground/60">Bordered="false" — без обводки, независимо от Variant</p>
                        <NorthStack Row="true" Spacing="4" Wrap="true">
                            <NorthInput Placeholder="Без обводки" Variant="NorthVariant.Flat" Bordered="false" Class="w-48" />
                            <NorthButton Color="NorthColor.Primary" Variant="NorthVariant.Solid" Bordered="true">С доп. обводкой</NorthButton>
                        </NorthStack>
                    </NorthItem>
                </NorthGrid>
            </NorthCard>
        </section>

        <section id="forms-extra">
            <h2 class="mb-4 text-xl font-semibold">Forms — TextArea, TimeField, DateTimePicker, PasswordBox</h2>
            <NorthCard>
                <NorthGrid Spacing="6">
                    <NorthItem Xs="12" Md="6">
                        <NorthTextArea Label="Комментарий" Placeholder="Расскажите подробнее..." @bind-Value="_comment" Rows="3" HelperText="Многострочное поле" />
                    </NorthItem>
                    <NorthItem Xs="12" Md="6">
                        <NorthPasswordBox Label="Пароль" @bind-Value="_password" Placeholder="Введите пароль" HelperText="Символ маски по умолчанию — *" />
                    </NorthItem>
                    <NorthItem Xs="12" Md="6">
                        <NorthTimeField Label="Время начала" @bind-Value="_startTime" />
                    </NorthItem>
                    <NorthItem Xs="12" Md="6">
                        <NorthDateTimePicker Label="Дата и время встречи" @bind-Value="_meetingAt" />
                    </NorthItem>
                    <NorthItem Xs="12">
                        <NorthDivider Class="mb-4" />
                        <p class="mb-3 text-sm text-foreground/60">ReadOnly — поле активно выглядит как обычное, но не реагирует на ввод (в отличие от Disabled)</p>
                        <NorthStack Row="true" Spacing="4" Align="NorthAlign.Center" Wrap="true">
                            <NorthInput Value="Только чтение" ReadOnly="true" Class="w-48" />
                            <NorthSlider Label="ReadOnly" Value="65" ReadOnly="true" Class="w-48" />
                            <NorthCheckbox Value="true" ReadOnly="true">ReadOnly чекбокс</NorthCheckbox>
                            <NorthSwitch Value="true" ReadOnly="true">ReadOnly переключатель</NorthSwitch>
                        </NorthStack>
                    </NorthItem>
                </NorthGrid>
            </NorthCard>
        </section>

        <section id="data-display">
            <h2 class="mb-4 text-xl font-semibold">Data display</h2>
            <NorthCard>
                <NorthStack Spacing="5">
                    <NorthStack Row="true" Spacing="2" Wrap="true">
                        <NorthChip Color="NorthColor.Default">Default</NorthChip>
                        <NorthChip Color="NorthColor.Primary">Primary</NorthChip>
                        <NorthChip Color="NorthColor.Success" Variant="NorthVariant.Bordered">Success</NorthChip>
                        <NorthChip Color="NorthColor.Danger" Variant="NorthVariant.Faded" OnClose='() => ToastManager.Add("Тег убран", NorthToastSeverity.Info)'>Удаляемый</NorthChip>
                    </NorthStack>
                    <NorthStack Row="true" Spacing="4" Align="NorthAlign.Center">
                        <NorthAvatar Initials="ИИ" Color="NorthColor.Primary" />
                        <NorthAvatar Initials="АБ" Color="NorthColor.Secondary" Size="NorthSize.Large" />
                        <NorthBadge Content="5">
                            <NorthAvatar Initials="ВГ" />
                        </NorthBadge>
                        <NorthBadge Dot="true" Color="NorthColor.Success">
                            <NorthAvatar Initials="ОК" />
                        </NorthBadge>
                    </NorthStack>
                    <NorthDivider />
                    <p class="text-sm text-foreground/70">Карточка, чип, аватар и бейдж — всё выше уже они и есть.</p>
                    <NorthSeparator>или</NorthSeparator>
                    <NorthStack Row="true" Spacing="2" Wrap="true" Align="NorthAlign.Center">
                        <NorthTag>новое</NorthTag>
                        <NorthTag Color="NorthColor.Primary">primary</NorthTag>
                        <NorthTag Color="NorthColor.Success" Variant="NorthVariant.Bordered">активен</NorthTag>
                        <NorthSpinner />
                        <NorthSpinner Color="NorthColor.Success" Size="NorthSize.Large" />
                    </NorthStack>
                </NorthStack>
            </NorthCard>
        </section>

        <section id="data-display-extra">
            <h2 class="mb-4 text-xl font-semibold">Data display — Image, ExpansionPanel, List</h2>
            <NorthCard>
                <NorthGrid Spacing="6">
                    <NorthItem Xs="12" Md="4">
                        <p class="mb-2 text-sm text-foreground/60">NorthImage (с fallback при ошибке)</p>
                        <NorthImage Src="https://images.unsplash.com/photo-1500530855697-b586d89ba3ee?w=400" Alt="Пейзаж" Class="h-40 w-full" />
                    </NorthItem>
                    <NorthItem Xs="12" Md="4">
                        <p class="mb-2 text-sm text-foreground/60">NorthExpansionPanel</p>
                        <NorthStack Spacing="2">
                            <NorthExpansionPanel Title="Доставка" @bind-Expanded="_panel1">
                                Бесплатно при заказе от 3000 ₽, курьером 1-2 дня.
                            </NorthExpansionPanel>
                            <NorthExpansionPanel Title="Оплата" @bind-Expanded="_panel2">
                                Картой онлайн или наличными при получении.
                            </NorthExpansionPanel>
                        </NorthStack>
                    </NorthItem>
                    <NorthItem Xs="12" Md="4">
                        <p class="mb-2 text-sm text-foreground/60">NorthList (SelectionMode.Multiple)</p>
                        <NorthList SelectionMode="NorthListSelectionMode.Multiple" @bind-SelectedValues="_selectedFruits" Bordered="true">
                            <NorthListItem Value="@("apple")">Яблоко</NorthListItem>
                            <NorthListItem Value="@("banana")">Банан</NorthListItem>
                            <NorthListItem Value="@("cherry")">Вишня</NorthListItem>
                        </NorthList>
                    </NorthItem>
                </NorthGrid>
            </NorthCard>
        </section>

        <section id="drawer">
            <h2 class="mb-4 text-xl font-semibold">Layout — Drawer</h2>
            <NorthCard>
                <NorthButton Variant="NorthVariant.Bordered" OnClick="() => _drawerOpen = true">Открыть панель</NorthButton>
                <NorthDrawer @bind-Open="_drawerOpen" Anchor="NorthDrawerAnchor.Left">
                    <div class="flex items-center justify-between border-b border-divider px-4 py-3">
                        <span class="font-semibold">Меню</span>
                        <NorthButton Size="NorthSize.Small" Variant="NorthVariant.Light" OnClick="() => _drawerOpen = false">✕</NorthButton>
                    </div>
                    <NorthList TValue="string" SelectionMode="NorthListSelectionMode.None" Class="p-3">
                        <NorthListItem Value="@("home")">Главная</NorthListItem>
                        <NorthListItem Value="@("orders")">Заказы</NorthListItem>
                        <NorthListItem Value="@("settings")">Настройки</NorthListItem>
                    </NorthList>
                </NorthDrawer>
            </NorthCard>
        </section>

        <section id="bottom-menu">
            <h2 class="mb-4 text-xl font-semibold">Layout — BottomMenu</h2>
            <NorthCard>
                <p class="mb-3 text-sm text-foreground/60">Прибито к низу экрана (как мобильная навигация) — прокрутите страницу вниз, чтобы увидеть.</p>
                <NorthBottomMenu @bind-SelectedIndex="_bottomMenuTab">
                    <NorthBottomMenuItem Text="Главная">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" /><polyline points="9 22 9 12 15 12 15 22" /></svg>
                    </NorthBottomMenuItem>
                    <NorthBottomMenuItem Text="Поиск">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8" /><line x1="21" y1="21" x2="16.65" y2="16.65" /></svg>
                    </NorthBottomMenuItem>
                    <NorthBottomMenuItem Text="Профиль">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" /><circle cx="12" cy="7" r="4" /></svg>
                    </NorthBottomMenuItem>
                </NorthBottomMenu>
            </NorthCard>
        </section>

        <section id="text">
            <h2 class="mb-4 text-xl font-semibold">NorthText</h2>
            <NorthCard>
                <NorthText Typo="NorthTypo.H2" GutterBottom="true">Заголовок H2</NorthText>
                <NorthText Typo="NorthTypo.Subtitle1" GutterBottom="true">Подзаголовок Subtitle1</NorthText>
                <NorthText Typo="NorthTypo.Body1" GutterBottom="true">
                    Body1 — обычный текст абзаца. Компонент выбирает подходящий HTML-тег
                    автоматически (h1-h6, p, span) в зависимости от Typo, либо явно через As.
                </NorthText>
                <NorthText Typo="NorthTypo.Body2" Color="NorthColor.Danger" GutterBottom="true">Body2 с Color="Danger"</NorthText>
                <NorthText Typo="NorthTypo.Caption">Caption — приглушённая подпись</NorthText>
            </NorthCard>
        </section>

        <section id="progress">
            <h2 class="mb-4 text-xl font-semibold">NorthProgress</h2>
            <NorthCard>
                <NorthStack Spacing="4">
                    <NorthProgress Label="Загрузка файла" Value="64" ShowValue="true" />
                    <NorthProgress Label="Ошибка" Value="30" Color="NorthColor.Danger" ShowValue="true" Size="NorthSize.Small" />
                    <NorthProgress Label="Синхронизация" Indeterminate="true" Color="NorthColor.Secondary" />
                </NorthStack>
            </NorthCard>
        </section>

        <section id="table">
            <h2 class="mb-4 text-xl font-semibold">NorthTable</h2>
            <NorthCard>
                <NorthTable Hover="true">
                    <thead>
                        <tr><th>Имя</th><th>Email</th><th>Статус</th></tr>
                    </thead>
                    <tbody>
                        <tr><td>Иван Петров</td><td>ivan@example.com</td><td><NorthChip Color="NorthColor.Success" Size="NorthSize.Small">Активен</NorthChip></td></tr>
                        <tr><td>Анна Смирнова</td><td>anna@example.com</td><td><NorthChip Color="NorthColor.Warning" Size="NorthSize.Small">Ожидает</NorthChip></td></tr>
                        <tr><td>Пётр Иванов</td><td>petr@example.com</td><td><NorthChip Color="NorthColor.Default" Size="NorthSize.Small">Неактивен</NorthChip></td></tr>
                    </tbody>
                </NorthTable>
            </NorthCard>
        </section>

        <section id="tabs">
            <h2 class="mb-4 text-xl font-semibold">Navigation — Tabs</h2>
            <NorthCard>
                <NorthTabs @bind-SelectedIndex="_tab">
                    <NorthTabPanel Text="Профиль">
                        <p class="text-sm text-foreground/70">Содержимое вкладки «Профиль». Активная вкладка — заливка фоном (pill), а не подчёркивание.</p>
                    </NorthTabPanel>
                    <NorthTabPanel Text="Настройки">
                        <p class="text-sm text-foreground/70">Содержимое вкладки «Настройки».</p>
                    </NorthTabPanel>
                    <NorthTabPanel Text="Безопасность">
                        <p class="text-sm text-foreground/70">Содержимое вкладки «Безопасность».</p>
                    </NorthTabPanel>
                </NorthTabs>
            </NorthCard>
        </section>

        <section id="menu">
            <h2 class="mb-4 text-xl font-semibold">Navigation — Menu</h2>
            <NorthCard>
                <NorthMenu>
                    <Trigger>
                        <NorthButton Variant="NorthVariant.Bordered">Действия ▾</NorthButton>
                    </Trigger>
                    <MenuContent>
                        <NorthMenuItem OnClick='@(() => ToastManager.Add("Редактирование", NorthToastSeverity.Info))'>Редактировать</NorthMenuItem>
                        <NorthMenuItem OnClick='@(() => ToastManager.Add("Дублировано", NorthToastSeverity.Info))'>Дублировать</NorthMenuItem>
                        <NorthDivider Class="my-1" />
                        <NorthMenuItem Color="NorthColor.Danger" OnClick='@(() => ToastManager.Add("Удалено", NorthToastSeverity.Warning))'>Удалить</NorthMenuItem>
                    </MenuContent>
                </NorthMenu>
            </NorthCard>
        </section>

        <section id="overlays">
            <h2 class="mb-4 text-xl font-semibold">Overlays</h2>
            <NorthCard>
                <NorthStack Row="true" Spacing="4" Wrap="true" Align="NorthAlign.Center">
                    <NorthTooltip Text="Всплывающая подсказка сверху">
                        <NorthButton Variant="NorthVariant.Bordered">Наведите курсор</NorthButton>
                    </NorthTooltip>

                    <NorthButton Color="NorthColor.Danger" Variant="NorthVariant.Flat" OnClick="OpenConfirmDialogAsync">
                        Открыть диалог
                    </NorthButton>

                    <NorthButton Color="NorthColor.Success" Variant="NorthVariant.Flat" OnClick='@(() => ToastManager.Add("Сохранено успешно", NorthToastSeverity.Success))'>
                        Показать тост
                    </NorthButton>
                </NorthStack>
            </NorthCard>
        </section>

        <section id="custom-classes">
            <h2 class="mb-4 text-xl font-semibold">Кастомные классы</h2>
            <NorthCard>
                <NorthGrid Spacing="6">
                    <NorthItem Xs="12" Md="6">
                        <p class="mb-2 text-sm text-foreground/60">.scrollable-v (высота ограничена — прокрутка по вертикали)</p>
                        <div class="scrollable-v h-40 rounded-north-md border border-divider p-3">
                            @for (var i = 1; i <= 20; i++)
                            {
                                <p class="py-1 text-sm text-foreground/80">Строка списка №@i</p>
                            }
                        </div>
                    </NorthItem>
                    <NorthItem Xs="12" Md="6">
                        <p class="mb-2 text-sm text-foreground/60">.scrollable-h (широкий контент — прокрутка по горизонтали)</p>
                        <div class="scrollable-h rounded-north-md border border-divider p-3">
                            <div class="flex w-[720px] gap-3">
                                @for (var i = 1; i <= 6; i++)
                                {
                                    <div class="flex w-32 shrink-0 items-center justify-center rounded-north-sm bg-content2 py-6 text-sm">Карточка @i</div>
                                }
                            </div>
                        </div>
                    </NorthItem>
                    <NorthItem Xs="12">
                        <p class="mb-2 text-sm text-foreground/60">.north-width-full / .north-height-full</p>
                        <div class="flex h-24 gap-3 rounded-north-md border border-divider p-3">
                            <div class="north-height-full flex w-32 items-center justify-center rounded-north-sm bg-content2 text-sm">100% высоты</div>
                            <div class="north-width-full flex items-center justify-center rounded-north-sm bg-content2 text-sm">100% ширины</div>
                        </div>
                    </NorthItem>
                </NorthGrid>
            </NorthCard>
        </section>

    </NorthStack>
</NorthContainer>

@code {
    private sealed record TocItem(string Id, string Title);

    private bool _tocOpen;

    private readonly TocItem[] _toc =
    {
        new("buttons", "Buttons"),
        new("forms", "Forms"),
        new("forms-extra", "Forms — доп. поля"),
        new("data-display", "Data display"),
        new("data-display-extra", "Data display — доп."),
        new("drawer", "Layout — Drawer"),
        new("bottom-menu", "Layout — BottomMenu"),
        new("text", "NorthText"),
        new("progress", "NorthProgress"),
        new("table", "NorthTable"),
        new("tabs", "Navigation — Tabs"),
        new("menu", "Navigation — Menu"),
        new("overlays", "Overlays"),
        new("custom-classes", "Кастомные классы"),
    };

    private string? _name;
    private string? _email;
    private string? _country;
    private bool _agree;
    private bool _notify = true;
    private int _tab;

    private double _volume = 40;
    private double _qty = 1;
    private string? _period = "week";
    private bool _bold;
    private bool _italic;
    private bool _underline;

    private bool _panel1 = true;
    private bool _panel2;
    private IReadOnlyCollection<string> _selectedFruits = new List<string> { "banana" };

    private bool _drawerOpen;

    private string? _comment;
    private string? _password;
    private TimeOnly? _startTime = new(9, 30);
    private DateTime? _meetingAt = DateTime.Today.AddHours(14);
    private int _bottomMenuTab;

    private async Task OpenConfirmDialogAsync()
    {
        var result = await DialogService.ShowAsync<DemoConfirmDialog>(new NorthDialogOptions { Size = NorthDialogSize.Small });
        if (!result.Cancelled)
        {
            ToastManager.Add("Элемент удалён", NorthToastSeverity.Warning);
        }
    }
}
